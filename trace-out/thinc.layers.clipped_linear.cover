    1: ) -> Model[Floats2d, Floats2d]:
           if init_W is None:
               init_W = glorot_uniform_init
           if init_b is None:
               init_b = zero_init
           return ClippedLinear(
               nO=nO,
               nI=nI,
               init_W=init_W,
