    1: from typing import Optional, TYPE_CHECKING
       
    1: from .segment import Segment
    1: from .style import StyleType
    1: from ._loop import loop_last
       
       
    1: if TYPE_CHECKING:
           from .console import (
               Console,
               ConsoleOptions,
               RenderResult,
               RenderableType,
               Group,
           )
       
       
    2: class Screen:
    1:     """A renderable that fills the terminal screen and crops excess.
       
           Args:
               renderable (RenderableType): Child renderable.
               style (StyleType, optional): Optional background style. Defaults to None.
           """
       
    1:     renderable: "RenderableType"
       
    5:     def __init__(
               self,
    1:         *renderables: "RenderableType",
    2:         style: Optional[StyleType] = None,
    2:         application_mode: bool = False,
    1:     ) -> None:
               from rich.console import Group
       
               self.renderable = Group(*renderables)
               self.style = style
               self.application_mode = application_mode
       
    4:     def __rich_console__(
    2:         self, console: "Console", options: "ConsoleOptions"
    1:     ) -> "RenderResult":
               width, height = options.size
               style = console.get_style(self.style) if self.style else None
               render_options = options.update(width=width, height=height)
               lines = console.render_lines(
                   self.renderable or "", render_options, style=style, pad=True
               )
               lines = Segment.set_shape(lines, width, height, style=style)
               new_line = Segment("\n\r") if self.application_mode else Segment.line()
               for last, line in loop_last(lines):
                   yield from line
                   if not last:
                       yield new_line
