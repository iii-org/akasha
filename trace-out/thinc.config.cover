    1: import catalogue
    1: import confection
    1: from confection import VARIABLE_RE, Config, ConfigValidationError, Promise
       
    1: from .types import Decorator
       
       
    2: class registry(confection.registry):
           # fmt: off
    1:     optimizers: Decorator = catalogue.create("thinc", "optimizers", entry_points=True)
    1:     schedules: Decorator = catalogue.create("thinc", "schedules", entry_points=True)
    1:     layers: Decorator = catalogue.create("thinc", "layers", entry_points=True)
    1:     losses: Decorator = catalogue.create("thinc", "losses", entry_points=True)
