    1: from __future__ import annotations
       
    1: from typing import Any
    1: from typing_extensions import override
       
    1: from ._proxy import LazyProxy
       
       
    2: class ResourcesProxy(LazyProxy[Any]):
    1:     """A proxy for the `openai.resources` module.
       
           This is used so that we can lazily import `openai.resources` only when
           needed *and* so that users can just import `openai` and reference `openai.resources`
           """
       
    2:     @override
    2:     def __load__(self) -> Any:
               import importlib
       
               mod = importlib.import_module("openai.resources")
               return mod
       
       
    1: resources = ResourcesProxy().__as_proxied__()
