    2: class OTELResourceDetector(ResourceDetector):
           # pylint: disable=no-self-use
    1:     def detect(self) -> "Resource":
    1:         env_resources_items = environ.get(OTEL_RESOURCE_ATTRIBUTES)
    1:         env_resource_map: dict[str, AttributeValue] = {}
       
    1:         if env_resources_items:
                   for item in env_resources_items.split(","):
