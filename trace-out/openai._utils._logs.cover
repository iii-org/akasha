    1: import os
    1: import logging
    1: from typing_extensions import override
       
    1: from ._utils import is_dict
       
    1: logger: logging.Logger = logging.getLogger("openai")
    1: httpx_logger: logging.Logger = logging.getLogger("httpx")
       
       
    1: SENSITIVE_HEADERS = {"api-key", "authorization", "x-amz-security-token"}
       
       
    1: def _basic_config() -> None:
           # e.g. [2023-10-05 14:12:26 - openai._base_client:818 - DEBUG] HTTP Request: POST http://127.0.0.1:4010/foo/bar "200 OK"
           logging.basicConfig(
               format="[%(asctime)s - %(name)s:%(lineno)d - %(levelname)s] %(message)s",
               datefmt="%Y-%m-%d %H:%M:%S",
           )
       
       
    1: def setup_logging() -> None:
    1:     env = os.environ.get("OPENAI_LOG")
    1:     if env == "debug":
               _basic_config()
               logger.setLevel(logging.DEBUG)
               httpx_logger.setLevel(logging.DEBUG)
    1:     elif env == "info":
               _basic_config()
               logger.setLevel(logging.INFO)
               httpx_logger.setLevel(logging.INFO)
       
       
    2: class SensitiveHeadersFilter(logging.Filter):
    2:     @override
    2:     def filter(self, record: logging.LogRecord) -> bool:
               if is_dict(record.args) and "headers" in record.args and is_dict(record.args["headers"]):
                   headers = record.args["headers"] = {**record.args["headers"]}
                   for header in headers:
                       if str(header).lower() in SENSITIVE_HEADERS:
                           headers[header] = "<redacted>"
               return True
