    1: from __future__ import annotations
       
       
    2: class Timeout(TimeoutError):  # noqa: N818
    1:     """Raised when the lock could not be acquired in *timeout* seconds."""
       
    1:     def __init__(self, lock_file: str) -> None:
               super().__init__()
               self._lock_file = lock_file
       
    1:     def __reduce__(self) -> tuple[type[Timeout], tuple[str]]:
               return self.__class__, (self._lock_file,)  # Properly pickle the exception
       
    1:     def __str__(self) -> str:
               return f"The file lock '{self._lock_file}' could not be acquired."
       
    1:     def __repr__(self) -> str:
               return f"{self.__class__.__name__}({self.lock_file!r})"
       
    2:     @property
    2:     def lock_file(self) -> str:
               """:returns: The path of the file lock."""
               return self._lock_file
       
       
    1: __all__ = [
    1:     "Timeout",
       ]
