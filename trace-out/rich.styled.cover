    1: from typing import TYPE_CHECKING
       
    1: from .measure import Measurement
    1: from .segment import Segment
    1: from .style import StyleType
       
    1: if TYPE_CHECKING:
           from .console import Console, ConsoleOptions, RenderResult, RenderableType
       
       
    2: class Styled:
    1:     """Apply a style to a renderable.
       
           Args:
               renderable (RenderableType): Any renderable.
               style (StyleType): A style to apply across the entire renderable.
           """
       
    1:     def __init__(self, renderable: "RenderableType", style: "StyleType") -> None:
               self.renderable = renderable
               self.style = style
       
    4:     def __rich_console__(
    2:         self, console: "Console", options: "ConsoleOptions"
    1:     ) -> "RenderResult":
               style = console.get_style(self.style)
               rendered_segments = console.render(self.renderable, options)
               segments = Segment.apply_style(rendered_segments, style)
               return segments
       
    4:     def __rich_measure__(
    2:         self, console: "Console", options: "ConsoleOptions"
    1:     ) -> Measurement:
               return Measurement.get(console, options, self.renderable)
       
       
    1: if __name__ == "__main__":  # pragma: no cover
           from rich import print
           from rich.panel import Panel
       
           panel = Styled(Panel("hello"), "on blue")
           print(panel)
