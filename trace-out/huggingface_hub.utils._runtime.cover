    1: """Check presence of installed packages at runtime."""
       
    1: import importlib.metadata
    1: import importlib.util
    1: import os
    1: import platform
    1: import sys
    1: import warnings
    1: from pathlib import Path
    1: from typing import Any, Literal
       
    1: from .. import __version__, constants
       
       
    1: _PY_VERSION: str = sys.version.split()[0].rstrip("+")
       
    1: _package_versions = {}
       
   19: _CANDIDATES = {
    1:     "aiohttp": {"aiohttp"},
    1:     "fastai": {"fastai"},
    1:     "fastapi": {"fastapi"},
    1:     "fastcore": {"fastcore"},
    1:     "gradio": {"gradio"},
    1:     "graphviz": {"graphviz"},
    1:     "hf_xet": {"hf_xet"},
    1:     "jinja": {"Jinja2"},
    1:     "httpx": {"httpx"},
    1:     "keras": {"keras"},
    1:     "numpy": {"numpy"},
    1:     "pillow": {"Pillow"},
    1:     "pydantic": {"pydantic"},
    1:     "pydot": {"pydot"},
    1:     "safetensors": {"safetensors"},
    1:     "tensorboard": {"tensorboardX"},
    1:     "tensorflow": (
               "tensorflow",
               "tensorflow-cpu",
               "tensorflow-gpu",
               "tf-nightly",
               "tf-nightly-cpu",
               "tf-nightly-gpu",
               "intel-tensorflow",
               "intel-tensorflow-avx512",
               "tensorflow-rocm",
               "tensorflow-macos",
           ),
    1:     "torch": {"torch"},
       }
       
       # Check once at runtime
   19: for candidate_name, package_names in _CANDIDATES.items():
   18:     _package_versions[candidate_name] = "N/A"
   35:     for name in package_names:
   27:         try:
   27:             _package_versions[candidate_name] = importlib.metadata.version(name)
   10:             break
   17:         except importlib.metadata.PackageNotFoundError:
   17:             pass
       
       
    1: def _get_version(package_name: str) -> str:
           return _package_versions.get(package_name, "N/A")
       
       
    1: def is_package_available(package_name: str) -> bool:
           return _get_version(package_name) != "N/A"
       
       
       # Python
    1: def get_python_version() -> str:
           return _PY_VERSION
       
       
       # Huggingface Hub
    1: def get_hf_hub_version() -> str:
           return __version__
       
       
       # aiohttp
    1: def is_aiohttp_available() -> bool:
           return is_package_available("aiohttp")
       
       
    1: def get_aiohttp_version() -> str:
           return _get_version("aiohttp")
       
       
       # FastAI
    1: def is_fastai_available() -> bool:
