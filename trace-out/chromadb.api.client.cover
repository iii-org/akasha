                   name=name,
                   schema=schema,
                   metadata=metadata,
                   tenant=self.tenant,
                   database=self.database,
                   configuration=configuration,
               )
       
               persisted_ef_config = model.configuration_json.get("embedding_function")
       
               validate_embedding_function_conflict_on_get(
                   embedding_function, persisted_ef_config
               )
       
               return Collection(
                   client=self._server,
                   model=model,
