    2: class Meter(ABC):
    1:     """Handles instrument creation.
       
           This class provides methods for creating instruments which are then
           used to produce measurements.
           """
       
    5:     def __init__(
               self,
    1:         name: str,
    2:         version: str | None = None,
    2:         schema_url: str | None = None,
    1:     ) -> None:
               super().__init__()
               self._name = name
               self._version = version
               self._schema_url = schema_url
               self._instrument_ids: dict[str, _MetricsHistogramAdvisory | None] = {}
               self._instrument_ids_lock = Lock()
       
    2:     @property
    2:     def name(self) -> str:
               """
               The name of the instrumenting module.
               """
               return self._name
       
    2:     @property
    2:     def version(self) -> str | None:
               """
               The version string of the instrumenting library.
               """
               return self._version
       
    2:     @property
    2:     def schema_url(self) -> str | None:
