    1: from typing import Callable, List, Tuple, Union
       
    1: from thinc.api import Model
    1: from thinc.types import Ints2d
       
    1: from ..tokens import Doc
       
       
    3: def FeatureExtractor(
    1:     columns: Union[List[str], List[int], List[Union[int, str]]],
    1: ) -> Model[List[Doc], List[Ints2d]]:
           return Model("extract_features", forward, attrs={"columns": columns})
       
       
    4: def forward(
    2:     model: Model[List[Doc], List[Ints2d]], docs, is_train: bool
    1: ) -> Tuple[List[Ints2d], Callable]:
           columns = model.attrs["columns"]
           features: List[Ints2d] = []
           for doc in docs:
               if hasattr(doc, "to_array"):
                   attrs = doc.to_array(columns)
               else:
                   attrs = doc.doc.to_array(columns)[doc.start : doc.end]
               if attrs.ndim == 1:
                   attrs = attrs.reshape((attrs.shape[0], 1))
               features.append(model.ops.asarray2i(attrs, dtype="uint64"))
       
           backprop: Callable[[List[Ints2d]], List] = lambda d_features: []
           return features, backprop
