    2: class ConsoleError(Exception):
    1:     """An error in console operation."""
       
       
    2: class StyleError(Exception):
    1:     """An error in styles."""
       
       
    2: class StyleSyntaxError(ConsoleError):
    1:     """Style was badly formatted."""
       
       
    2: class MissingStyle(StyleError):
    1:     """No such style."""
       
       
    2: class StyleStackError(ConsoleError):
    1:     """Style stack is invalid."""
       
       
    2: class NotRenderableError(ConsoleError):
    1:     """Object is not renderable."""
       
       
    2: class MarkupError(ConsoleError):
    1:     """Markup was badly formatted."""
       
       
    2: class LiveError(ConsoleError):
    1:     """Error related to Live display."""
       
       
    2: class NoAltScreen(ConsoleError):
    1:     """Alt screen mode was required."""
