       # mypy: allow-untyped-defs
    1: from typing import TypeVar
       
    1: import torch
       
       
    1: T = TypeVar("T")
       
       
       # returns if all are the same mode
    1: def all_same_mode(modes):
           return all(tuple(mode == modes[0] for mode in modes))
       
       
    1: no_dispatch = torch._C._DisableTorchDispatch
