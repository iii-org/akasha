    1: def _build_pretty_email_regex() -> re.Pattern[str]:
    1:     name_chars = r'[\w!#$%&\'*+\-/=?^_`{|}~]'
    1:     unquoted_name_group = rf'((?:{name_chars}+\s+)*{name_chars}+)'
    1:     quoted_name_group = r'"((?:[^"]|\")+)"'
