    1: from pathlib import Path
    1: from typing import Union, Dict, Any, List, Tuple
    1: from collections import OrderedDict
       
       
       # fmt: off
    1: FilePath = Union[str, Path]
       # Superficial JSON input/output types
       # https://github.com/python/typing/issues/182#issuecomment-186684288
    1: JSONOutput = Union[str, int, float, bool, None, Dict[str, Any], List[Any]]
    1: JSONOutputBin = Union[bytes, str, int, float, bool, None, Dict[str, Any], List[Any]]
       # For input, we also accept tuples, ordered dicts etc.
    1: JSONInput = Union[str, int, float, bool, None, Dict[str, Any], List[Any], Tuple[Any, ...], OrderedDict]
    1: JSONInputBin = Union[bytes, str, int, float, bool, None, Dict[str, Any], List[Any], Tuple[Any, ...], OrderedDict]
    1: YAMLInput = JSONInput
    1: YAMLOutput = JSONOutput
       # fmt: on
       
       
    1: def force_path(location, require_exists=True):
    1:     if not isinstance(location, Path):
               location = Path(location)
    1:     if require_exists and not location.exists():
               raise ValueError(f"Can't read file: {location}")
    1:     return location
       
       
    1: def force_string(location):
           if isinstance(location, str):
               return location
           return str(location)
