           # TODO: I don't want to maintain this, so it
           #       needs to go either into jsonpointer (pending
           #       https://github.com/stefankoegl/python-json-pointer/issues/34) or
           #       into a new external library.
    3:     @_checks_drafts(
    1:         draft7="relative-json-pointer",
    1:         draft201909="relative-json-pointer",
    1:         draft202012="relative-json-pointer",
    1:         raises=jsonpointer.JsonPointerException,
           )
    2:     def is_relative_json_pointer(instance: object) -> bool:
               # Definition taken from:
               # https://tools.ietf.org/html/draft-handrews-relative-json-pointer-01#section-3
               if not isinstance(instance, str):
                   return True
               if not instance:
                   return False
       
               non_negative_integer, rest = [], ""
               for i, character in enumerate(instance):
                   if character.isdigit():
                       # digits with a leading "0" are not allowed
                       if i > 0 and int(instance[i - 1]) == 0:
                           return False
       
                       non_negative_integer.append(character)
                       continue
       
                   if not non_negative_integer:
                       return False
       
                   rest = instance[i:]
                   break
               return (rest == "#") or bool(jsonpointer.JsonPointer(rest))
       
       
