    1:     support = constraints.positive
       
    5:     def __init__(
               self,
    1:         scale: Union[Tensor, float],
    1:         concentration: Union[Tensor, float],
    2:         validate_args: Optional[bool] = None,
    1:     ) -> None:
               self.scale, self.concentration = broadcast_all(scale, concentration)
               self.concentration_reciprocal = self.concentration.reciprocal()
               base_dist = Exponential(
