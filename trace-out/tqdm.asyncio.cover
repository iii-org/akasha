    1: """
       Asynchronous progress bar decorator for iterators.
       Includes a default `range` iterator printing to `stderr`.
       
       Usage:
       >>> from tqdm.asyncio import trange, tqdm
       >>> async for i in trange(10):
       ...     ...
       """
    1: import asyncio
    1: from sys import version_info
       
    1: from .std import tqdm as std_tqdm
       
    1: __author__ = {"github.com/": ["casperdcl"]}
    1: __all__ = ['tqdm_asyncio', 'tarange', 'tqdm', 'trange']
       
       
    2: class tqdm_asyncio(std_tqdm):
    1:     """
           Asynchronous-friendly version of tqdm.
           """
    1:     def __init__(self, iterable=None, *args, **kwargs):
               super().__init__(iterable, *args, **kwargs)
               self.iterable_awaitable = False
               if iterable is not None:
                   if hasattr(iterable, "__anext__"):
                       self.iterable_next = iterable.__anext__
                       self.iterable_awaitable = True
                   elif hasattr(iterable, "__next__"):
                       self.iterable_next = iterable.__next__
                   else:
                       self.iterable_iterator = iter(iterable)
                       self.iterable_next = self.iterable_iterator.__next__
       
    1:     def __aiter__(self):
               return self
       
    1:     async def __anext__(self):
               try:
                   if self.iterable_awaitable:
                       res = await self.iterable_next()
                   else:
                       res = self.iterable_next()
                   self.update()
                   return res
               except StopIteration:
                   self.close()
                   raise StopAsyncIteration
               except BaseException:
                   self.close()
                   raise
       
    1:     def send(self, *args, **kwargs):
               return self.iterable.send(*args, **kwargs)
       
    2:     @classmethod
    2:     def as_completed(cls, fs, *, loop=None, timeout=None, total=None, **tqdm_kwargs):
               """
               Wrapper for `asyncio.as_completed`.
               """
               if total is None:
                   total = len(fs)
               kwargs = {}
               if version_info[:2] < (3, 10):
                   kwargs['loop'] = loop
               yield from cls(asyncio.as_completed(fs, timeout=timeout, **kwargs),
                              total=total, **tqdm_kwargs)
       
    2:     @classmethod
    2:     async def gather(cls, *fs, loop=None, timeout=None, total=None, **tqdm_kwargs):
               """
               Wrapper for `asyncio.gather`.
               """
               async def wrap_awaitable(i, f):
                   return i, await f
       
               ifs = [wrap_awaitable(i, f) for i, f in enumerate(fs)]
               res = [await f for f in cls.as_completed(ifs, loop=loop, timeout=timeout,
                                                        total=total, **tqdm_kwargs)]
               return [i for _, i in sorted(res)]
       
       
    1: def tarange(*args, **kwargs):
           """
           A shortcut for `tqdm.asyncio.tqdm(range(*args), **kwargs)`.
           """
           return tqdm_asyncio(range(*args), **kwargs)
       
       
       # Aliases
    1: tqdm = tqdm_asyncio
    1: trange = tarange
