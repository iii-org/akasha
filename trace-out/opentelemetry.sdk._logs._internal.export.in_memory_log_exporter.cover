    2: class InMemoryLogRecordExporter(LogRecordExporter):
    1:     """Implementation of :class:`.LogRecordExporter` that stores logs in memory.
       
           This class can be used for testing purposes. It stores the exported logs
           in a list in memory that can be retrieved using the
           :meth:`.get_finished_logs` method.
           """
       
    1:     def __init__(self):
               self._logs = []
               self._lock = threading.Lock()
               self._stopped = False
       
    1:     def clear(self) -> None:
               with self._lock:
                   self._logs.clear()
       
    1:     def get_finished_logs(self) -> tuple[ReadableLogRecord, ...]:
               with self._lock:
                   return tuple(self._logs)
       
    3:     def export(
    1:         self, batch: collections.abc.Sequence[ReadableLogRecord]
    1:     ) -> LogRecordExportResult:
               if self._stopped:
                   return LogRecordExportResult.FAILURE
               with self._lock:
                   self._logs.extend(batch)
               return LogRecordExportResult.SUCCESS
       
    1:     def shutdown(self) -> None:
               self._stopped = True
       
       
    4: @deprecated(
    1:     "Use InMemoryLogRecordExporter. Since logs are not stable yet this WILL be removed in future releases."
       )
    2: class InMemoryLogExporter(InMemoryLogRecordExporter):
    1:     pass
