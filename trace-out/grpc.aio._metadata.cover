    1: """Implementation of the metadata abstraction for gRPC Asyncio Python."""
    1: from __future__ import annotations
       
    1: from collections import OrderedDict
    1: from collections.abc import Collection
    1: from collections.abc import ItemsView
    1: from collections.abc import Iterable
    1: from collections.abc import Iterator
    1: from collections.abc import KeysView
    1: from collections.abc import Sequence
    1: from collections.abc import ValuesView
    1: from typing import Any, List, Optional, Tuple, Union
       
    1: from typing_extensions import Self
       
    1: MetadataKey = str
    1: MetadataValue = Union[str, bytes]
    1: MetadatumType = Tuple[MetadataKey, MetadataValue]
    1: MetadataType = Union["Metadata", Sequence[MetadatumType]]
       
       
    2: class Metadata(Collection):  # noqa: PLW1641
    1:     """Metadata abstraction for the asynchronous calls and interceptors.
       
           The metadata is a mapping from str -> List[str]
       
           Traits
               * Multiple entries are allowed for the same key
               * The order of the values by key is preserved
               * Getting by an element by key, retrieves the first mapped value
               * Supports an immutable view of the data
               * Allows partial mutation on the data without recreating the new object from scratch.
           """
       
    1:     def __init__(self, *args: MetadatumType) -> None:
               self._metadata = OrderedDict()
               for md_key, md_value in args:
                   self.add(md_key, md_value)
       
    2:     @classmethod
    2:     def from_tuple(cls, raw_metadata: tuple):
               # Note: We unintentionally support non-tuple arguments here. We plan
               # to emit a DeprecationWarning when a non-tuple type is used.
               if raw_metadata:
                   return cls(*raw_metadata)
               return cls()
       
    2:     @classmethod
    2:     def _create(
               cls,
               raw_metadata: Union[None, Self, Iterable[MetadatumType]],
           ) -> Self:
               # TODO(asheshvidyut): Make this method public and encourage people to use it instead
               # of `from_tuple` to create metadata from non-tuple types.
               if raw_metadata is None:
                   return Metadata()
               if isinstance(raw_metadata, cls):
                   return raw_metadata
               if raw_metadata:
                   return cls(*raw_metadata)
               return cls()
       
    1:     def add(self, key: MetadataKey, value: MetadataValue) -> None:
               self._metadata.setdefault(key, [])
               self._metadata[key].append(value)
       
    1:     def __len__(self) -> int:
               """Return the total number of elements that there are in the metadata,
               including multiple values for the same key.
               """
               return sum(map(len, self._metadata.values()))
       
    1:     def __getitem__(self, key: MetadataKey) -> MetadataValue:
               """When calling <metadata>[<key>], the first element of all those
               mapped for <key> is returned.
               """
               try:
                   return self._metadata[key][0]
               except (ValueError, IndexError) as e:
                   error_msg = f"{key!r}"
                   raise KeyError(error_msg) from e
       
    1:     def __setitem__(self, key: MetadataKey, value: MetadataValue) -> None:
               """Calling metadata[<key>] = <value>
               Maps <value> to the first instance of <key>.
               """
               if key not in self:
                   self._metadata[key] = [value]
               else:
                   current_values = self.get_all(key)
                   self._metadata[key] = [value, *current_values[1:]]
       
    1:     def __delitem__(self, key: MetadataKey) -> None:
               """``del metadata[<key>]`` deletes the first mapping for <key>."""
               current_values = self.get_all(key)
               if not current_values:
                   raise KeyError(repr(key))
               self._metadata[key] = current_values[1:]
       
    1:     def delete_all(self, key: MetadataKey) -> None:
               """Delete all mappings for <key>."""
               del self._metadata[key]
       
    1:     def __iter__(self) -> Iterator[Tuple[MetadataKey, MetadataValue]]:
               for key, values in self._metadata.items():
                   for value in values:
                       yield (key, value)
       
    1:     def keys(self) -> KeysView:
               return KeysView(self._metadata)
       
    1:     def values(self) -> ValuesView:
               return ValuesView(self._metadata)
       
    1:     def items(self) -> ItemsView:
               return ItemsView(self._metadata)
       
    1:     def get(
    1:         self, key: MetadataKey, default: Optional[MetadataValue] = None
           ) -> Optional[MetadataValue]:
               try:
                   return self[key]
               except KeyError:
                   return default
       
    1:     def get_all(self, key: MetadataKey) -> List[MetadataValue]:
               """For compatibility with other Metadata abstraction objects (like in Java),
               this would return all items under the desired <key>.
               """
               return self._metadata.get(key, [])
       
    1:     def set_all(self, key: MetadataKey, values: List[MetadataValue]) -> None:
               self._metadata[key] = values
       
    1:     def __contains__(self, key: MetadataKey) -> bool:
               return key in self._metadata
       
    1:     def __eq__(self, other: object) -> bool:
               if isinstance(other, self.__class__):
                   return self._metadata == other._metadata
               if isinstance(other, tuple):
                   return tuple(self) == other
               return NotImplemented  # pytype: disable=bad-return-type
       
    1:     def __add__(self, other: Any) -> "Metadata":
               if isinstance(other, self.__class__):
                   return Metadata(*(tuple(self) + tuple(other)))
               if isinstance(other, tuple):
                   return Metadata(*(tuple(self) + other))
               return NotImplemented  # pytype: disable=bad-return-type
       
    1:     def __repr__(self) -> str:
               view = tuple(self)
               return "{0}({1!r})".format(self.__class__.__name__, view)
