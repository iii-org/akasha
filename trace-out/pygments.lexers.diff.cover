    1: """
           pygments.lexers.diff
           ~~~~~~~~~~~~~~~~~~~~
       
           Lexers for diff/patch formats.
       
           :copyright: Copyright 2006-present by the Pygments team, see AUTHORS.
           :license: BSD, see LICENSE for details.
       """
       
    1: import re
       
    1: from pygments.lexer import RegexLexer, include, bygroups
    1: from pygments.token import Text, Comment, Operator, Keyword, Name, Generic, \
           Literal, Whitespace
       
    1: __all__ = ['DiffLexer', 'DarcsPatchLexer', 'WDiffLexer']
       
       
    2: class DiffLexer(RegexLexer):
    1:     """
           Lexer for unified or context-style diffs or patches.
           """
       
    1:     name = 'Diff'
    1:     aliases = ['diff', 'udiff']
    1:     filenames = ['*.diff', '*.patch']
    1:     mimetypes = ['text/x-diff', 'text/x-patch']
    1:     url = 'https://en.wikipedia.org/wiki/Diff'
    1:     version_added = ''
       
    1:     tokens = {
    2:         'root': [
    1:             (r'( )(.*)(\n)', bygroups(Whitespace, Text, Whitespace)),
    1:             (r'(!.*|---)(\n)', bygroups(Generic.Strong, Whitespace)),
    1:             (r'((?:< |-).*)(\n)', bygroups(Generic.Deleted, Whitespace)),
    1:             (r'((?:> |\+).*)(\n)', bygroups(Generic.Inserted, Whitespace)),
    1:             (
    1:                 r'(@.*|\d(?:,\d+)?(?:a|c|d)\d+(?:,\d+)?)(\n)',
    1:                 bygroups(Generic.Subheading, Whitespace),
                   ),
    1:             (r'((?:[Ii]ndex|diff).*)(\n)', bygroups(Generic.Heading, Whitespace)),
    1:             (r'(=.*)(\n)', bygroups(Generic.Heading, Whitespace)),
    1:             (r'(.*)(\n)', bygroups(Text, Whitespace)),
               ]
           }
       
    1:     def analyse_text(text):
               if text[:7] == 'Index: ':
                   return True
               if text[:5] == 'diff ':
                   return True
               if text[:4] == '--- ':
                   return 0.9
       
       
    2: class DarcsPatchLexer(RegexLexer):
    1:     """
           DarcsPatchLexer is a lexer for the various versions of the darcs patch
           format.  Examples of this format are derived by commands such as
           ``darcs annotate --patch`` and ``darcs send``.
           """
       
    1:     name = 'Darcs Patch'
    1:     aliases = ['dpatch']
    1:     filenames = ['*.dpatch', '*.darcspatch']
    1:     url = 'https://darcs.net'
    1:     version_added = '0.10'
       
    1:     DPATCH_KEYWORDS = ('hunk', 'addfile', 'adddir', 'rmfile', 'rmdir', 'move',
                              'replace')
       
    1:     tokens = {
    1:         'root': [
    1:             (r'<', Operator),
    1:             (r'>', Operator),
    1:             (r'\{', Operator),
    1:             (r'\}', Operator),
    2:             (r'(\[)((?:TAG )?)(.*)(\n)(.*)(\*\*)(\d+)(\s?)(\])',
    2:              bygroups(Operator, Keyword, Name, Whitespace, Name, Operator,
    1:                       Literal.Date, Whitespace, Operator)),
    2:             (r'(\[)((?:TAG )?)(.*)(\n)(.*)(\*\*)(\d+)(\s?)',
    2:              bygroups(Operator, Keyword, Name, Whitespace, Name, Operator,
    2:                       Literal.Date, Whitespace), 'comment'),
    1:             (r'New patches:', Generic.Heading),
    1:             (r'Context:', Generic.Heading),
    1:             (r'Patch bundle hash:', Generic.Heading),
    2:             (r'(\s*)({})(.*)(\n)'.format('|'.join(DPATCH_KEYWORDS)),
    1:                 bygroups(Whitespace, Keyword, Text, Whitespace)),
    1:             (r'\+', Generic.Inserted, "insert"),
    1:             (r'-', Generic.Deleted, "delete"),
    1:             (r'(.*)(\n)', bygroups(Text, Whitespace)),
               ],
    1:         'comment': [
    1:             (r'[^\]].*\n', Comment),
    1:             (r'\]', Operator, "#pop"),
               ],
    1:         'specialText': [            # darcs add [_CODE_] special operators for clarity
    1:             (r'\n', Whitespace, "#pop"),  # line-based
    1:             (r'\[_[^_]*_]', Operator),
               ],
    1:         'insert': [
    1:             include('specialText'),
    1:             (r'\[', Generic.Inserted),
    1:             (r'[^\n\[]+', Generic.Inserted),
               ],
    1:         'delete': [
    1:             include('specialText'),
    1:             (r'\[', Generic.Deleted),
    1:             (r'[^\n\[]+', Generic.Deleted),
               ],
           }
       
       
    2: class WDiffLexer(RegexLexer):
    1:     """
           A wdiff lexer.
       
           Note that:
       
           * It only works with normal output (without options like ``-l``).
           * If the target files contain "[-", "-]", "{+", or "+}",
             especially they are unbalanced, the lexer will get confused.
           """
       
    1:     name = 'WDiff'
    1:     url = 'https://www.gnu.org/software/wdiff/'
    1:     aliases = ['wdiff']
    1:     filenames = ['*.wdiff']
    1:     mimetypes = []
    1:     version_added = '2.2'
       
    1:     flags = re.MULTILINE | re.DOTALL
       
           # We can only assume "[-" after "[-" before "-]" is `nested`,
           # for instance wdiff to wdiff outputs. We have no way to
           # distinct these marker is of wdiff output from original text.
       
    1:     ins_op = r"\{\+"
    1:     ins_cl = r"\+\}"
    1:     del_op = r"\[\-"
    1:     del_cl = r"\-\]"
    1:     normal = r'[^{}[\]+-]+'  # for performance
    1:     tokens = {
    1:         'root': [
    1:             (ins_op, Generic.Inserted, 'inserted'),
    1:             (del_op, Generic.Deleted, 'deleted'),
    1:             (normal, Text),
    1:             (r'.', Text),
               ],
    1:         'inserted': [
    1:             (ins_op, Generic.Inserted, '#push'),
    1:             (del_op, Generic.Inserted, '#push'),
    1:             (del_cl, Generic.Inserted, '#pop'),
       
    1:             (ins_cl, Generic.Inserted, '#pop'),
    1:             (normal, Generic.Inserted),
    1:             (r'.', Generic.Inserted),
               ],
    1:         'deleted': [
    1:             (del_op, Generic.Deleted, '#push'),
    1:             (ins_op, Generic.Deleted, '#push'),
    1:             (ins_cl, Generic.Deleted, '#pop'),
       
    1:             (del_cl, Generic.Deleted, '#pop'),
    1:             (normal, Generic.Deleted),
    1:             (r'.', Generic.Deleted),
               ],
           }
