       # table for translating virtual keys to X windows key symbols
       
    1: from .constant_values import ESCAPE_SEQUENCE_TO_SPECIAL_KEY, VALID_KEYS
    1: from .key_press import KeyPress
       
       
    1: def make_key_press_from_key_description(key_description: str) -> KeyPress:
       
           if (
  207:         len(key_description) > 2
  110:         and key_description[:1] == '"'
               and key_description[-1:] == '"'
           ):
               key_description = key_description[1:-1]
       
  207:     control = False
  207:     meta = False
  207:     shift = False
  277:     while True:
  277:         l_key_name = key_description.lower()
       
  277:         if l_key_name.startswith("control-"):
   41:             control = True
   41:             key_description = key_description[8:]
   41:             continue
       
  236:         if l_key_name.startswith("ctrl-"):
                   control = True
                   key_description = key_description[5:]
                   continue
       
  236:         if key_description.lower().startswith("\\c-"):
                   control = True
                   key_description = key_description[3:]
                   continue
       
  236:         if key_description.lower().startswith("\\m-"):
                   meta = True
                   key_description = key_description[3:]
                   continue
       
  236:         if key_description in ESCAPE_SEQUENCE_TO_SPECIAL_KEY:
                   key_description = ESCAPE_SEQUENCE_TO_SPECIAL_KEY[key_description]
                   continue
       
  236:         if l_key_name.startswith("meta-"):
    1:             meta = True
    1:             key_description = key_description[5:]
    1:             continue
       
  235:         if l_key_name.startswith("alt-"):
   18:             meta = True
   18:             key_description = key_description[4:]
   18:             continue
       
  217:         if l_key_name.startswith("shift-"):
   10:             shift = True
   10:             key_description = key_description[6:]
   10:             continue
       
  207:         if len(key_description) > 1:
   60:             if key_description.strip().lower() in VALID_KEYS:
   60:                 key_name = key_description.strip().lower()
  120:                 return KeyPress(
   60:                     char="",
   60:                     shift=shift,
   60:                     control=control,
   60:                     meta=meta,
   60:                     key_name=key_name,
                       )
       
                   raise IndexError(f"Not a valid key: '{key_description}'")
       
  294:         return KeyPress(
  147:             char=key_description,
  147:             shift=shift,
  147:             control=control,
  147:             meta=meta,
  147:             key_name="",
               )
