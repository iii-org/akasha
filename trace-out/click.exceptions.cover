    2: class FileError(ClickException):
    1:     """Raised if a file cannot be opened."""
       
    1:     ui_filename: t.Final[str]
    1:     filename: t.Final[str]
       
    1:     def __init__(self, filename: str, hint: str | None = None) -> None:
               if hint is None:
                   hint = _("unknown error")
       
               super().__init__(hint)
               self.ui_filename = format_filename(filename)
               self.filename = filename
       
    1:     def format_message(self) -> str:
