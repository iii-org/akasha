    1: from typing_extensions import ParamSpec
       
       
    1: logger = logging.getLogger("strobelight_function_profiler")
       
    1: console_handler = logging.StreamHandler()
    2: formatter = logging.Formatter(
    1:     "%(name)s, line %(lineno)d, %(asctime)s, %(levelname)s: %(message)s"
