    1: """Chat Message."""
       
    1: from typing import Any, Literal
       
    1: from typing_extensions import override
       
    1: from langchain_core.messages.base import (
           BaseMessage,
           BaseMessageChunk,
           merge_content,
       )
    1: from langchain_core.utils._merge import merge_dicts
       
       
    2: class ChatMessage(BaseMessage):
    1:     """Message that can be assigned an arbitrary speaker (i.e. role)."""
       
    1:     role: str
    1:     """The speaker / role of the Message."""
       
    1:     type: Literal["chat"] = "chat"
    1:     """The type of the message (used during serialization)."""
       
       
    2: class ChatMessageChunk(ChatMessage, BaseMessageChunk):
    1:     """Chat Message chunk."""
       
           # Ignoring mypy re-assignment here since we're overriding the value
           # to make sure that the chunk variant can be discriminated from the
           # non-chunk variant.
    1:     type: Literal["ChatMessageChunk"] = "ChatMessageChunk"  # type: ignore[assignment]
    1:     """The type of the message (used during serialization)."""
       
    2:     @override
    2:     def __add__(self, other: Any) -> BaseMessageChunk:  # type: ignore[override]
               if isinstance(other, ChatMessageChunk):
                   if self.role != other.role:
                       msg = "Cannot concatenate ChatMessageChunks with different roles."
                       raise ValueError(msg)
       
                   return self.__class__(
                       role=self.role,
                       content=merge_content(self.content, other.content),
                       additional_kwargs=merge_dicts(
                           self.additional_kwargs, other.additional_kwargs
                       ),
                       response_metadata=merge_dicts(
                           self.response_metadata, other.response_metadata
                       ),
                       id=self.id,
                   )
               if isinstance(other, BaseMessageChunk):
                   return self.__class__(
                       role=self.role,
                       content=merge_content(self.content, other.content),
                       additional_kwargs=merge_dicts(
                           self.additional_kwargs, other.additional_kwargs
                       ),
                       response_metadata=merge_dicts(
                           self.response_metadata, other.response_metadata
                       ),
                       id=self.id,
                   )
               return super().__add__(other)
