    1: """Indirection for time functions.
       
       We intentionally grab some "time" functions internally to avoid tests mocking "time" to affect
       pytest runtime information (issue #185).
       
       Fixture "mock_timing" also interacts with this module for pytest's own tests.
       """
       
    1: from __future__ import annotations
       
    1: import dataclasses
    1: from datetime import datetime
    1: from datetime import timezone
    1: from time import perf_counter
    1: from time import sleep
    1: from time import time
    1: from typing import TYPE_CHECKING
       
       
    1: if TYPE_CHECKING:
           from pytest import MonkeyPatch
       
       
    3: @dataclasses.dataclass(frozen=True)
    2: class Instant:
    1:     """
           Represents an instant in time, used to both get the timestamp value and to measure
           the duration of a time span.
       
           Inspired by Rust's `std::time::Instant`.
           """
       
           # Creation time of this instant, using time.time(), to measure actual time.
           # Note: using a `lambda` to correctly get the mocked time via `MockTiming`.
           # pylint: disable-next=lambda-assignment
   50:     time: float = dataclasses.field(default_factory=lambda: time(), init=False)  # noqa: PLW0108
       
           # Performance counter tick of the instant, used to measure precise elapsed time.
           # Note: using a `lambda` to correctly get the mocked time via `MockTiming`.
    2:     perf_count: float = dataclasses.field(
   50:         default_factory=lambda: perf_counter(),  # noqa: PLW0108
    1:         init=False,
           )
       
    1:     def elapsed(self) -> Duration:
               """Measure the duration since `Instant` was created."""
   24:         return Duration(start=self, stop=Instant())
       
    1:     def as_utc(self) -> datetime:
               """Instant as UTC datetime."""
               return datetime.fromtimestamp(self.time, timezone.utc)
       
       
    3: @dataclasses.dataclass(frozen=True)
    2: class Duration:
    1:     """A span of time as measured by `Instant.elapsed()`."""
       
    1:     start: Instant
    1:     stop: Instant
       
    2:     @property
    2:     def seconds(self) -> float:
               """Elapsed time of the duration in seconds, measured using a performance counter for precise timing."""
   24:         return self.stop.perf_count - self.start.perf_count
       
       
    3: @dataclasses.dataclass
    2: class MockTiming:
    1:     """Mocks _pytest.timing with a known object that can be used to control timing in tests
           deterministically.
       
           pytest itself should always use functions from `_pytest.timing` instead of `time` directly.
       
           This then allows us more control over time during testing, if testing code also
           uses `_pytest.timing` functions.
       
           Time is static, and only advances through `sleep` calls, thus tests might sleep over large
           numbers and obtain accurate time() calls at the end, making tests reliable and instant."""
       
    1:     _current_time: float = datetime(2020, 5, 22, 14, 20, 50).timestamp()
       
    1:     def sleep(self, seconds: float) -> None:
               self._current_time += seconds
       
    1:     def time(self) -> float:
               return self._current_time
       
    1:     def patch(self, monkeypatch: MonkeyPatch) -> None:
               # pylint: disable-next=import-self
               from _pytest import timing  # noqa: PLW0406
       
               monkeypatch.setattr(timing, "sleep", self.sleep)
               monkeypatch.setattr(timing, "time", self.time)
               monkeypatch.setattr(timing, "perf_counter", self.time)
       
       
    1: __all__ = ["perf_counter", "sleep", "time"]
