    1: from typing import Callable, Tuple, TypeVar, cast
       
    1: from ..config import registry
    1: from ..model import Model
    1: from ..types import List2d, Padded
       
    1: InT = TypeVar("InT", bound=List2d)
    1: OutT = Padded
       
       
    2: @registry.layers("list2padded.v1")
    2: def list2padded() -> Model[InT, OutT]:
           """Create a layer to convert a list of array inputs into Padded."""
           return Model(f"list2padded", forward)
       
       
    1: def forward(model: Model[InT, OutT], Xs: InT, is_train: bool) -> Tuple[OutT, Callable]:
           Yp = model.ops.list2padded(Xs)
       
           def backprop(dYp: OutT) -> InT:
               return cast(InT, model.ops.padded2list(dYp))
       
           return Yp, backprop
