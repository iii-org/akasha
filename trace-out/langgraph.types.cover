    1: _DEFAULT_INTERRUPT_ID = "placeholder-id"
       
       
    3: @final
    2: @dataclass(init=False, slots=True)
    2: class Interrupt:
    1:     """Information about an interrupt that occurred in a node.
       
           !!! version-added "Added in version 0.2.24"
       
           !!! version-changed "Changed in version v0.4.0"
               * `interrupt_id` was introduced as a property
       
           !!! version-changed "Changed in version v0.6.0"
       
               The following attributes have been removed:
       
               * `ns`
               * `when`
               * `resumable`
               * `interrupt_id`, deprecated in favor of `id`
           """
       
    1:     value: Any
    1:     """The value associated with the interrupt."""
       
    1:     id: str
    1:     """The ID of the interrupt. Can be used to resume the interrupt directly."""
       
    1:     def __init__(
               self,
               value: Any,
    1:         id: str = _DEFAULT_INTERRUPT_ID,
               **deprecated_kwargs: Unpack[DeprecatedKwargs],
           ) -> None:
               self.value = value
       
               if (
                   (ns := deprecated_kwargs.get("ns", MISSING)) is not MISSING
                   and (id == _DEFAULT_INTERRUPT_ID)
                   and (isinstance(ns, Sequence))
               ):
                   self.id = xxh3_128_hexdigest("|".join(ns).encode())
               else:
                   self.id = id
       
    2:     @classmethod
    2:     def from_ns(cls, value: Any, ns: str) -> Interrupt:
               return cls(value=value, id=xxh3_128_hexdigest(ns.encode()))
       
    2:     @property
    2:     @deprecated("`interrupt_id` is deprecated. Use `id` instead.", category=None)
    2:     def interrupt_id(self) -> str:
               warn(
                   "`interrupt_id` is deprecated. Use `id` instead.",
                   LangGraphDeprecatedSinceV10,
                   stacklevel=2,
               )
               return self.id
       
       
