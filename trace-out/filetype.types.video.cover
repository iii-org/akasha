       # -*- coding: utf-8 -*-
       
    1: from __future__ import absolute_import
       
    1: from .base import Type
    1: from .isobmff import IsoBmff
       
       
    2: class Mp4(IsoBmff):
    1:     """
           Implements the MP4 video type matcher.
           """
    1:     MIME = 'video/mp4'
    1:     EXTENSION = 'mp4'
       
    1:     def __init__(self):
    2:         super(Mp4, self).__init__(
    1:             mime=Mp4.MIME,
    1:             extension=Mp4.EXTENSION
               )
       
    1:     def match(self, buf):
               if not self._is_isobmff(buf):
                   return False
       
               major_brand, minor_version, compatible_brands = self._get_ftyp(buf)
               for brand in compatible_brands:
                   if brand in ['mp41', 'mp42', 'isom']:
                       return True
               return major_brand in ['mp41', 'mp42', 'isom']
       
       
    2: class M4v(Type):
    1:     """
           Implements the M4V video type matcher.
           """
    1:     MIME = 'video/x-m4v'
    1:     EXTENSION = 'm4v'
       
    1:     def __init__(self):
    2:         super(M4v, self).__init__(
    1:             mime=M4v.MIME,
    1:             extension=M4v.EXTENSION
               )
       
    1:     def match(self, buf):
               return (len(buf) > 10 and
                       buf[0] == 0x0 and buf[1] == 0x0 and
                       buf[2] == 0x0 and buf[3] == 0x1C and
                       buf[4] == 0x66 and buf[5] == 0x74 and
                       buf[6] == 0x79 and buf[7] == 0x70 and
                       buf[8] == 0x4D and buf[9] == 0x34 and
                       buf[10] == 0x56)
       
       
    2: class Mkv(Type):
    1:     """
           Implements the MKV video type matcher.
           """
    1:     MIME = 'video/x-matroska'
    1:     EXTENSION = 'mkv'
       
    1:     def __init__(self):
    2:         super(Mkv, self).__init__(
    1:             mime=Mkv.MIME,
    1:             extension=Mkv.EXTENSION
               )
       
    1:     def match(self, buf):
               contains_ebml_element = buf.startswith(b'\x1A\x45\xDF\xA3')
               contains_doctype_element = buf.find(b'\x42\x82\x88matroska') > -1
               return contains_ebml_element and contains_doctype_element
       
       
    2: class Webm(Type):
    1:     """
           Implements the WebM video type matcher.
           """
    1:     MIME = 'video/webm'
    1:     EXTENSION = 'webm'
       
    1:     def __init__(self):
    2:         super(Webm, self).__init__(
    1:             mime=Webm.MIME,
    1:             extension=Webm.EXTENSION
               )
       
    1:     def match(self, buf):
               contains_ebml_element = buf.startswith(b'\x1A\x45\xDF\xA3')
               contains_doctype_element = buf.find(b'\x42\x82\x84webm') > -1
               return contains_ebml_element and contains_doctype_element
       
       
    2: class Mov(IsoBmff):
    1:     """
           Implements the MOV video type matcher.
           """
    1:     MIME = 'video/quicktime'
    1:     EXTENSION = 'mov'
       
    1:     def __init__(self):
    2:         super(Mov, self).__init__(
    1:             mime=Mov.MIME,
    1:             extension=Mov.EXTENSION
               )
       
    1:     def match(self, buf):
               if not self._is_isobmff(buf):
                   return False
       
               major_brand, minor_version, compatible_brands = self._get_ftyp(buf)
               return major_brand == 'qt  '
       
       
    2: class Avi(Type):
    1:     """
           Implements the AVI video type matcher.
           """
    1:     MIME = 'video/x-msvideo'
    1:     EXTENSION = 'avi'
       
    1:     def __init__(self):
    2:         super(Avi, self).__init__(
    1:             mime=Avi.MIME,
    1:             extension=Avi.EXTENSION
               )
       
    1:     def match(self, buf):
               return (len(buf) > 11 and
                       buf[0] == 0x52 and
                       buf[1] == 0x49 and
                       buf[2] == 0x46 and
                       buf[3] == 0x46 and
                       buf[8] == 0x41 and
                       buf[9] == 0x56 and
                       buf[10] == 0x49 and
                       buf[11] == 0x20)
       
       
    2: class Wmv(Type):
    1:     """
           Implements the WMV video type matcher.
           """
    1:     MIME = 'video/x-ms-wmv'
    1:     EXTENSION = 'wmv'
       
    1:     def __init__(self):
    2:         super(Wmv, self).__init__(
    1:             mime=Wmv.MIME,
    1:             extension=Wmv.EXTENSION
               )
       
    1:     def match(self, buf):
               return (len(buf) > 9 and
                       buf[0] == 0x30 and
                       buf[1] == 0x26 and
                       buf[2] == 0xB2 and
                       buf[3] == 0x75 and
                       buf[4] == 0x8E and
                       buf[5] == 0x66 and
                       buf[6] == 0xCF and
                       buf[7] == 0x11 and
                       buf[8] == 0xA6 and
                       buf[9] == 0xD9)
       
       
    2: class Flv(Type):
    1:     """
           Implements the FLV video type matcher.
           """
    1:     MIME = 'video/x-flv'
    1:     EXTENSION = 'flv'
       
    1:     def __init__(self):
    2:         super(Flv, self).__init__(
    1:             mime=Flv.MIME,
    1:             extension=Flv.EXTENSION
               )
       
    1:     def match(self, buf):
               return (len(buf) > 3 and
                       buf[0] == 0x46 and
                       buf[1] == 0x4C and
                       buf[2] == 0x56 and
                       buf[3] == 0x01)
       
       
    2: class Mpeg(Type):
    1:     """
           Implements the MPEG video type matcher.
           """
    1:     MIME = 'video/mpeg'
    1:     EXTENSION = 'mpg'
       
    1:     def __init__(self):
    2:         super(Mpeg, self).__init__(
    1:             mime=Mpeg.MIME,
    1:             extension=Mpeg.EXTENSION
               )
       
    1:     def match(self, buf):
               return (len(buf) > 3 and
                       buf[0] == 0x0 and
                       buf[1] == 0x0 and
                       buf[2] == 0x1 and
                       buf[3] >= 0xb0 and
                       buf[3] <= 0xbf)
       
       
    2: class M3gp(Type):
    1:     """Implements the 3gp image type matcher."""
       
    1:     MIME = 'video/3gpp'
    1:     EXTENSION = '3gp'
       
    1:     def __init__(self):
    2:         super(M3gp, self).__init__(
    1:             mime=M3gp.MIME,
    1:             extension=M3gp.EXTENSION
               )
       
    1:     def match(self, buf):
               return buf[:7] == bytearray([0x66, 0x74, 0x79, 0x70, 0x33, 0x67, 0x70])
