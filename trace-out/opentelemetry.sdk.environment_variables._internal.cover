    1: from logging import getLogger
    1: from os import environ
       
    1: _logger = getLogger(__name__)
       
       
    4: def parse_boolean_environment_variable(
    3:     environment_variable: str, default: bool = False
    1: ) -> bool:
           value = environ.get(environment_variable)
           if value is None:
               return default
       
           match value.strip().lower():
               case "true":
                   return True
               case "false":
                   return False
               case _:
                   _logger.warning(
                       "Invalid value for %s: %r. Expected 'true' or 'false'.",
                       environment_variable,
                       value,
                   )
                   return default
