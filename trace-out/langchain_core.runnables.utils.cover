    1: Addable = TypeVar("Addable", bound=SupportsAdd[Any, Any])
       
       
    1: def add(addables: Iterable[Addable]) -> Addable | None:
           """Add a sequence of addable objects together.
       
           Args:
               addables: The addable objects to add.
       
           Returns:
               The result of adding the addable objects.
           """
           final: Addable | None = None
           for chunk in addables:
               final = chunk if final is None else final + chunk
           return final
       
       
    1: async def aadd(addables: AsyncIterable[Addable]) -> Addable | None:
           """Asynchronously add a sequence of addable objects together.
       
           Args:
               addables: The addable objects to add.
       
           Returns:
               The result of adding the addable objects.
           """
           final: Addable | None = None
           async for chunk in addables:
               final = chunk if final is None else final + chunk
           return final
       
       
