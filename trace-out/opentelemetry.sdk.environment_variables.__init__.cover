    1: OTEL_EXPORTER_ZIPKIN_TIMEOUT = "OTEL_EXPORTER_ZIPKIN_TIMEOUT"
    1: """
       .. envvar:: OTEL_EXPORTER_ZIPKIN_TIMEOUT
       
