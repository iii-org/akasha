    1: OTEL_SPAN_ATTRIBUTE_COUNT_LIMIT = "OTEL_SPAN_ATTRIBUTE_COUNT_LIMIT"
    1: """
       .. envvar:: OTEL_SPAN_ATTRIBUTE_COUNT_LIMIT
       
