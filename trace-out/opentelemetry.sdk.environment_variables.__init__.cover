    1: OTEL_EXPORTER_ZIPKIN_ENDPOINT = "OTEL_EXPORTER_ZIPKIN_ENDPOINT"
    1: """
       .. envvar:: OTEL_EXPORTER_ZIPKIN_ENDPOINT
       
