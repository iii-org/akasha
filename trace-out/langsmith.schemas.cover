    2: class RunBase(BaseModel):
    1:     """Base Run schema.
       
           A Run is a span representing a single unit of work or operation within your LLM app.
           This could be a single call to an LLM or chain, to a prompt formatting call,
           to a runnable lambda invocation. If you are familiar with OpenTelemetry,
           you can think of a run as a span.
           """
       
    1:     id: UUID
    1:     """Unique identifier for the run."""
       
    1:     name: str
    1:     """Human-readable name for the run."""
       
    1:     start_time: datetime
    1:     """Start time of the run."""
       
    1:     run_type: str
    1:     """The type of run, such as tool, chain, llm, retriever,
           embedding, prompt, parser."""
       
    1:     end_time: Optional[datetime] = None
    1:     """End time of the run, if applicable."""
       
    1:     extra: Optional[dict] = Field(default_factory=_default_extra)
    1:     """Additional metadata or settings related to the run."""
       
    1:     error: Optional[str] = None
    1:     """Error message, if the run encountered any issues."""
       
    1:     serialized: Optional[dict] = None
    1:     """Serialized object that executed the run for potential reuse."""
       
    1:     events: Optional[list[dict]] = None
    1:     """List of events associated with the run, like
           start and end events."""
       
    1:     inputs: dict = Field(default_factory=dict)
    1:     """Inputs used for the run."""
       
    1:     outputs: Optional[dict] = None
    1:     """Outputs generated by the run, if any."""
       
    1:     reference_example_id: Optional[UUID] = None
    1:     """Reference to an example that this run may be based on."""
       
    1:     parent_run_id: Optional[UUID] = None
    1:     """Identifier for a parent run, if this run is a sub-run."""
       
    1:     tags: Optional[list[str]] = None
    1:     """Tags for categorizing or annotating the run."""
       
    2:     attachments: Union[Attachments, dict[str, AttachmentInfo]] = Field(
    1:         default_factory=dict
           )
    1:     """Attachments associated with the run.
       
           Each entry is a tuple of `(mime_type, bytes)`.
           """
       
    2:     @property
    2:     def metadata(self) -> dict[str, Any]:
               """Retrieve the metadata (if any)."""
               if self.extra is None:
                   self.extra = {}
               return self.extra.setdefault("metadata", {})
       
    2:     @property
    2:     def revision_id(self) -> Optional[UUID]:
               """Retrieve the revision ID (if any)."""
               return self.metadata.get("revision_id")
       
    2:     @property
    2:     def latency(self) -> Optional[float]:
               """Latency in seconds."""
               if self.end_time is None:
                   return None
               return (self.end_time - self.start_time).total_seconds()
       
    1:     def __repr__(self):
               """Return a string representation of the RunBase object."""
               return f"{self.__class__}(id={self.id}, name='{self.name}', run_type='{self.run_type}')"
       
    1:     model_config = ConfigDict(arbitrary_types_allowed=True)
       
       
