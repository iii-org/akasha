    2: class BinaryIOLike(Protocol):
    1:     """Protocol for binary IO-like objects."""
       
    1:     def read(self, size: int = -1) -> bytes:
               """Read function."""
               ...
       
    1:     def seek(self, offset: int, whence: int = 0) -> int:
               """Seek function."""
               ...
       
    1:     def getvalue(self) -> bytes:
               """Get value function."""
               ...
       
       
