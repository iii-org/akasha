    2: class Attachment(NamedTuple):
    1:     """Annotated type that will be stored as an attachment if used.
       
           Examples:
               ```python
               from langsmith import traceable
               from langsmith.schemas import Attachment
       
       
               @traceable
               def my_function(bar: int, my_val: Attachment):
                   # my_val will be stored as an attachment
                   # bar will be stored as inputs
                   return bar
               ```
           """
       
    1:     mime_type: str
    1:     data: Union[bytes, Path]
       
       
    1: Attachments = dict[str, Union[tuple[str, bytes], Attachment, tuple[str, Path]]]
    1: """Attachments associated with the run.
       
       Each entry is a tuple of `(mime_type, bytes)`, or `(mime_type, file_path)`
       """
       
       
