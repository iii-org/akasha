    1:     stats: dict[str, Any] | None = None
       
       
    1: def _fetch_insights_runs(
           client: Any,
           session_id: str | UUID,
           job_id: str | UUID,
           *,
    1:     cluster_id: str | UUID | None = None,
       ) -> list[dict[str, Any]]:
           """Fetch runs for an Insights job, optionally filtered to a single cluster."""
           from langsmith import utils as ls_utils  # local import to avoid circular deps
       
           all_runs: list[dict[str, Any]] = []
           limit = 100
           next_offset: int | None = 0
           while next_offset is not None:
               params: dict[str, Any] = {"limit": limit, "offset": next_offset}
               if cluster_id is not None:
                   params["cluster_id"] = str(cluster_id)
       
               resp = client.request_with_retries(
                   "GET",
                   f"/sessions/{session_id}/insights/{job_id}/runs",
                   params=params,
               )
               ls_utils.raise_for_status_with_text(resp)
               body = resp.json()
               batch = body.get("runs", []) or []
               all_runs.extend(batch)
               returned_offset = body.get("offset")
               if returned_offset is None:
                   next_offset = None
               else:
                   next_offset = int(returned_offset)
                   if not batch:
                       next_offset = None
           return all_runs
       
       
    2: class _ClusterWithTraces:
    1:     """Cluster wrapper that can load its traces from the API. Returned by report.clusters[name]."""
       
    1:     __slots__ = ("_cluster", "_report")
       
    1:     def __init__(self, cluster: InsightsCluster, report: InsightsReportResult) -> None:
               self._cluster = cluster
               self._report = report
       
    1:     def __getattr__(self, name: str) -> Any:
               return getattr(self._cluster, name)
       
    1:     def __dir__(self) -> list[str]:
               return list(set(dir(self.__class__)) | set(dir(self._cluster)))
       
    1:     def __repr__(self) -> str:
               return f"_ClusterWithTraces(name={self._cluster.name!r})"
       
    1:     def load_traces(self) -> list[dict[str, Any]]:
               """Fetch run dicts for this cluster from the API."""
               client = getattr(self._report, "_client", None)
               if client is None:
                   raise ValueError(
                       "Report not attached to a client; get reports via Client.get_insights_report()"
                   )
               session_id = getattr(self._report, "_session_id", None)
               job_id = getattr(self._report, "_job_id", None)
               if session_id is None or job_id is None:
                   raise ValueError("Report missing session/job ids")
       
               return _fetch_insights_runs(
                   client=client,
                   session_id=session_id,
                   job_id=job_id,
                   cluster_id=self._cluster.id,
               )
       
       
    2: class _ClustersMap:
    1:     """List-like map of clusters by name. Supports report.clusters['name'] and .load_traces()."""
       
    1:     __slots__ = ("_clusters", "_report")
       
    1:     def __init__(
               self,
               clusters: list[InsightsCluster],
               report: InsightsReportResult,
           ) -> None:
               self._clusters = list(clusters)
               self._report = report
       
    1:     def __getitem__(self, key: str | int) -> _ClusterWithTraces:
               if isinstance(key, int):
                   cluster = self._clusters[key]
               else:
                   by_name = {c.name: c for c in self._clusters}
                   if key not in by_name:
                       raise KeyError(
                           f"Cluster {key!r} not found; available: {list(by_name.keys())}"
                       )
                   cluster = by_name[key]
               return _ClusterWithTraces(cluster, self._report)
       
    1:     def __iter__(self):
               return (_ClusterWithTraces(c, self._report) for c in self._clusters)
       
    1:     def __len__(self) -> int:
               return len(self._clusters)
       
    1:     def __repr__(self) -> str:
               return f"_ClustersMap(n_clusters={len(self._clusters)})"
       
       
    2: class InsightsReportResult(BaseModel):
    1:     """Full result of fetching an Insights report (job + clusters + summary + optional runs)."""
       
    1:     id: UUID | str
    1:     name: str
    1:     status: str
    1:     start_time: datetime | str | None = None
    1:     end_time: datetime | str | None = None
    1:     created_at: datetime | str | None = None
    1:     metadata: dict[str, Any] | None = None
    1:     shape: dict[str, int] | None = None
    1:     error: str | None = None
    1:     config_id: UUID | str | None = None
    1:     clusters: list[InsightsCluster] = Field(default_factory=list)
    1:     report: InsightsSummaryReport | None = None
    1:     runs: list[dict[str, Any]] = Field(default_factory=list)
    1:     """Run dicts when fetched with include_runs=True."""
       
    1:     _client: Any = PrivateAttr(default=None)
    1:     _session_id: Any = PrivateAttr(default=None)
    1:     _job_id: Any = PrivateAttr(default=None)
       
    1:     model_config = ConfigDict(extra="allow")
       
    1:     def _attach_client(
               self,
               client: Any,
               session_id: str | UUID,
               job_id: str | UUID,
           ) -> None:
               """Attach client and ids so clusters can load traces. Called by Client.get_insights_report."""
               object.__setattr__(self, "_client", client)
               object.__setattr__(self, "_session_id", str(session_id))
               object.__setattr__(self, "_job_id", str(job_id))
               object.__setattr__(
                   self,
                   "clusters",
                   _ClustersMap(self.clusters, self),
               )
       
    1:     def to_json(self) -> dict[str, Any]:
               """Return the report as a JSON-serializable dict (raw JSON shape)."""
               clusters_val = self.clusters
               if hasattr(clusters_val, "_clusters"):
                   object.__setattr__(self, "clusters", clusters_val._clusters)
               try:
                   return self.model_dump(mode="json")
               finally:
                   if hasattr(clusters_val, "_clusters"):
                       object.__setattr__(self, "clusters", clusters_val)
       
    1:     def model_dump_json_dict(self) -> dict[str, Any]:
               """Return the report as a JSON-serializable dict (e.g. for saving to file)."""
               return self.model_dump(mode="json")
       
       
