    2: class RootListenersTracer(BaseTracer):
    1:     """Tracer that calls listeners on run start, end, and error."""
       
    1:     log_missing_parent = False
    1:     """Whether to log a warning if the parent is missing."""
       
    6:     def __init__(
               self,
               *,
    1:         config: RunnableConfig,
    1:         on_start: Listener | None,
    1:         on_end: Listener | None,
    1:         on_error: Listener | None,
    1:     ) -> None:
               """Initialize the tracer.
       
               Args:
                   config: The runnable config.
                   on_start: The listener to call on run start.
                   on_end: The listener to call on run end.
                   on_error: The listener to call on run error
               """
               super().__init__(_schema_format="original+chat")
       
               self.config = config
               self._arg_on_start = on_start
               self._arg_on_end = on_end
               self._arg_on_error = on_error
               self.root_id: UUID | None = None
       
    1:     def _persist_run(self, run: Run) -> None:
               # This is a legacy method only called once for an entire run tree
