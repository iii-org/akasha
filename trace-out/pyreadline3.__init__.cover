    1: from platform import system
    1: from importlib.metadata import version, PackageNotFoundError
       
    1: from . import (
           clipboard,
           console,
           lineeditor,
           logger,
           modes,
           rlmain,
           unicode_helper,
       )
    1: from .rlmain import *
       
    1: _S = system()
       
    1: if _S.lower() != "windows":
           raise RuntimeError("pyreadline3 is for Windows only, not {}.".format(_S))
       
    1: del system, _S
       
    1: try:
    1:     __version__ = version("pyreadline3")
       except PackageNotFoundError:
           # package is not installed
           pass
