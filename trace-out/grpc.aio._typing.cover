    1: """Common types for gRPC Async API"""
       
    1: from typing import (
           Any,
           AsyncIterable,
           Callable,
           Iterable,
           Sequence,
           Tuple,
           TypeVar,
           Union,
       )
       
    1: from grpc._cython.cygrpc import EOF
       
       # pylint: disable=unused-import
    1: from ._metadata import Metadata
    1: from ._metadata import MetadataKey
    1: from ._metadata import MetadataType
    1: from ._metadata import MetadataValue
    1: from ._metadata import MetadatumType
       
       # pylint: enable=unused-import
       
    1: RequestType = TypeVar("RequestType")
    1: ResponseType = TypeVar("ResponseType")
    1: SerializingFunction = Callable[[Any], bytes]
    1: DeserializingFunction = Callable[[bytes], Any]
    1: ChannelArgumentType = Sequence[Tuple[str, Any]]
    1: EOFType = type(EOF)
    1: DoneCallbackType = Callable[[Any], None]
    1: RequestIterableType = Union[Iterable[Any], AsyncIterable[Any]]
    1: ResponseIterableType = AsyncIterable[Any]
