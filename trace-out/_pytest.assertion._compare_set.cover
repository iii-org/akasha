    1: from __future__ import annotations
       
    1: from collections.abc import Callable
    1: from collections.abc import Iterator
    1: from collections.abc import Set as AbstractSet
    1: from typing import TypeAlias
       
    1: from _pytest._io.saferepr import saferepr
    1: from _pytest.assertion._typing import _HighlightFunc
       
       
    1: def _set_one_sided_diff(
           posn: str,
           set1: AbstractSet[object],
           set2: AbstractSet[object],
           highlighter: _HighlightFunc,
       ) -> Iterator[str]:
           diff = set1 - set2
           if diff:
               yield f"Extra items in the {posn} set:"
               for item in diff:
                   yield highlighter(saferepr(item))
       
       
    1: def _compare_eq_set(
           left: AbstractSet[object],
           right: AbstractSet[object],
           highlighter: _HighlightFunc,
    1:     verbose: int = 0,
       ) -> Iterator[str]:
           yield from _set_one_sided_diff("left", left, right, highlighter)
           yield from _set_one_sided_diff("right", right, left, highlighter)
       
       
    1: def _compare_gte_set(
           left: AbstractSet[object],
           right: AbstractSet[object],
           highlighter: _HighlightFunc,
    1:     verbose: int = 0,
       ) -> Iterator[str]:
           yield from _set_one_sided_diff("right", right, left, highlighter)
       
       
    1: def _compare_lte_set(
           left: AbstractSet[object],
           right: AbstractSet[object],
           highlighter: _HighlightFunc,
    1:     verbose: int = 0,
       ) -> Iterator[str]:
           yield from _set_one_sided_diff("left", left, right, highlighter)
       
       
    1: def _compare_gt_set(
           left: AbstractSet[object],
           right: AbstractSet[object],
           highlighter: _HighlightFunc,
    1:     verbose: int = 0,
       ) -> Iterator[str]:
           if left == right:
               yield "Both sets are equal"
           else:
               yield from _set_one_sided_diff("right", right, left, highlighter)
       
       
    1: def _compare_lt_set(
           left: AbstractSet[object],
           right: AbstractSet[object],
           highlighter: _HighlightFunc,
    1:     verbose: int = 0,
       ) -> Iterator[str]:
           if left == right:
               yield "Both sets are equal"
           else:
               yield from _set_one_sided_diff("left", left, right, highlighter)
       
       
    2: SetComparisonFunction: TypeAlias = Callable[
    2:     [AbstractSet[object], AbstractSet[object], _HighlightFunc, int],
    1:     Iterator[str],
       ]
       
       
    1: def _both_sets_are_equal(
           left: AbstractSet[object],
           right: AbstractSet[object],
           highlighter: _HighlightFunc,
    1:     verbose: int = 0,
       ) -> Iterator[str]:
           yield "Both sets are equal"
       
       
    1: SET_COMPARISON_FUNCTIONS: dict[str, SetComparisonFunction] = {
           # == can't be done here without a prior refactor because there's an additional
           # explanation for iterable in _compare_eq_any
           # "==": _compare_eq_set,
    1:     "!=": _both_sets_are_equal,
    1:     ">=": _compare_gte_set,
    1:     "<=": _compare_lte_set,
    1:     ">": _compare_gt_set,
    1:     "<": _compare_lt_set,
       }
