       # coding: utf-8
       
    1: import functools
    1: import catalogue
       
       # These need to be imported before packer and unpacker
    1: from ._epoch import utc, epoch  # noqa
       
    1: from ._version import version
    1: from .exceptions import *
       
       # In msgpack-python these are put under a _cmsgpack module that textually includes
       # them. I dislike this so I refactored it.
    1: from ._packer import Packer as _Packer
    1: from ._unpacker import unpackb as _unpackb
    1: from ._unpacker import Unpacker as _Unpacker
    1: from .ext import ExtType
    1: from ._msgpack_numpy import encode_numpy as _encode_numpy
    1: from ._msgpack_numpy import decode_numpy as _decode_numpy
       
       
    1: msgpack_encoders = catalogue.create("srsly", "msgpack_encoders", entry_points=True)
    1: msgpack_decoders = catalogue.create("srsly", "msgpack_decoders", entry_points=True)
       
    1: msgpack_encoders.register("numpy", func=_encode_numpy)
    1: msgpack_decoders.register("numpy", func=_decode_numpy)
       
       
       # msgpack_numpy extensions
    2: class Packer(_Packer):
    1:     def __init__(self, *args, **kwargs):
    1:         default = kwargs.get("default")
    2:         for encoder in msgpack_encoders.get_all().values():
    1:             default = functools.partial(encoder, chain=default)
    1:         kwargs["default"] = default
    1:         super(Packer, self).__init__(*args, **kwargs)
       
       
    2: class Unpacker(_Unpacker):
    1:     def __init__(self, *args, **kwargs):
               object_hook = kwargs.get("object_hook")
               for decoder in msgpack_decoders.get_all().values():
                   object_hook = functools.partial(decoder, chain=object_hook)
               kwargs["object_hook"] = object_hook
               super(Unpacker, self).__init__(*args, **kwargs)
       
       
    1: def pack(o, stream, **kwargs):
           """
           Pack an object and write it to a stream.
           """
           packer = Packer(**kwargs)
           stream.write(packer.pack(o))
       
       
    1: def packb(o, **kwargs):
           """
           Pack an object and return the packed bytes.
           """
    1:     return Packer(**kwargs).pack(o)
       
       
    1: def unpack(stream, **kwargs):
           """
           Unpack a packed object from a stream.
           """
           if "object_pairs_hook" not in kwargs:
               object_hook = kwargs.get("object_hook")
               for decoder in msgpack_decoders.get_all().values():
                   object_hook = functools.partial(decoder, chain=object_hook)
               kwargs["object_hook"] = object_hook
           data = stream.read()
           return _unpackb(data, **kwargs)
       
       
    1: def unpackb(packed, **kwargs):
           """
           Unpack a packed object.
           """
           if "object_pairs_hook" not in kwargs:
               object_hook = kwargs.get("object_hook")
               for decoder in msgpack_decoders.get_all().values():
                   object_hook = functools.partial(decoder, chain=object_hook)
               kwargs["object_hook"] = object_hook
           return _unpackb(packed, **kwargs)
       
       
       # alias for compatibility to simplejson/marshal/pickle.
    1: load = unpack
    1: loads = unpackb
       
    1: dump = pack
    1: dumps = packb
