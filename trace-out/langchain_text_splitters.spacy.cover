    1: """Spacy text splitter."""
       
    1: from __future__ import annotations
       
    1: from typing import TYPE_CHECKING, Any
       
    1: from typing_extensions import override
       
    1: from langchain_text_splitters.base import TextSplitter
       
    1: try:
           # Type ignores needed as long as spacy doesn't support Python 3.14.
    1:     import spacy  # type: ignore[import-not-found, unused-ignore]
    1:     from spacy.lang.en import English  # type: ignore[import-not-found, unused-ignore]
       
    1:     if TYPE_CHECKING:
               from spacy.language import (  # type: ignore[import-not-found, unused-ignore]
                   Language,
               )
       
    1:     _HAS_SPACY = True
       except ImportError:
           _HAS_SPACY = False
       
       
    2: class SpacyTextSplitter(TextSplitter):
    1:     """Splitting text using Spacy package.
       
           Per default, Spacy's `en_core_web_sm` model is used and
           its default max_length is 1000000 (it is the length of maximum character
           this model takes which can be increased for large files). For a faster, but
           potentially less accurate splitting, you can use `pipeline='sentencizer'`.
           """
       
    2:     def __init__(
               self,
    1:         separator: str = "\n\n",
    1:         pipeline: str = "en_core_web_sm",
    1:         max_length: int = 1_000_000,
               *,
    1:         strip_whitespace: bool = True,
               **kwargs: Any,
           ) -> None:
               """Initialize the spacy text splitter."""
               super().__init__(**kwargs)
               self._tokenizer = _make_spacy_pipeline_for_splitting(
                   pipeline, max_length=max_length
               )
               self._separator = separator
               self._strip_whitespace = strip_whitespace
       
    2:     @override
    2:     def split_text(self, text: str) -> list[str]:
               splits = (
                   s.text if self._strip_whitespace else s.text_with_ws
                   for s in self._tokenizer(text).sents
               )
               return self._merge_splits(splits, self._separator)
       
       
    1: def _make_spacy_pipeline_for_splitting(
    1:     pipeline: str, *, max_length: int = 1_000_000
       ) -> Language:
           if not _HAS_SPACY:
               msg = "Spacy is not installed, please install it with `pip install spacy`."
               raise ImportError(msg)
           if pipeline == "sentencizer":
               sentencizer: Language = English()
               sentencizer.add_pipe("sentencizer")
           else:
               sentencizer = spacy.load(pipeline, exclude=["ner", "tagger"])
               sentencizer.max_length = max_length
           return sentencizer
