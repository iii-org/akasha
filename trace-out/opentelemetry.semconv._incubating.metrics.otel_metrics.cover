    1: OTEL_SDK_SPAN_STARTED: Final = "otel.sdk.span.started"
    1: """
       The number of created spans
       Instrument: counter
       Unit: {span}
       Note: Implementations MUST record this metric for all spans, even for non-recording ones.
       """
       
       
    1: def create_otel_sdk_span_started(meter: Meter) -> Counter:
