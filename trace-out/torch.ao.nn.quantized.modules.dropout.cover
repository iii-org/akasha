       # mypy: allow-untyped-defs
    1: import torch
       
       
    1: __all__ = ["Dropout"]
       
       
    2: class Dropout(torch.nn.Dropout):
    1:     r"""This is the quantized equivalent of :class:`~torch.nn.Dropout`.
               And this is a placeholder to enable models where fp32 tensors
               had dropout to work with quantized tensors in train and eval mode.
       
           Args:
               p: probability of an element to be zeroed
               inplace: can optionally do the operation in-place. Default: ``False``
           """
       
    1:     def forward(self, input):
               return input
       
    1:     def _get_name(self):
               return "QuantizedDropout"
       
    2:     @classmethod
    2:     def from_float(cls, mod, use_precomputed_fake_quant=False):
               return cls(mod.p, mod.inplace)
       
    2:     @classmethod
    2:     def from_reference(cls, mod, scale, zero_point):
               return cls(mod.p, mod.inplace)
