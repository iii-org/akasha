    1: from typing import Callable, Tuple, TypeVar, cast
       
    1: from ..config import registry
    1: from ..model import Model
    1: from ..types import FloatsXdT
       
       
    2: @registry.layers("sigmoid_activation.v1")
    2: def sigmoid_activation() -> Model[FloatsXdT, FloatsXdT]:
           return Model("sigmoid_activation", forward)
       
       
    5: def forward(
    3:     model: Model[FloatsXdT, FloatsXdT], X: FloatsXdT, is_train: bool
    1: ) -> Tuple[FloatsXdT, Callable]:
           Y = model.ops.sigmoid(X, inplace=False)
       
           def backprop(dY: FloatsXdT) -> FloatsXdT:
               return cast(
                   FloatsXdT,
                   dY * model.ops.dsigmoid(Y, inplace=False),  # type: ignore[operator]
               )
       
           return Y, backprop
