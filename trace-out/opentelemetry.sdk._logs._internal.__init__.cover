               self._logger_cache_lock = Lock()
               self._active_loggers: WeakSet[Logger] = WeakSet()
               self._active_loggers_lock = Lock()
       
    2:     @property
    2:     def resource(self):
               return self._resource
       
    1:     def _get_logger_no_cache(
               self,
               name: str,
    1:         version: str | None = None,
    1:         schema_url: str | None = None,
    1:         attributes: _ExtendedAttributes | None = None,
           ) -> Logger:
               scope = InstrumentationScope(name, version, schema_url, attributes)
       
               return Logger(
                   self._resource,
                   self._multi_log_record_processor,
                   scope,
                   logger_metrics=self._logger_metrics,
                   _logger_config=self._apply_logger_configurator(scope),
               )
       
    1:     def _get_logger_cached(
               self,
               name: str,
    1:         version: str | None = None,
    1:         schema_url: str | None = None,
           ) -> Logger:
               with self._logger_cache_lock:
                   key = (name, version, schema_url)
                   if key in self._logger_cache:
                       return self._logger_cache[key]
       
                   self._logger_cache[key] = self._get_logger_no_cache(
                       name, version, schema_url
                   )
                   return self._logger_cache[key]
       
    1:     def get_logger(
               self,
               name: str,
    1:         version: str | None = None,
    1:         schema_url: str | None = None,
    1:         attributes: _ExtendedAttributes | None = None,
           ) -> APILogger:
               if self._disabled:
                   return NoOpLogger(
                       name,
                       version=version,
                       schema_url=schema_url,
                       attributes=attributes,
                   )
               logger = (
                   self._get_logger_cached(name, version, schema_url)
                   if attributes is None
                   else self._get_logger_no_cache(
                       name, version, schema_url, attributes
                   )
               )
               with self._active_loggers_lock:
                   self._active_loggers.add(logger)
               return logger
       
    1:     def add_log_record_processor(
               self, log_record_processor: LogRecordProcessor
           ):
