    1: from typing import Protocol
       
    1: from opentelemetry import metrics as metrics_api
    1: from opentelemetry.semconv._incubating.metrics.otel_metrics import (
           create_otel_sdk_log_created,
       )
       
       
    2: class LoggerMetricsT(Protocol):
    1:     def emit_log(self) -> None: ...
       
       
    2: class NoOpLoggerMetrics:
    1:     def emit_log(self) -> None:
               pass
       
       
    2: class LoggerMetrics:
    1:     def __init__(self, meter_provider: metrics_api.MeterProvider) -> None:
               meter = meter_provider.get_meter("opentelemetry-sdk")
               self._created_logs = create_otel_sdk_log_created(meter)
       
    1:     def emit_log(self) -> None:
               self._created_logs.add(1)
       
       
    4: def create_logger_metrics(
    1:     meter_provider: metrics_api.MeterProvider,
    1:     enabled: bool,
    1: ) -> LoggerMetricsT:
           if not enabled:
               return NoOpLoggerMetrics()
       
           return LoggerMetrics(meter_provider)
