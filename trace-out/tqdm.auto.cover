    1: """
       Enables multiple commonly used features.
       
       Method resolution order:
       
       - `tqdm.autonotebook` without import warnings
       - `tqdm.asyncio`
       - `tqdm.std` base class
       
       Usage:
       >>> from tqdm.auto import trange, tqdm
       >>> for i in trange(10):
       ...     ...
       """
    1: import warnings
       
    1: from .std import TqdmExperimentalWarning
       
    2: with warnings.catch_warnings():
    1:     warnings.simplefilter("ignore", category=TqdmExperimentalWarning)
    1:     from .autonotebook import tqdm as notebook_tqdm
       
    1: from .asyncio import tqdm as asyncio_tqdm
    1: from .std import tqdm as std_tqdm
       
    1: if notebook_tqdm != std_tqdm:
           class tqdm(notebook_tqdm, asyncio_tqdm):  # pylint: disable=inconsistent-mro
               pass
       else:
    1:     tqdm = asyncio_tqdm
       
       
    1: def trange(*args, **kwargs):
           """
           A shortcut for `tqdm.auto.tqdm(range(*args), **kwargs)`.
           """
           return tqdm(range(*args), **kwargs)
       
       
    1: __all__ = ["tqdm", "trange"]
