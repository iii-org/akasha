    1: import time
    1: from typing import TYPE_CHECKING, Callable, Dict, Iterable, List, Union, Final
       
    1: from .segment import ControlCode, ControlType, Segment
       
    1: if TYPE_CHECKING:
           from .console import Console, ConsoleOptions, RenderResult
       
    1: STRIP_CONTROL_CODES: Final = [
           7,  # Bell
           8,  # Backspace
           11,  # Vertical tab
           12,  # Form feed
           13,  # Carriage return
       ]
   13: _CONTROL_STRIP_TRANSLATE: Final = {
    6:     _codepoint: None for _codepoint in STRIP_CONTROL_CODES
       }
       
    1: CONTROL_ESCAPE: Final = {
    1:     7: "\\a",
    1:     8: "\\b",
    1:     11: "\\v",
    1:     12: "\\f",
    1:     13: "\\r",
       }
       
   17: CONTROL_CODES_FORMAT: Dict[int, Callable[..., str]] = {
    1:     ControlType.BELL: lambda: "\x07",
    1:     ControlType.CARRIAGE_RETURN: lambda: "\r",
    1:     ControlType.HOME: lambda: "\x1b[H",
    1:     ControlType.CLEAR: lambda: "\x1b[2J",
    1:     ControlType.ENABLE_ALT_SCREEN: lambda: "\x1b[?1049h",
    1:     ControlType.DISABLE_ALT_SCREEN: lambda: "\x1b[?1049l",
    1:     ControlType.SHOW_CURSOR: lambda: "\x1b[?25h",
    1:     ControlType.HIDE_CURSOR: lambda: "\x1b[?25l",
    1:     ControlType.CURSOR_UP: lambda param: f"\x1b[{param}A",
    1:     ControlType.CURSOR_DOWN: lambda param: f"\x1b[{param}B",
    1:     ControlType.CURSOR_FORWARD: lambda param: f"\x1b[{param}C",
    1:     ControlType.CURSOR_BACKWARD: lambda param: f"\x1b[{param}D",
    1:     ControlType.CURSOR_MOVE_TO_COLUMN: lambda param: f"\x1b[{param+1}G",
    1:     ControlType.ERASE_IN_LINE: lambda param: f"\x1b[{param}K",
    1:     ControlType.CURSOR_MOVE_TO: lambda x, y: f"\x1b[{y+1};{x+1}H",
    1:     ControlType.SET_WINDOW_TITLE: lambda title: f"\x1b]0;{title}\x07",
       }
       
       
    2: class Control:
    1:     """A renderable that inserts a control code (non printable but may move cursor).
       
           Args:
               *codes (str): Positional arguments are either a :class:`~rich.segment.ControlType` enum or a
                   tuple of ControlType and an integer parameter
           """
       
    1:     __slots__ = ["segment"]
       
    1:     def __init__(self, *codes: Union[ControlType, ControlCode]) -> None:
               control_codes: List[ControlCode] = [
                   (code,) if isinstance(code, ControlType) else code for code in codes
               ]
               _format_map = CONTROL_CODES_FORMAT
               rendered_codes = "".join(
                   _format_map[code](*parameters) for code, *parameters in control_codes
               )
               self.segment = Segment(rendered_codes, None, control_codes)
       
    2:     @classmethod
    2:     def bell(cls) -> "Control":
               """Ring the 'bell'."""
               return cls(ControlType.BELL)
       
    2:     @classmethod
    2:     def home(cls) -> "Control":
               """Move cursor to 'home' position."""
               return cls(ControlType.HOME)
       
    2:     @classmethod
    2:     def move(cls, x: int = 0, y: int = 0) -> "Control":
               """Move cursor relative to current position.
       
               Args:
                   x (int): X offset.
                   y (int): Y offset.
       
               Returns:
                   ~Control: Control object.
       
               """
       
               def get_codes() -> Iterable[ControlCode]:
                   control = ControlType
                   if x:
                       yield (
                           control.CURSOR_FORWARD if x > 0 else control.CURSOR_BACKWARD,
                           abs(x),
                       )
                   if y:
                       yield (
                           control.CURSOR_DOWN if y > 0 else control.CURSOR_UP,
                           abs(y),
                       )
       
               control = cls(*get_codes())
               return control
       
    2:     @classmethod
    2:     def move_to_column(cls, x: int, y: int = 0) -> "Control":
               """Move to the given column, optionally add offset to row.
       
               Returns:
                   x (int): absolute x (column)
                   y (int): optional y offset (row)
       
               Returns:
                   ~Control: Control object.
               """
       
               return (
                   cls(
                       (ControlType.CURSOR_MOVE_TO_COLUMN, x),
                       (
                           ControlType.CURSOR_DOWN if y > 0 else ControlType.CURSOR_UP,
                           abs(y),
                       ),
                   )
                   if y
                   else cls((ControlType.CURSOR_MOVE_TO_COLUMN, x))
               )
       
    2:     @classmethod
    2:     def move_to(cls, x: int, y: int) -> "Control":
               """Move cursor to absolute position.
       
               Args:
                   x (int): x offset (column)
                   y (int): y offset (row)
       
               Returns:
                   ~Control: Control object.
               """
               return cls((ControlType.CURSOR_MOVE_TO, x, y))
       
    2:     @classmethod
    2:     def clear(cls) -> "Control":
               """Clear the screen."""
               return cls(ControlType.CLEAR)
       
    2:     @classmethod
    2:     def show_cursor(cls, show: bool) -> "Control":
               """Show or hide the cursor."""
               return cls(ControlType.SHOW_CURSOR if show else ControlType.HIDE_CURSOR)
       
    2:     @classmethod
    2:     def alt_screen(cls, enable: bool) -> "Control":
               """Enable or disable alt screen."""
               if enable:
                   return cls(ControlType.ENABLE_ALT_SCREEN, ControlType.HOME)
               else:
                   return cls(ControlType.DISABLE_ALT_SCREEN)
       
    2:     @classmethod
    2:     def title(cls, title: str) -> "Control":
               """Set the terminal window title
       
               Args:
                   title (str): The new terminal window title
               """
               return cls((ControlType.SET_WINDOW_TITLE, title))
       
    1:     def __str__(self) -> str:
               return self.segment.text
       
    4:     def __rich_console__(
    2:         self, console: "Console", options: "ConsoleOptions"
    1:     ) -> "RenderResult":
               if self.segment.text:
                   yield self.segment
       
       
    4: def strip_control_codes(
    3:     text: str, _translate_table: Dict[int, None] = _CONTROL_STRIP_TRANSLATE
    1: ) -> str:
           """Remove control codes from text.
       
           Args:
               text (str): A string possibly contain control codes.
       
           Returns:
               str: String with control codes removed.
           """
           return text.translate(_translate_table)
       
       
    4: def escape_control_codes(
    1:     text: str,
    2:     _translate_table: Dict[int, str] = CONTROL_ESCAPE,
    1: ) -> str:
           """Replace control codes with their "escaped" equivalent in the given text.
           (e.g. "\b" becomes "\\b")
       
           Args:
               text (str): A string possibly containing control codes.
       
           Returns:
               str: String with control codes replaced with their escaped version.
           """
           return text.translate(_translate_table)
       
       
