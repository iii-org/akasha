    1: from __future__ import annotations
       
    1: from collections.abc import Iterable
    1: from io import BufferedReader
    1: from typing import Union
       
    2: MultipartPart = tuple[
    1:     str, tuple[None, Union[bytes, BufferedReader], str, dict[str, str]]
       ]
       
       
    2: class MultipartPartsAndContext:
    1:     parts: list[MultipartPart]
    1:     context: str
       
    1:     __slots__ = ("parts", "context")
       
    1:     def __init__(self, parts: list[MultipartPart], context: str) -> None:
               self.parts = parts
               self.context = context
       
       
    1: def join_multipart_parts_and_context(
           parts_and_contexts: Iterable[MultipartPartsAndContext],
       ) -> MultipartPartsAndContext:
           acc_parts: list[MultipartPart] = []
           acc_context: list[str] = []
           for parts_and_context in parts_and_contexts:
               acc_parts.extend(parts_and_context.parts)
               acc_context.append(parts_and_context.context)
           return MultipartPartsAndContext(acc_parts, "; ".join(acc_context))
