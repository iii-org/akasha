    2: class retry_unless_exception_type(retry_if_exception):
    1:     """Retries until an exception is raised of one or more types."""
       
    3:     def __init__(
               self,
    2:         exception_types: typing.Union[
    2:             typing.Type[BaseException],
    1:             typing.Tuple[typing.Type[BaseException], ...],
    1:         ] = Exception,
    1:     ) -> None:
               self.exception_types = exception_types
