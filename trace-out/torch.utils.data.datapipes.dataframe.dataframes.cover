    2: class CaptureCall(Capture):
    1:     def __init__(self, callable, ctx=None, **kwargs) -> None:
               super().__init__()
               if ctx is None:
                   self.ctx = {"operations": [], "variables": []}
               else:
                   self.ctx = ctx
