    5:     def __init__(
               self,
    1:         content: str | list[str | dict[Any, Any]],
    1:         **kwargs: Any,
    1:     ) -> None: ...
       
    2:     @overload
    6:     def __init__(
               self,
    2:         content: str | list[str | dict[Any, Any]] | None = None,
    2:         content_blocks: list[types.ContentBlock] | None = None,
    1:         **kwargs: Any,
    1:     ) -> None: ...
       
    5:     def __init__(
