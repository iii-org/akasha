    2:     grant_types: list[
    1:         Literal["authorization_code", "refresh_token", "urn:ietf:params:oauth:grant-type:jwt-bearer"] | str
    1:     ] = [
    1:         "authorization_code",
    1:         "refresh_token",
           ]
           # The MCP spec requires the "code" response type, but OAuth
           # servers may also return additional types they support
    1:     response_types: list[str] = ["code"]
    1:     scope: str | None = None
       
           # these fields are currently unused, but we support & store them for potential
