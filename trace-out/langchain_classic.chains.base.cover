               return await run_in_executor(
                   None,
                   self._call,
                   inputs,
                   run_manager.get_sync() if run_manager else None,
               )
       
    2:     @deprecated("0.1.0", alternative="invoke", removal="2.0.0")
   11:     def __call__(
               self,
    1:         inputs: dict[str, Any] | Any,
    2:         return_only_outputs: bool = False,  # noqa: FBT001,FBT002
    2:         callbacks: Callbacks = None,
               *,
    2:         tags: list[str] | None = None,
    2:         metadata: dict[str, Any] | None = None,
    2:         run_name: str | None = None,
    2:         include_run_info: bool = False,
    1:     ) -> dict[str, Any]:
               """Execute the chain.
       
               Args:
                   inputs: Dictionary of inputs, or single input if chain expects
                       only one param. Should contain all inputs specified in
                       `Chain.input_keys` except for inputs that will be set by the chain's
                       memory.
                   return_only_outputs: Whether to return only outputs in the
                       response. If `True`, only new keys generated by this chain will be
                       returned. If `False`, both input keys and new keys generated by this
                       chain will be returned.
                   callbacks: Callbacks to use for this chain run. These will be called in
                       addition to callbacks passed to the chain during construction, but only
                       these runtime callbacks will propagate to calls to other objects.
                   tags: List of string tags to pass to all callbacks. These will be passed in
                       addition to tags passed to the chain during construction, but only
                       these runtime tags will propagate to calls to other objects.
                   metadata: Optional metadata associated with the chain.
                   run_name: Optional name for this run of the chain.
                   include_run_info: Whether to include run info in the response. Defaults
                       to False.
       
               Returns:
                   A dict of named outputs. Should contain all outputs specified in
                       `Chain.output_keys`.
