    5:     def apply(
               self,
    1:         input_list: list[builtins.dict[str, Any]],
    2:         callbacks: Callbacks = None,
    1:     ) -> list[builtins.dict[str, str]]:
               """Call the chain on all inputs in the list."""
               return [self(inputs, callbacks=callbacks) for inputs in input_list]
