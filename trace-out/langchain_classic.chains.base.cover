               config = {
                   "callbacks": callbacks,
                   "tags": tags,
                   "metadata": metadata,
                   "run_name": run_name,
               }
       
               return self.invoke(
                   inputs,
                   cast("RunnableConfig", {k: v for k, v in config.items() if v is not None}),
                   return_only_outputs=return_only_outputs,
                   include_run_info=include_run_info,
               )
       
