    1: def serialize_sequence_via_list(
           v: Any, handler: core_schema.SerializerFunctionWrapHandler, info: core_schema.SerializationInfo
       ) -> Any:
           items: list[Any] = []
       
           mapped_origin = SEQUENCE_ORIGIN_MAP.get(type(v), None)
