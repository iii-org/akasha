    2: class TextResource(Resource):
    1:     """A resource that reads from a string."""
       
    1:     text: str = Field(description="Text content of the resource")
       
    1:     async def read(self) -> str:
               """Read the text content."""
               return self.text  # pragma: no cover
       
       
    2: class BinaryResource(Resource):
    1:     """A resource that reads from bytes."""
       
