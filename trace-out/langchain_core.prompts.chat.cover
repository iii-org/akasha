    2: class ChatMessagePromptTemplate(BaseStringMessagePromptTemplate):
    1:     """Chat message prompt template."""
       
    1:     role: str
    1:     """Role of the message."""
       
    1:     def format(self, **kwargs: Any) -> BaseMessage:
               """Format the prompt template.
       
               Args:
                   **kwargs: Keyword arguments to use for formatting.
       
               Returns:
