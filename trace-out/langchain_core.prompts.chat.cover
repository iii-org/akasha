    1:     async def aformat_messages(self, **kwargs: Any) -> list[BaseMessage]:
               """Async format messages from kwargs.
       
               Args:
                   **kwargs: Keyword arguments to use for formatting.
       
               Returns:
                   List of `BaseMessage` objects.
               """
