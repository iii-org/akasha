   26:         super().__init__(source, filename, file_lineno, leading_whitespace_len)
   26:         self.uses_true_division = uses_true_division
   26:         self.filename = filename
   26:         self.funcname = funcname
       
       
    2: @functools.cache
    2: def make_source_context(*args):
   26:     return SourceContext(*args)
       
       
    1: def fake_range():
           return SourceContext("", None, 0, 0).make_raw_range(0, 1)
       
       
    2: class ParsedDef(NamedTuple):
    1:     ast: ast.Module
