   26:         dedent_src.split("\n", 1)[0]
           )
   52:     ctx = make_source_context(
   26:         source, filename, file_lineno, leading_whitespace_len, True, fn.__name__
           )
   26:     return ParsedDef(py_ast, ctx, source, filename, file_lineno)
