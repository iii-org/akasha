    1: from dataclasses import dataclass
    1: from typing import List
       
    1: from .align import get_alignments
    1: from .alignment_array import AlignmentArray
       
       
    3: @dataclass
    2: class Alignment:
    1:     x2y: AlignmentArray
    1:     y2x: AlignmentArray
       
    2:     @classmethod
    2:     def from_indices(cls, x2y: List[List[int]], y2x: List[List[int]]) -> "Alignment":
               x2y = AlignmentArray(x2y)
               y2x = AlignmentArray(y2x)
               return Alignment(x2y=x2y, y2x=y2x)
       
    2:     @classmethod
    2:     def from_strings(cls, A: List[str], B: List[str]) -> "Alignment":
               x2y, y2x = get_alignments(A, B)
               return Alignment.from_indices(x2y=x2y, y2x=y2x)
