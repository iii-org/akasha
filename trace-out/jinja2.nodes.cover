    1:     fields = ("node", "name", "args", "kwargs", "dyn_args", "dyn_kwargs")
    1:     node: Expr
    1:     name: str
    1:     args: t.List[Expr]
    1:     kwargs: t.List[Pair]
    1:     dyn_args: t.Optional[Expr]
