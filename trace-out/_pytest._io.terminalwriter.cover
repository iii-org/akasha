    1:     def markup(self, text: str, **markup: bool) -> str:
   87:         for name in markup:
   31:             if name not in self._esctable:
                       raise ValueError(f"unknown markup: {name!r}")
   56:         if self.hasmarkup:
                   esc = [self._esctable[name] for name, on in markup.items() if on]
