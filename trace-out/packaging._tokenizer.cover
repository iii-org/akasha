    1: from .specifiers import Specifier
       
       
    3: @dataclass
    2: class Token:
    1:     name: str
    1:     text: str
    1:     position: int
       
       
    2: class ParserSyntaxError(Exception):
    1:     """The provided source text could not be parsed correctly."""
       
    1:     def __init__(
               self,
               message: str,
               *,
               source: str,
               span: tuple[int, int],
           ) -> None:
               self.span = span
               self.message = message
               self.source = source
       
               super().__init__()
       
    1:     def __str__(self) -> str:
               marker = " " * self.span[0] + "~" * (self.span[1] - self.span[0]) + "^"
               return f"{self.message}\n    {self.source}\n    {marker}"
       
       
   19: DEFAULT_RULES: dict[str, re.Pattern[str]] = {
    1:     "LEFT_PARENTHESIS": re.compile(r"\("),
    1:     "RIGHT_PARENTHESIS": re.compile(r"\)"),
    1:     "LEFT_BRACKET": re.compile(r"\["),
    1:     "RIGHT_BRACKET": re.compile(r"\]"),
    1:     "SEMICOLON": re.compile(r";"),
    1:     "COMMA": re.compile(r","),
    2:     "QUOTED_STRING": re.compile(
    1:         r"""
                   (
