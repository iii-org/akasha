                       |
                       ("[^"]*")
                   )
               """,
    1:         re.VERBOSE,
           ),
    1:     "OP": re.compile(r"(===|==|~=|!=|<=|>=|<|>)"),
    1:     "BOOLOP": re.compile(r"\b(or|and)\b"),
    1:     "IN": re.compile(r"\bin\b"),
    1:     "NOT": re.compile(r"\bnot\b"),
    2:     "VARIABLE": re.compile(
