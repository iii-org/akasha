    1: """
       Message wrapper with metadata support.
       
       This module defines a wrapper type that combines JSONRPCMessage with metadata
       to support transport-specific features like resumability.
       """
       
    1: from collections.abc import Awaitable, Callable
    1: from dataclasses import dataclass
       
    1: from mcp.types import JSONRPCMessage, RequestId
       
    1: ResumptionToken = str
       
    1: ResumptionTokenUpdateCallback = Callable[[ResumptionToken], Awaitable[None]]
       
       # Callback type for closing SSE streams without terminating
    1: CloseSSEStreamCallback = Callable[[], Awaitable[None]]
       
       
    3: @dataclass
    2: class ClientMessageMetadata:
    1:     """Metadata specific to client messages."""
       
    1:     resumption_token: ResumptionToken | None = None
    1:     on_resumption_token_update: Callable[[ResumptionToken], Awaitable[None]] | None = None
       
       
    3: @dataclass
    2: class ServerMessageMetadata:
    1:     """Metadata specific to server messages."""
       
    1:     related_request_id: RequestId | None = None
           # Request-specific context (e.g., headers, auth info)
    1:     request_context: object | None = None
           # Callback to close SSE stream for the current request without terminating
    1:     close_sse_stream: CloseSSEStreamCallback | None = None
           # Callback to close the standalone GET SSE stream (for unsolicited notifications)
    1:     close_standalone_sse_stream: CloseSSEStreamCallback | None = None
       
       
    1: MessageMetadata = ClientMessageMetadata | ServerMessageMetadata | None
       
       
    3: @dataclass
    2: class SessionMessage:
    1:     """A message with specific metadata for transport-specific features."""
       
    1:     message: JSONRPCMessage
    1:     metadata: MessageMetadata = None
