    1: from __future__ import annotations
       
    1: import sys
    1: import typing_extensions
    1: from typing import Any, Type, Union, Literal, Optional
    1: from datetime import date, datetime
    1: from typing_extensions import get_args as _get_args, get_origin as _get_origin
       
    1: from .._types import StrBytesIntFloat
    1: from ._datetime_parse import parse_date as _parse_date, parse_datetime as _parse_datetime
       
    1: _LITERAL_TYPES = {Literal, typing_extensions.Literal}
       
       
    1: def get_args(tp: type[Any]) -> tuple[Any, ...]:
           return _get_args(tp)
       
       
    1: def get_origin(tp: type[Any]) -> type[Any] | None:
           return _get_origin(tp)
       
       
    1: def is_union(tp: Optional[Type[Any]]) -> bool:
           if sys.version_info < (3, 10):
               return tp is Union  # type: ignore[comparison-overlap]
           else:
               import types
       
               return tp is Union or tp is types.UnionType  # type: ignore[comparison-overlap]
       
       
    1: def is_typeddict(tp: Type[Any]) -> bool:
           return typing_extensions.is_typeddict(tp)
       
       
    1: def is_literal_type(tp: Type[Any]) -> bool:
           return get_origin(tp) in _LITERAL_TYPES
       
       
    1: def parse_date(value: Union[date, StrBytesIntFloat]) -> date:
           return _parse_date(value)
       
       
    1: def parse_datetime(value: Union[datetime, StrBytesIntFloat]) -> datetime:
           return _parse_datetime(value)
