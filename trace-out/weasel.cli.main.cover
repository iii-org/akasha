    1: import typer
       
    1: COMMAND = "python -m weasel"
    1: NAME = "weasel"
    1: HELP = """weasel Command-line Interface
       
       DOCS: https://github.com/explosion/weasel
       """
       
    1: PROJECT_FILE = "project.yml"
    1: PROJECT_LOCK = "project.lock"
       
       # Wrappers for Typer's annotations. Initially created to set defaults and to
       # keep the names short, but not needed at the moment.
    1: Arg = typer.Argument
    1: Opt = typer.Option
       
    1: app = typer.Typer(name=NAME, help=HELP, no_args_is_help=True, add_completion=False)
       
       
    1: def _get_parent_command(ctx: typer.Context) -> str:
           parent_command = ""
           ctx_parent = ctx.parent
           while ctx_parent:
               if ctx_parent.info_name:
                   parent_command = ctx_parent.info_name + " " + parent_command
                   ctx_parent = ctx_parent.parent
               else:
                   return COMMAND
           return parent_command.strip()
