    1: """create errno-specific classes for IO or os calls."""
       
    1: from __future__ import annotations
       
    1: from collections.abc import Callable
    1: import errno
    1: import os
    1: import sys
    1: from typing import TYPE_CHECKING
    1: from typing import TypeVar
       
       
    1: if TYPE_CHECKING:
           from typing_extensions import ParamSpec
       
           P = ParamSpec("P")
       
    1: R = TypeVar("R")
       
       
    2: class Error(EnvironmentError):
    1:     def __repr__(self) -> str:
               return "{}.{} {!r}: {} ".format(
                   self.__class__.__module__,
                   self.__class__.__name__,
                   self.__class__.__doc__,
                   " ".join(map(str, self.args)),
                   # repr(self.args)
               )
       
    1:     def __str__(self) -> str:
               s = "[{}]: {}".format(
                   self.__class__.__doc__,
                   " ".join(map(str, self.args)),
               )
               return s
       
       
    1: _winerrnomap = {
    1:     2: errno.ENOENT,
    1:     3: errno.ENOENT,
    1:     17: errno.EEXIST,
    1:     18: errno.EXDEV,
    1:     13: errno.EBUSY,  # empty cd drive, but ENOMEDIUM seems unavailable
    1:     22: errno.ENOTDIR,
    1:     20: errno.ENOTDIR,
    1:     267: errno.ENOTDIR,
    1:     5: errno.EACCES,  # anything better?
       }
       
       
    2: class ErrorMaker:
    1:     """lazily provides Exception classes for each possible POSIX errno
           (as defined per the 'errno' module).  All such instances
           subclass EnvironmentError.
           """
       
    1:     _errno2class: dict[int, type[Error]] = {}
       
    1:     def __getattr__(self, name: str) -> type[Error]:
               if name[0] == "_":
                   raise AttributeError(name)
               eno = getattr(errno, name)
               cls = self._geterrnoclass(eno)
               setattr(self, name, cls)
               return cls
       
    1:     def _geterrnoclass(self, eno: int) -> type[Error]:
               try:
                   return self._errno2class[eno]
               except KeyError:
                   clsname = errno.errorcode.get(eno, f"UnknownErrno{eno}")
                   errorcls = type(
                       clsname,
                       (Error,),
                       {"__module__": "py.error", "__doc__": os.strerror(eno)},
                   )
                   self._errno2class[eno] = errorcls
                   return errorcls
       
    1:     def checked_call(
               self, func: Callable[P, R], *args: P.args, **kwargs: P.kwargs
           ) -> R:
               """Call a function and raise an errno-exception if applicable."""
               __tracebackhide__ = True
               try:
                   return func(*args, **kwargs)
               except Error:
                   raise
               except OSError as value:
                   if not hasattr(value, "errno"):
                       raise
                   if sys.platform == "win32":
                       try:
                           # error: Invalid index type "Optional[int]" for "dict[int, int]"; expected type "int"  [index]
                           # OK to ignore because we catch the KeyError below.
                           cls = self._geterrnoclass(_winerrnomap[value.errno])  # type:ignore[index]
                       except KeyError:
                           raise value
                   else:
                       # we are not on Windows, or we got a proper OSError
                       if value.errno is None:
                           cls = type(
                               "UnknownErrnoNone",
                               (Error,),
                               {"__module__": "py.error", "__doc__": None},
                           )
                       else:
                           cls = self._geterrnoclass(value.errno)
       
                   raise cls(f"{func.__name__}{args!r}")
       
       
    1: _error_maker = ErrorMaker()
    1: checked_call = _error_maker.checked_call
       
       
    1: def __getattr__(attr: str) -> type[Error]:
           return getattr(_error_maker, attr)  # type: ignore[no-any-return]
