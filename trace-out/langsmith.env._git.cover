    1: """Fetch information about any current git repo."""
       
    1: import functools
    1: import logging
    1: import subprocess
    1: from typing import List, Optional, TypeVar
       
    1: from typing_extensions import TypedDict
       
    1: logger = logging.getLogger(__name__)
       
    1: T = TypeVar("T")
       
       
    1: def exec_git(command: List[str]) -> Optional[str]:
           try:
               return subprocess.check_output(
                   ["git"] + command, encoding="utf-8", stderr=subprocess.DEVNULL
               ).strip()
           except BaseException:
               return None
       
       
    2: class GitInfo(TypedDict, total=False):
    1:     repo_name: Optional[str]
    1:     remote_url: Optional[str]
    1:     commit: Optional[str]
    1:     branch: Optional[str]
    1:     author_name: Optional[str]
    1:     author_email: Optional[str]
    1:     commit_time: Optional[str]
    1:     dirty: Optional[bool]
    1:     tags: Optional[str]
       
       
    2: @functools.lru_cache(maxsize=1)
    2: def get_git_info(remote: str = "origin") -> GitInfo:
           """Get information about the git repository."""
           if not exec_git(["rev-parse", "--is-inside-work-tree"]):
               return GitInfo(
                   remote_url=None,
                   commit=None,
                   branch=None,
                   author_name=None,
                   author_email=None,
                   commit_time=None,
                   dirty=None,
                   tags=None,
                   repo_name=None,
               )
       
           return {
               "remote_url": exec_git(["remote", "get-url", remote]),
               "commit": exec_git(["rev-parse", "HEAD"]),
               "commit_time": exec_git(["log", "-1", "--format=%ct"]),
               "branch": exec_git(["rev-parse", "--abbrev-ref", "HEAD"]),
               "tags": exec_git(
                   ["describe", "--tags", "--exact-match", "--always", "--dirty"]
               ),
               "dirty": exec_git(["status", "--porcelain"]) != "",
               "author_name": exec_git(["log", "-1", "--format=%an"]),
               "author_email": exec_git(["log", "-1", "--format=%ae"]),
               "repo_name": (exec_git(["rev-parse", "--show-toplevel"]) or "").split("/")[-1],
           }
