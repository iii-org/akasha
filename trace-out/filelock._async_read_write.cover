    2: class AsyncAcquireReadWriteReturnProxy:
    1:     """Context-aware object that releases the async read/write lock on exit."""
       
    1:     def __init__(self, lock: AsyncReadWriteLock) -> None:
               self.lock = lock
       
    1:     async def __aenter__(self) -> AsyncReadWriteLock:
