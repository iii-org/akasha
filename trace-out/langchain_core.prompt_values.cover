    1: """**Prompt values** for language model prompts.
       
       Prompt values are used to represent different pieces of prompts. They can be used to
       represent text, images, or chat message pieces.
       """
       
    1: from __future__ import annotations
       
    1: from abc import ABC, abstractmethod
    1: from collections.abc import Sequence
    1: from typing import Any, Literal, cast
       
    1: from typing_extensions import TypedDict
       
    1: from langchain_core.load.serializable import Serializable
    1: from langchain_core.messages import (
           AnyMessage,
           BaseMessage,
           HumanMessage,
           get_buffer_string,
       )
       
       
    2: class PromptValue(Serializable, ABC):
    1:     """Base abstract class for inputs to any language model.
       
           `PromptValues` can be converted to both LLM (pure text-generation) inputs and
           chat model inputs.
           """
       
    2:     @classmethod
    2:     def is_lc_serializable(cls) -> bool:
               """Return `True` as this class is serializable."""
               return True
       
    2:     @classmethod
    2:     def get_lc_namespace(cls) -> list[str]:
               """Get the namespace of the LangChain object.
       
               Returns:
                   `["langchain", "schema", "prompt"]`
               """
               return ["langchain", "schema", "prompt"]
       
    2:     @abstractmethod
    2:     def to_string(self) -> str:
               """Return prompt value as string."""
       
    2:     @abstractmethod
    2:     def to_messages(self) -> list[BaseMessage]:
               """Return prompt as a list of messages."""
       
       
    2: class StringPromptValue(PromptValue):
    1:     """String prompt value."""
       
    1:     text: str
    1:     """Prompt text."""
       
    1:     type: Literal["StringPromptValue"] = "StringPromptValue"
       
    2:     @classmethod
    2:     def get_lc_namespace(cls) -> list[str]:
               """Get the namespace of the LangChain object.
       
               Returns:
                   `["langchain", "prompts", "base"]`
               """
               return ["langchain", "prompts", "base"]
       
    1:     def to_string(self) -> str:
               """Return prompt as string."""
               return self.text
       
    1:     def to_messages(self) -> list[BaseMessage]:
               """Return prompt as messages."""
               return [HumanMessage(content=self.text)]
       
       
    2: class ChatPromptValue(PromptValue):
    1:     """Chat prompt value.
       
           A type of a prompt value that is built from messages.
           """
       
    1:     messages: Sequence[BaseMessage]
    1:     """List of messages."""
       
    1:     def to_string(self) -> str:
               """Return prompt as string."""
               return get_buffer_string(self.messages)
       
    1:     def to_messages(self) -> list[BaseMessage]:
               """Return prompt as a list of messages."""
               return list(self.messages)
       
    2:     @classmethod
    2:     def get_lc_namespace(cls) -> list[str]:
               """Get the namespace of the LangChain object.
       
               Returns:
                   `["langchain", "prompts", "chat"]`
               """
               return ["langchain", "prompts", "chat"]
       
       
    2: class ImageURL(TypedDict, total=False):
    1:     """Image URL for multimodal model inputs (OpenAI format).
       
           Represents the inner `image_url` object in OpenAI's Chat Completion API format. This
           is used by `ImagePromptTemplate` and `ChatPromptTemplate`.
       
           See Also:
               `ImageContentBlock`: LangChain's provider-agnostic image format used in message
               content blocks. Use `ImageContentBlock` when working with the standardized
               message format across different providers.
       
           Note:
               The `detail` field values are not validated locally. Invalid values
               will be rejected by the downstream API, allowing new valid values to
               be used without requiring a LangChain update.
           """
       
    1:     detail: Literal["auto", "low", "high"]
    1:     """Specifies the detail level of the image.
       
           Defaults to ``'auto'`` if not specified. Higher detail levels consume
           more tokens but provide better image understanding.
           """
       
    1:     url: str
    1:     """URL of the image or base64-encoded image data."""
       
       
    2: class ImagePromptValue(PromptValue):
    1:     """Image prompt value."""
       
    1:     image_url: ImageURL
    1:     """Image URL."""
       
    1:     type: Literal["ImagePromptValue"] = "ImagePromptValue"
       
    1:     def to_string(self) -> str:
               """Return prompt (image URL) as string."""
               return self.image_url.get("url", "")
       
    1:     def to_messages(self) -> list[BaseMessage]:
               """Return prompt (image URL) as messages."""
               return [HumanMessage(content=[cast("dict[str, Any]", self.image_url)])]
       
       
    2: class ChatPromptValueConcrete(ChatPromptValue):
    1:     """Chat prompt value which explicitly lists out the message types it accepts.
       
           For use in external schemas.
           """
       
    1:     messages: Sequence[AnyMessage]
    1:     """Sequence of messages."""
       
    1:     type: Literal["ChatPromptValueConcrete"] = "ChatPromptValueConcrete"
