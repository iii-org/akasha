           # In order of debuggers like PDB being able to step through the code,
           # we add a fake linecache entry.
   40:     count = 1
   40:     base_filename = filename
   40:     while True:
   40:         linecache_tuple = (
   40:             len(script),
   40:             None,
   40:             script.splitlines(True),
   40:             filename,
               )
   40:         old_val = linecache.cache.setdefault(filename, linecache_tuple)
   40:         if old_val == linecache_tuple:
   40:             break
       
               filename = f"{base_filename[:-1]}-{count}>"
               count += 1
       
   40:     _compile_and_eval(script, globs, locs, filename)
       
   40:     return locs
       
       
