    1:     config.stash[assertstate_key].hook = hook = rewrite.AssertionRewritingHook(config)
    1:     sys.meta_path.insert(0, hook)
    1:     config.stash[assertstate_key].trace("installed rewrite import hook")
       
    1:     def undo() -> None:
    1:         hook = config.stash[assertstate_key].hook
    1:         if hook is not None and hook in sys.meta_path:
    1:             sys.meta_path.remove(hook)
       
    1:     config.add_cleanup(undo)
    1:     return hook
       
       
    1: def pytest_collection(session: Session) -> None:
           # This hook is only called when test modules are collected
