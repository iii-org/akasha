    1:     def mark_rewrite(self, *names: str) -> None: ...
       
       
    2: class DummyRewriteHook:
    1:     """A no-op import hook for when rewriting is disabled."""
       
    1:     def mark_rewrite(self, *names: str) -> None:
   30:         pass
       
       
