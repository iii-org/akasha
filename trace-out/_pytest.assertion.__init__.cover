    1:     assertstate = session.config.stash.get(assertstate_key, None)
    1:     if assertstate:
    1:         if assertstate.hook is not None:
    1:             assertstate.hook.set_session(session)
       
       
    2: @hookimpl(wrapper=True, tryfirst=True)
    2: def pytest_runtest_protocol(item: Item) -> Generator[None, object, object]:
           """Setup the pytest_assertrepr_compare and pytest_assertion_pass hooks.
       
           The rewrite module will use util._reprcompare if it exists to use custom
           reporting via the pytest_assertrepr_compare hook.  This sets up this custom
           comparison for the test.
