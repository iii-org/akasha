    1: def register_rng_prim(name, schema, impl_aten, impl_meta, doc, tags=None):
    2:     rngprim_def = torch.library.custom_op(
    1:         "rngprims::" + name, impl_aten, mutates_args=(), schema=schema
           )
           # pyrefly: ignore [missing-attribute]
    1:     rngprim_def.register_fake(impl_meta)
       
    1:     prim_packet = getattr(torch._ops.ops.rngprims, name)
    1:     prim = prim_packet.default
    1:     if tags:
    1:         prim._tags = tags
       
    3:     for p in (prim_packet, prim):
    2:         p.__doc__ = doc
    2:         p.return_type = torch._prims_common.RETURN_TYPE.NEW  # type: ignore[attr-defined]
       
    2:         p.schema = name + schema
    2:         p.impl_aten = impl_aten
    2:         p.prim_meta_impl = impl_meta
       
       
       # Philox rand offsets could be shared in future with other philox ops, so
       # keeping these functions in global scope.
    2: def philox_rand_offset_meta(
    1:     shape: torch.Size,
       ):
           return _prims.TensorLike(torch.tensor(0, dtype=torch.int64))
       
       
    2: def philox_rand_offset(
    1:     shape: torch.Size,
       ):
           # For impl, look at the function calc_execution_policy in the file
           # aten/src/ATen/native/cuda/DistributionTemplates.h. The impl was copied at
           # commit hash 72aa0667bd16707d50eb8fa337092a1f5d11dfb6
           numel_scalar = 1
           for dim_size in shape:
               numel_scalar *= dim_size
           numel = torch.scalar_tensor(numel_scalar, dtype=torch.int64)
       
           block_size = 256
           unroll = 4
           curand4_engine_calls = 4
           device_property = torch.cuda.get_device_properties(torch.cuda.current_device())
           blocks_per_sm = device_property.max_threads_per_multi_processor // block_size
           num = cast(int, numel)
           grid_size = (num + block_size - 1) // block_size
           grid_size = min(grid_size, device_property.multi_processor_count * blocks_per_sm)
           return ((num - 1) // (block_size * grid_size * unroll) + 1) * curand4_engine_calls
       
       
    1: def register_philox_rand():
    1:     name = "philox_rand"
    1:     schema = "(SymInt[] size, Tensor seed, Tensor offset, int[]? stride, Device? device=None, ScalarType? dtype=None) -> (Tensor, Tensor)"  # noqa: B950
       
    7:     def _philox_rand_meta(
    1:         shape: torch.Size,
    1:         seed: torch.Tensor,
    1:         offset: torch.Tensor,
    1:         stride: tuple[int, ...] | None,
    1:         device: _device,
    1:         dtype: _dtype,
           ):
               # stride arg will be useful for distributed usecase. Currently, its unused.
               assert stride is None
               stride = make_contiguous_strides_for(shape)
               random_values = _prims.TensorMeta(
                   shape=shape, strides=stride, dtype=dtype, device=device
               )
               offset = philox_rand_offset_meta(shape)
               return (random_values, offset)
       
    7:     def _philox_rand(
    1:         shape: torch.Size,
    1:         seed: torch.Tensor,
    1:         offset: torch.Tensor,
    1:         stride: tuple[int, ...] | None,
    1:         device: _device,
    1:         dtype: _dtype,
           ):
               # stride arg will be useful for distributed usecase. Currently, its unused.
               assert stride is None
               if device.type == "cpu":
                   devices = []
               else:
                   devices = [device]
       
               if device.type != "cuda":
                   raise throw_on_non_cuda(device)
       
               with torch.random.fork_rng(devices):
                   CUDARngStateHelper.set_torch_state_tensor(seed, offset)
                   random_values = torch.rand(shape, device=device, dtype=dtype)
       
               return random_values, philox_rand_offset(shape)
       
    2:     register_rng_prim(
    1:         name=name,
    1:         schema=schema,
    1:         impl_aten=_philox_rand,
    1:         impl_meta=_philox_rand_meta,
    1:         doc="Philox based stateless rand operator",
    1:         tags=(torch.Tag.nondeterministic_seeded,),
           )
       
       
    1: def get_device(args, kwargs):
           if kwargs.get("device"):
               device = kwargs.get("device")
               if isinstance(device, str):
                   device = torch.device(device)
               return device.type
       
           devices = {arg.device.type for arg in args if isinstance(arg, torch.Tensor)}
           if any(dev == "cuda" for dev in devices):
               return "cuda"
           elif any(dev == "xpu" for dev in devices):
               return "xpu"
           elif any(dev == "hpu" for dev in devices):
               return "hpu"
           elif any(dev == "cpu" for dev in devices):
               return "cpu"
           return None
       
       
    1: def register_run_and_save_rng_state_op():
    2:     class RunAndSaveRngState(HigherOrderOperator):
    1:         def __init__(self):
    1:             super().__init__("run_and_save_rng_state")
       
    1:         def __call__(self, op, *args, **kwargs):
                   return super().__call__(op, *args, **kwargs)
       
    1:     run_and_save_rng_state = RunAndSaveRngState()
       
    2:     run_and_save_rng_state.py_impl(DispatchKey.Autograd)(
    1:         autograd_not_implemented(run_and_save_rng_state, deferred_error=True)
           )
       
    2:     @run_and_save_rng_state.py_impl(DispatchKey.CUDA)
    2:     def impl_cuda(op, *args, **kwargs):
               return torch.cuda.get_rng_state(), op(*args, **kwargs)
       
    2:     @run_and_save_rng_state.py_impl(DispatchKey.CPU)
    2:     def impl_cpu(op, *args, **kwargs):
               return torch.get_rng_state(), op(*args, **kwargs)
       
    2:     @run_and_save_rng_state.py_impl(DispatchKey.HPU)
    2:     def impl_hpu(op, *args, **kwargs):
               if hasattr(torch, "hpu"):
                   return torch.hpu.get_rng_state(), op(*args, **kwargs)
               raise RuntimeError("functionalize a hpu RNG operator is not supported.")
       
    2:     @run_and_save_rng_state.py_impl(DispatchKey.XPU)
    2:     def impl_xpu(op, *args, **kwargs):
               return torch.xpu.get_rng_state(), op(*args, **kwargs)
       
    2:     @run_and_save_rng_state.py_impl(DispatchKey.BackendSelect)
    2:     def impl_backend_select(op, *args, **kwargs):
               impl_map = {
                   "cuda": impl_cuda,
                   "cpu": impl_cpu,
                   "hpu": impl_hpu,
                   "xpu": impl_xpu,
               }
               device = get_device(args, kwargs)
               assert device in impl_map, f"Backend not supported for {device}"
               impl = impl_map[device]
               return impl(op, *args, **kwargs)
       
    2:     @run_and_save_rng_state.py_impl(FakeTensorMode)
    2:     def impl_fake_tensor_mode(mode, op, *args, **kwargs):
               # Check device to call the right impl
