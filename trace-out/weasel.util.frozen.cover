    1: from ..errors import Errors
       
       
    2: class SimpleFrozenDict(dict):
    1:     """Simplified implementation of a frozen dict, mainly used as default
           function or method argument (for arguments that should default to empty
           dictionary). Will raise an error if user or Weasel attempts to add to dict.
           """
       
    1:     def __init__(self, *args, error: str = Errors.E001, **kwargs) -> None:
               """Initialize the frozen dict. Can be initialized with pre-defined
               values.
       
               error (str): The error message when user tries to assign to dict.
               """
    4:         super().__init__(*args, **kwargs)
    4:         self.error = error
       
    1:     def __setitem__(self, key, value):
               raise NotImplementedError(self.error)
       
    1:     def pop(self, key, default=None):
               raise NotImplementedError(self.error)
       
    1:     def update(self, other):
               raise NotImplementedError(self.error)
       
       
    2: class SimpleFrozenList(list):
    1:     """Wrapper class around a list that lets us raise custom errors if certain
           attributes/methods are accessed. Mostly used for properties like
           Language.pipeline that return an immutable list (and that we don't want to
           convert to a tuple to not break too much backwards compatibility). If a user
           accidentally calls nlp.pipeline.append(), we can raise a more helpful error.
           """
       
    1:     def __init__(self, *args, error: str = Errors.E002) -> None:
               """Initialize the frozen list.
       
               error (str): The error message when user tries to mutate the list.
               """
    1:         self.error = error
    1:         super().__init__(*args)
       
    1:     def append(self, *args, **kwargs):
               raise NotImplementedError(self.error)
       
    1:     def clear(self, *args, **kwargs):
               raise NotImplementedError(self.error)
       
    1:     def extend(self, *args, **kwargs):
               raise NotImplementedError(self.error)
       
    1:     def insert(self, *args, **kwargs):
               raise NotImplementedError(self.error)
       
    1:     def pop(self, *args, **kwargs):
               raise NotImplementedError(self.error)
       
    1:     def remove(self, *args, **kwargs):
               raise NotImplementedError(self.error)
       
    1:     def reverse(self, *args, **kwargs):
               raise NotImplementedError(self.error)
       
    1:     def sort(self, *args, **kwargs):
               raise NotImplementedError(self.error)
