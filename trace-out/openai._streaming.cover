               if fieldname == "event":
                   self._event = value
               elif fieldname == "data":
                   self._data.append(value)
               elif fieldname == "id":
                   if "\0" in value:
                       pass
                   else:
                       self._last_event_id = value
               elif fieldname == "retry":
                   try:
                       self._retry = int(value)
                   except (TypeError, ValueError):
                       pass
               else:
                   pass  # Field is ignored.
       
               return None
       
       
