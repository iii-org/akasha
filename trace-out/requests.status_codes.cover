    1: def _init():
   69:     for code, titles in _codes.items():
  194:         for title in titles:
  126:             setattr(codes, title, code)
  126:             if not title.startswith(("\\", "/")):
  123:                 setattr(codes, title.upper(), code)
       
    1:     def doc(code: int) -> str:
  262:         names = ", ".join(f"``{n}``" for n in _codes[code])
   68:         return "* %d: %s" % (code, names)
       
