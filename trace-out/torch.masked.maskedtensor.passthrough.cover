    1: """
       These are functions that should simply be applied to both mask and data.
       Take select or stack as an example. This operation can be applied to
       both the mask and data of a MaskedTensor and the result wrapped into
       a new MaskedTensor as a result.
       """
       
    1: import torch
       
    1: from .core import _map_mt_args_kwargs, _wrap_result
       
       
    1: __all__ = []  # type: ignore[var-annotated]
       
       
    1: PASSTHROUGH_FNS = [
    1:     torch.ops.aten.select,
    1:     torch.ops.aten.transpose,
    1:     torch.ops.aten.split,
    1:     torch.ops.aten.t,
    1:     torch.ops.aten.slice,
    1:     torch.ops.aten.slice_backward,
    1:     torch.ops.aten.select_backward,
    1:     torch.ops.aten.index,
    1:     torch.ops.aten.expand,
    1:     torch.ops.aten.view,
    1:     torch.ops.aten._unsafe_view,
    1:     torch.ops.aten._reshape_alias,
    1:     torch.ops.aten.cat,
    1:     torch.ops.aten.unsqueeze,
    1:     torch.ops.aten.unfold,
    1:     torch.ops.aten.unfold_backward,
    1:     torch.ops.aten.im2col,
    1:     torch.ops.aten.col2im,
    1:     torch.ops.aten.stack,
       ]
       
       
    1: def _is_pass_through_fn(fn):
           return fn in PASSTHROUGH_FNS
       
       
    1: def _apply_pass_through_fn(fn, *args, **kwargs):
           data_args, data_kwargs = _map_mt_args_kwargs(args, kwargs, lambda x: x.get_data())
           result_data = fn(*data_args, **data_kwargs)
           mask_args, mask_kwargs = _map_mt_args_kwargs(args, kwargs, lambda x: x.get_mask())
           result_mask = fn(*mask_args, **mask_kwargs)
           return _wrap_result(result_data, result_mask)
