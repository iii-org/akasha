    1: """Typing helpers shared across the Transformers library."""
       
    1: from __future__ import annotations
       
    1: import logging
    1: from collections.abc import Mapping, MutableMapping
    1: from os import PathLike
    1: from typing import TYPE_CHECKING, Any, Protocol, TypeAlias
       
       
    1: if TYPE_CHECKING:
           import torch
       
           from .cache_utils import Cache
       
       
       # A few helpful type aliases
    1: Level: TypeAlias = int
    1: ExcInfo: TypeAlias = (
    4:     None
    1:     | bool
    1:     | BaseException
    1:     | tuple[type[BaseException], BaseException, object]  # traceback is `types.TracebackType`, but keep generic here
       )
    1: DeviceMeshLike: TypeAlias = Any  # PyTorch stubs do not model torch.distributed.device_mesh consistently yet.
       
       
    2: class TransformersLogger(Protocol):
           # ---- Core Logger identity / configuration ----
    1:     name: str
    1:     level: int
    1:     parent: logging.Logger | None
    1:     propagate: bool
    1:     disabled: bool
    1:     handlers: list[logging.Handler]
       
           # Exists on Logger; default is True. (Not heavily used, but is part of API.)
    1:     raiseExceptions: bool
       
           # ---- Standard methods ----
    1:     def setLevel(self, level: Level) -> None: ...
    1:     def isEnabledFor(self, level: Level) -> bool: ...
    1:     def getEffectiveLevel(self) -> int: ...
       
    1:     def getChild(self, suffix: str) -> logging.Logger: ...
       
    1:     def addHandler(self, hdlr: logging.Handler) -> None: ...
    1:     def removeHandler(self, hdlr: logging.Handler) -> None: ...
    1:     def hasHandlers(self) -> bool: ...
       
           # ---- Logging calls ----
    1:     def debug(self, msg: object, *args: object, **kwargs: object) -> None: ...
    1:     def info(self, msg: object, *args: object, **kwargs: object) -> None: ...
    1:     def warning(self, msg: object, *args: object, **kwargs: object) -> None: ...
    1:     def warn(self, msg: object, *args: object, **kwargs: object) -> None: ...
    1:     def error(self, msg: object, *args: object, **kwargs: object) -> None: ...
    1:     def exception(self, msg: object, *args: object, exc_info: ExcInfo = True, **kwargs: object) -> None: ...
    1:     def critical(self, msg: object, *args: object, **kwargs: object) -> None: ...
    1:     def fatal(self, msg: object, *args: object, **kwargs: object) -> None: ...
       
           # The lowest-level primitive
    1:     def log(self, level: Level, msg: object, *args: object, **kwargs: object) -> None: ...
       
           # ---- Record-level / formatting ----
    1:     def makeRecord(
               self,
               name: str,
               level: Level,
               fn: str,
               lno: int,
               msg: object,
               args: tuple[object, ...] | Mapping[str, object],
               exc_info: ExcInfo,
    1:         func: str | None = None,
    1:         extra: Mapping[str, object] | None = None,
    1:         sinfo: str | None = None,
           ) -> logging.LogRecord: ...
       
    1:     def handle(self, record: logging.LogRecord) -> None: ...
    1:     def findCaller(
               self,
    1:         stack_info: bool = False,
    1:         stacklevel: int = 1,
           ) -> tuple[str, int, str, str | None]: ...
       
    1:     def callHandlers(self, record: logging.LogRecord) -> None: ...
    1:     def getMessage(self) -> str: ...  # NOTE: actually on LogRecord; included rarely; safe to omit if you want
       
    1:     def _log(
               self,
               level: Level,
               msg: object,
               args: tuple[object, ...] | Mapping[str, object],
    1:         exc_info: ExcInfo = None,
    1:         extra: Mapping[str, object] | None = None,
    1:         stack_info: bool = False,
    1:         stacklevel: int = 1,
           ) -> None: ...
       
           # ---- Filters ----
    1:     def addFilter(self, filt: logging.Filter) -> None: ...
    1:     def removeFilter(self, filt: logging.Filter) -> None: ...
    2:     @property
    2:     def filters(self) -> list[logging.Filter]: ...
       
    1:     def filter(self, record: logging.LogRecord) -> bool: ...
       
           # ---- Convenience helpers ----
    1:     def setFormatter(self, fmt: logging.Formatter) -> None: ...  # mostly on handlers; present on adapters sometimes
    1:     def debugStack(self, msg: object, *args: object, **kwargs: object) -> None: ...  # not std; safe no-op if absent
       
           # ---- stdlib dictConfig-friendly / extra storage ----
           # Logger has `manager` and can have arbitrary attributes; Protocol can't express arbitrary attrs,
           # but we can at least include `__dict__` to make "extra attributes" less painful.
    1:     __dict__: MutableMapping[str, Any]
       
           # ---- Transformers logger specific methods ----
    1:     def warning_advice(self, msg: object, *args: object, **kwargs: object) -> None: ...
    1:     def warning_once(self, msg: object, *args: object, **kwargs: object) -> None: ...
    1:     def info_once(self, msg: object, *args: object, **kwargs: object) -> None: ...
       
       
    2: class GenerativePreTrainedModel(Protocol):
    1:     """Protocol for the model interface that GenerationMixin expects.
       
           GenerationMixin is designed to be mixed into PreTrainedModel subclasses. This Protocol documents the
           attributes and methods the mixin relies on from its host class. It is *not* used at runtime — its
           purpose is to help the ``ty`` type checker resolve ``self.<attr>`` accesses inside the mixin.
           """
       
    1:     config: Any  # PretrainedConfig — kept as Any to avoid circular imports
    1:     device: torch.device
    1:     dtype: torch.dtype
    1:     main_input_name: str
    1:     base_model_prefix: str
    1:     _is_stateful: bool
    1:     hf_quantizer: Any
    1:     encoder: Any
    1:     hf_device_map: dict[str, Any]
    1:     _cache: Cache
       
    1:     generation_config: Any  # GenerationConfig
       
    1:     def __getattr__(self, name: str) -> Any: ...
    1:     def forward(self, *args: Any, **kwargs: Any) -> Any: ...
    1:     def __call__(self, *args: Any, **kwargs: Any) -> Any: ...
    1:     def can_generate(self) -> bool: ...
    1:     def get_encoder(self) -> Any: ...
    1:     def get_output_embeddings(self) -> Any: ...
    1:     def get_input_embeddings(self) -> Any: ...
    1:     def set_output_embeddings(self, value: Any) -> None: ...
    1:     def set_input_embeddings(self, value: Any) -> None: ...
    1:     def get_compiled_call(self, compile_config: Any) -> Any: ...
    1:     def set_experts_implementation(self, *args: Any, **kwargs: Any) -> Any: ...
    1:     def _supports_logits_to_keep(self) -> bool: ...
       
       
    2: class StringValuedEnumLike(Protocol):
    1:     value: str
       
       
    2: class PeftConfigLike(Protocol):
    1:     peft_type: StringValuedEnumLike
    1:     is_prompt_learning: bool
    1:     base_model_name_or_path: str | PathLike[str] | None
    1:     inference_mode: bool
       
    1:     def save_pretrained(self, save_directory: str | PathLike[str], **kwargs: Any) -> None: ...
       
       
    2: class WhisperGenerationConfigLike(Protocol):
    1:     """Protocol for Whisper-specific generation config fields accessed in generation internals."""
       
    1:     no_timestamps_token_id: int
