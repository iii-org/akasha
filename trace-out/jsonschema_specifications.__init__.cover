    1: """
       The JSON Schema meta-schemas and vocabularies, exposed as a Registry.
       """
       
    1: from referencing.jsonschema import EMPTY_REGISTRY as _EMPTY_REGISTRY
       
    1: from jsonschema_specifications._core import _schemas
       
       #: A `referencing.jsonschema.SchemaRegistry` containing all of the official
       #: meta-schemas and vocabularies.
    1: REGISTRY = (_schemas() @ _EMPTY_REGISTRY).crawl()
    1: __all__ = ["REGISTRY"]
