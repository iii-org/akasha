    1: from __future__ import annotations
       
    1: from typing import Callable, Protocol, Awaitable
    1: from weakref import WeakKeyDictionary
    1: from dataclasses import dataclass
       
    1: import httpx
       
    1: from ._models import FinalRequestOptions
    1: from ._exceptions import OpenAIError
       
       
    2: class _Provider:
    1:     """Opaque configuration returned by an OpenAI-owned provider factory."""
       
    1:     __slots__ = ("__weakref__",)
       
       
    3: @dataclass
    2: class _ProviderRuntime:
    1:     name: str
    1:     base_url: str | httpx.URL
    1:     transform_request: Callable[[FinalRequestOptions], FinalRequestOptions] | None = None
    1:     transform_async_request: Callable[[FinalRequestOptions], Awaitable[FinalRequestOptions]] | None = None
    1:     prepare_request: Callable[[httpx.Request], None] | None = None
    1:     prepare_async_request: Callable[[httpx.Request], Awaitable[None]] | None = None
    1:     normalize_response: Callable[[httpx.Response], httpx.Response] | None = None
    1:     normalize_async_response: Callable[[httpx.Response], Awaitable[httpx.Response]] | None = None
       
       
    2: class _ProviderDefinition(Protocol):
    2:     @property
    2:     def name(self) -> str: ...
       
    1:     def configure(self) -> _ProviderRuntime: ...
       
       
       # Provider factories capture configuration in definitions, while every client
       # gets fresh runtime state from ``definition.configure()``. Keeping definitions
       # outside the opaque provider object prevents arbitrary objects (including a
       # directly constructed ``_Provider``) from imitating an OpenAI-owned provider
       # and keeps credentials out of the object's representation. The weak mapping
       # also avoids retaining provider configuration after the public handle is gone.
    1: _provider_definitions: WeakKeyDictionary[_Provider, _ProviderDefinition] = WeakKeyDictionary()
       
       
    1: def _create_provider(definition: _ProviderDefinition) -> _Provider:  # pyright: ignore[reportUnusedFunction]
           provider = _Provider()
           _provider_definitions[provider] = definition
           return provider
       
       
    1: def _provider_name(provider: _Provider) -> str:  # pyright: ignore[reportUnusedFunction]
           return _get_provider_definition(provider).name
       
       
    1: def _configure_provider(provider: _Provider) -> _ProviderRuntime:  # pyright: ignore[reportUnusedFunction]
           return _get_provider_definition(provider).configure()
       
       
    1: def _get_provider_definition(provider: _Provider) -> _ProviderDefinition:
           try:
               return _provider_definitions[provider]
           except (KeyError, TypeError) as exc:
               raise OpenAIError("Invalid provider. Providers must be created by an OpenAI provider factory.") from exc
