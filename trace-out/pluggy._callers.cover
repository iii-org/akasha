    1: """
       Call loop machinery
       """
       
    1: from __future__ import annotations
       
    1: from collections.abc import Generator
    1: from collections.abc import Mapping
    1: from collections.abc import Sequence
    1: from typing import cast
    1: from typing import NoReturn
    1: import warnings
       
    1: from ._hooks import HookImpl
    1: from ._result import HookCallError
    1: from ._result import Result
    1: from ._warnings import PluggyTeardownRaisedWarning
       
       
       # Need to distinguish between old- and new-style hook wrappers.
       # Wrapping with a tuple is the fastest type-safe way I found to do it.
    1: Teardown = Generator[None, object, object]
       
       
    1: def run_old_style_hookwrapper(
           hook_impl: HookImpl, hook_name: str, args: Sequence[object]
       ) -> Teardown:
           """
           backward compatibility wrapper to run a old style hookwrapper as a wrapper
           """
       
           teardown: Teardown = cast(Teardown, hook_impl.function(*args))
           try:
               next(teardown)
           except StopIteration:
               _raise_wrapfail(teardown, "did not yield")
           try:
               res = yield
               result = Result(res, None)
           except BaseException as exc:
               result = Result(None, exc)
           try:
               teardown.send(result)
           except StopIteration:
               pass
           except BaseException as e:
               _warn_teardown_exception(hook_name, hook_impl, e)
               raise
           else:
               _raise_wrapfail(teardown, "has second yield")
           finally:
               teardown.close()
           return result.get_result()
       
       
    1: def _raise_wrapfail(
           wrap_controller: Generator[None, object, object],
           msg: str,
       ) -> NoReturn:
           co = wrap_controller.gi_code  # type: ignore[attr-defined]
           raise RuntimeError(
               f"wrap_controller at {co.co_name!r} {co.co_filename}:{co.co_firstlineno} {msg}"
           )
       
       
    1: def _warn_teardown_exception(
           hook_name: str, hook_impl: HookImpl, e: BaseException
       ) -> None:
           msg = "A plugin raised an exception during an old-style hookwrapper teardown.\n"
           msg += f"Plugin: {hook_impl.plugin_name}, Hook: {hook_name}\n"
           msg += f"{type(e).__name__}: {e}\n"
           msg += "For more information see https://pluggy.readthedocs.io/en/stable/api_reference.html#pluggy.PluggyTeardownRaisedWarning"  # noqa: E501
           warnings.warn(PluggyTeardownRaisedWarning(msg), stacklevel=6)
       
       
    1: def _multicall(
           hook_name: str,
           hook_impls: Sequence[HookImpl],
           caller_kwargs: Mapping[str, object],
           firstresult: bool,
       ) -> object | list[object]:
           """Execute a call into multiple python functions/methods and return the
           result(s).
       
           ``caller_kwargs`` comes from HookCaller.__call__().
           """
  433:     __tracebackhide__ = True
  433:     results: list[object] = []
  433:     exception = None
  433:     try:  # run impl and wrapper setup functions in a loop
  433:         teardowns: list[Teardown] = []
  433:         try:
 1169:             for hook_impl in reversed(hook_impls):
  835:                 try:
 2900:                     args = [caller_kwargs[argname] for argname in hook_impl.argnames]
                       except KeyError as e:
                           # coverage bug - this is tested
                           for argname in hook_impl.argnames:  # pragma: no cover
                               if argname not in caller_kwargs:
                                   raise HookCallError(
                                       f"hook call must provide argument {argname!r}"
                                   ) from e
       
  835:                 if hook_impl.hookwrapper:
                           function_gen = run_old_style_hookwrapper(hook_impl, hook_name, args)
       
                           next(function_gen)  # first yield
                           teardowns.append(function_gen)
       
  835:                 elif hook_impl.wrapper:
  128:                     try:
                               # If this cast is not valid, a type error is raised below,
                               # which is the desired response.
  128:                         res = hook_impl.function(*args)
  128:                         function_gen = cast(Generator[None, object, object], res)
  128:                         next(function_gen)  # first yield
  128:                         teardowns.append(function_gen)
                           except StopIteration:
                               _raise_wrapfail(function_gen, "did not yield")
                       else:
  707:                     res = hook_impl.function(*args)
  707:                     if res is not None:
  120:                         results.append(res)
  120:                         if firstresult:  # halt further impl calls
   99:                             break
               except BaseException as exc:
                   exception = exc
           finally:
  433:         if firstresult:  # first result hooks return a single value
  161:             result = results[0] if results else None
               else:
  272:             result = results
       
               # run all wrapper post-yield blocks
  561:         for teardown in reversed(teardowns):
  128:             try:
  128:                 if exception is not None:
                           try:
                               teardown.throw(exception)
                           except RuntimeError as re:
                               # StopIteration from generator causes RuntimeError
                               # even for coroutine usage - see #544
                               if (
                                   isinstance(exception, StopIteration)
                                   and re.__cause__ is exception
                               ):
                                   teardown.close()
                                   continue
                               else:
                                   raise
                       else:
  128:                     teardown.send(result)
                       # Following is unreachable for a well behaved hook wrapper.
                       # Try to force finalizers otherwise postponed till GC action.
                       # Note: close() may raise if generator handles GeneratorExit.
                       teardown.close()
  128:             except StopIteration as si:
  128:                 result = si.value
  128:                 exception = None
  128:                 continue
                   except BaseException as e:
                       exception = e
                       continue
                   _raise_wrapfail(teardown, "has second yield")
       
  433:     if exception is not None:
               raise exception
           else:
  433:         return result
