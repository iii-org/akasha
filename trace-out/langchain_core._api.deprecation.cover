                   if removal:
                       message += f" and will be removed {removal}"
       
               if alternative_import:
                   alt_package = alternative_import.split(".", maxsplit=1)[0].replace("_", "-")
                   if alt_package == package_:
                       message += f". Use {alternative_import} instead."
                   else:
