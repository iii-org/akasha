           if not pending and removal:
               removal = f"in {removal}"
       
           if not message:
               message = ""
               package_ = (
                   package or name.split(".", maxsplit=1)[0].replace("_", "-")
                   if "." in name
                   else "LangChain"
               )
       
               if obj_type:
                   message += f"The {obj_type} `{name}`"
               else:
                   message += f"`{name}`"
       
               if pending:
