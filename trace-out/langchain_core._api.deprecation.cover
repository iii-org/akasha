                       message += (
                           f". An updated version of the {obj_type} exists in the "
                           f"{alt_package} package and should be used instead. To use it run "
                           f"`pip install -U {alt_package}` and import as "
                           f"`from {alt_module} import {alt_name}`."
                       )
