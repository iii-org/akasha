    1: """Helpers for Python and platform compatibility."""
       
    1: import sys
       
    1: from thinc.util import copy_array
       
    1: try:
    1:     import cPickle as pickle
    1: except ImportError:
    1:     import pickle  # type: ignore[no-redef]
       
    1: try:
    1:     import copy_reg
    1: except ImportError:
    1:     import copyreg as copy_reg  # type: ignore[no-redef]
       
    1: try:
    1:     from cupy.cuda.stream import Stream as CudaStream
    1: except ImportError:
    1:     CudaStream = None
       
    1: try:
    1:     import cupy
    1: except ImportError:
    1:     cupy = None
       
    1: if sys.version_info[:2] >= (3, 8):  # Python 3.8+
    1:     from typing import Literal, Protocol, runtime_checkable
       else:
           from typing_extensions import Literal, Protocol, runtime_checkable  # noqa: F401
       
       # Important note: The importlib_metadata "backport" includes functionality
       # that's not part of the built-in importlib.metadata. We should treat this
       # import like the built-in and only use what's available there.
    1: try:  # Python 3.8+
    1:     import importlib.metadata as importlib_metadata
       except ImportError:
           from catalogue import (  # type: ignore[no-redef]
               _importlib_metadata as importlib_metadata,  # noqa: F401
           )
       
    1: from thinc.api import Optimizer  # noqa: F401
       
    1: pickle = pickle
    1: copy_reg = copy_reg
    1: CudaStream = CudaStream
    1: cupy = cupy
    1: copy_array = copy_array
       
    1: is_windows = sys.platform.startswith("win")
    1: is_linux = sys.platform.startswith("linux")
    1: is_osx = sys.platform == "darwin"
