    1:     name: str
    1:     """The name of the tool to be called."""
       
    1:     args: dict[str, Any]
    1:     """The arguments to the tool call."""
       
    1:     index: NotRequired[int | str]
    1:     """Index of block in aggregate response. Used during streaming."""
       
    1:     extras: NotRequired[dict[str, Any]]
    1:     """Provider-specific metadata."""
       
       
