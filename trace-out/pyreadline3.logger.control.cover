    1: import os
    1: from logging import FileHandler, Formatter, StreamHandler
    1: from logging.handlers import DEFAULT_TCP_LOGGING_PORT
    1: from typing import Optional
       
    1: from .logger import LOGGER
    1: from .socket_stream import SocketStream
       
    1: _default_formatter_str = os.environ.get("PYREADLINE_FORMATTER", "%(message)s")
       
    1: SOCKET_HANDLER: Optional["StreamHandler[SocketStream]"] = None
    1: FILE_HANDLER: Optional[FileHandler] = None
       
       
    5: def start_socket_log(
    2:     host: str = "localhost",
    2:     port: int = DEFAULT_TCP_LOGGING_PORT,
    2:     formatter_str: str = _default_formatter_str,
    1: ) -> None:
           global SOCKET_HANDLER
       
           if SOCKET_HANDLER is not None:
               return
       
           SOCKET_HANDLER = StreamHandler(SocketStream(host, port))
           SOCKET_HANDLER.setFormatter(Formatter(formatter_str))
       
           LOGGER.addHandler(SOCKET_HANDLER)
       
       
    1: def stop_socket_log() -> None:
           global SOCKET_HANDLER
       
           if SOCKET_HANDLER is None:
               return
       
           LOGGER.removeHandler(SOCKET_HANDLER)
       
           SOCKET_HANDLER = None
       
       
    1: def start_file_log(filename: str) -> None:
           global FILE_HANDLER
       
           if FILE_HANDLER is not None:
               return
       
           FILE_HANDLER = FileHandler(filename, "w")
           LOGGER.addHandler(FILE_HANDLER)
       
       
    1: def stop_file_log() -> None:
           global FILE_HANDLER
       
           if FILE_HANDLER is None:
               return
       
           LOGGER.removeHandler(FILE_HANDLER)
       
           FILE_HANDLER.close()
           FILE_HANDLER = None
       
       
    1: def stop_logging() -> None:
           stop_file_log()
           stop_socket_log()
