    1: def convert_to_secret_str(value: SecretStr | str) -> SecretStr:
           """Convert a string to a `SecretStr` if needed.
       
           Args:
               value: The value to convert.
       
           Returns:
               The `SecretStr` value.
           """
           if isinstance(value, SecretStr):
               return value
           return SecretStr(value)
       
       
