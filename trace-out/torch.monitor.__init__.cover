    1: from typing import TYPE_CHECKING
       
    1: from torch._C._monitor import *  # noqa: F403
    1: from torch._C._monitor import _WaitCounter, _WaitCounterTracker
       
       
    1: if TYPE_CHECKING:
           from torch.utils.tensorboard import SummaryWriter
       
    1: STAT_EVENT = "torch.monitor.Stat"
       
       
    2: class TensorboardEventHandler:
    1:     """
           TensorboardEventHandler is an event handler that will write known events to
           the provided SummaryWriter.
       
           This currently only supports ``torch.monitor.Stat`` events which are logged
           as scalars.
       
           Example:
               >>> # xdoctest: +REQUIRES(env:TORCH_DOCTEST_MONITOR)
               >>> # xdoctest: +REQUIRES(module:tensorboard)
               >>> from torch.utils.tensorboard import SummaryWriter
               >>> from torch.monitor import TensorboardEventHandler, register_event_handler
               >>> writer = SummaryWriter("log_dir")
               >>> register_event_handler(TensorboardEventHandler(writer))
           """
       
    1:     def __init__(self, writer: "SummaryWriter") -> None:
               """
               Constructs the ``TensorboardEventHandler``.
               """
               self._writer = writer
       
    1:     def __call__(self, event: Event) -> None:
               if event.name == STAT_EVENT:
                   for k, v in event.data.items():
                       self._writer.add_scalar(k, v, walltime=event.timestamp.timestamp())
