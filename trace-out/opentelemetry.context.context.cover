    1: from __future__ import annotations
       
    1: from abc import ABC, abstractmethod
    1: from contextvars import Token
       
       
    2: class Context(dict[str, object]):
    1:     def __setitem__(self, key: str, value: object) -> None:
               raise ValueError
       
       
    2: class _RuntimeContext(ABC):
    1:     """The RuntimeContext interface provides a wrapper for the different
           mechanisms that are used to propagate context in Python.
           Implementations can be made available via entry_points and
           selected through environment variables.
           """
       
    2:     @abstractmethod
    2:     def attach(self, context: Context) -> Token[Context]:
               """Sets the current `Context` object. Returns a
               token that can be used to reset to the previous `Context`.
       
               Args:
                   context: The Context to set.
               """
       
    2:     @abstractmethod
    2:     def get_current(self) -> Context:
               """Returns the current `Context` object."""
       
    2:     @abstractmethod
    2:     def detach(self, token: Token[Context]) -> None:
               """Resets Context to a previous value
       
               Args:
                   token: A reference to a previous Context.
               """
       
       
    1: __all__ = ["Context"]
