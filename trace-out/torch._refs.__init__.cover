               + "weight of shape "
               + str(weight.shape)  # type: ignore[union-attr]
               + " and normalized_shape = "
               + str(normalized_shape),
           )
           torch._check(
               # pyrefly: ignore [bad-argument-type]
               bias is None or sym_eq(bias.shape, tuple(normalized_shape)),
