    2: @register_decomposition(aten.dot)
    2: @out_wrapper(exact_dtype=True)
    2: @_dot_check_wrapper
    3: @elementwise_type_promotion_wrapper(
    1:     type_promoting_args=("self", "other"),
    1:     type_promotion_kind=ELEMENTWISE_TYPE_PROMOTION_KIND.DEFAULT,
       )
    2: def dot(self, other):
           if self.is_complex():
               if self.is_conj():
                   if other.is_conj():
                       return torch.dot(self.conj(), other.conj()).conj()
                   else:
                       return torch.vdot(self.conj(), other)
               elif other.is_conj():
                   return torch.vdot(other.conj(), self)
       
           return (self * other).sum()
       
       
    2: @register_decomposition(aten.vdot)
    2: @out_wrapper(exact_dtype=True)
