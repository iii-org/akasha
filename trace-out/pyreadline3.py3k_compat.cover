    1: import sys
    1: from collections.abc import Callable
    1: from typing import Any, Dict, Optional
       
    1: is_ironpython = "IronPython" in sys.version
       
       
    1: def is_callable(x: Any) -> bool:
  203:     return isinstance(x, Callable)
       
       
    5: def execfile(
    1:     fname: str,
    1:     glob: Dict[str, Any],
    2:     loc: Optional[Dict[str, Any]] = None,
    1: ) -> None:
           loc = loc if (loc is not None) else glob
       
           with open(
               fname,
               "r",
               encoding="utf-8",
           ) as file:
               file_contents = file.read()
       
           # pylint: disable=W0122
           exec(
               compile(
                   file_contents,
                   fname,
                   "exec",
               ),
               glob,
               loc,
           )
