    2: class Jpeg(Type):
    1:     """
           Implements the JPEG image type matcher.
           """
    1:     MIME = 'image/jpeg'
    1:     EXTENSION = 'jpg'
       
    1:     def __init__(self):
    2:         super(Jpeg, self).__init__(
    1:             mime=Jpeg.MIME,
    1:             extension=Jpeg.EXTENSION
               )
       
    1:     def match(self, buf):
               return (len(buf) > 2 and
                       buf[0] == 0xFF and
                       buf[1] == 0xD8 and
                       buf[2] == 0xFF)
       
       
    2: class Jpx(Type):
    1:     """
           Implements the JPEG2000 image type matcher.
           """
       
    1:     MIME = "image/jpx"
    1:     EXTENSION = "jpx"
       
    1:     def __init__(self):
    1:         super(Jpx, self).__init__(mime=Jpx.MIME, extension=Jpx.EXTENSION)
       
    1:     def match(self, buf):
               return (
                   len(buf) > 50
                   and buf[0] == 0x00
                   and buf[1] == 0x00
                   and buf[2] == 0x00
                   and buf[3] == 0x0C
                   and buf[16:24] == b"ftypjp2 "
               )
       
       
    2: class Apng(Type):
    1:     """
           Implements the APNG image type matcher.
           """
    1:     MIME = 'image/apng'
    1:     EXTENSION = 'apng'
       
    1:     def __init__(self):
    2:         super(Apng, self).__init__(
    1:             mime=Apng.MIME,
    1:             extension=Apng.EXTENSION
               )
       
    1:     def match(self, buf):
               if (len(buf) > 8 and
                  buf[:8] == bytearray([0x89, 0x50, 0x4e, 0x47,
                                        0x0d, 0x0a, 0x1a, 0x0a])):
                   # cursor in buf, skip already readed 8 bytes
                   i = 8
                   while len(buf) > i:
                       data_length = int.from_bytes(buf[i:i+4], byteorder="big")
                       i += 4
       
                       chunk_type = buf[i:i+4].decode("ascii", errors='ignore')
                       i += 4
       
                       # acTL chunk in APNG should appears first than IDAT
                       # IEND is end of PNG
                       if (chunk_type == "IDAT" or chunk_type == "IEND"):
                           return False
                       elif (chunk_type == "acTL"):
                           return True
       
                       # move to the next chunk by skipping data and crc (4 bytes)
                       i += data_length + 4
       
               return False
       
       
