    2: class Heic(IsoBmff):
    1:     """
           Implements the HEIC image type matcher.
           """
    1:     MIME = 'image/heic'
    1:     EXTENSION = 'heic'
       
    1:     def __init__(self):
    2:         super(Heic, self).__init__(
    1:             mime=Heic.MIME,
    1:             extension=Heic.EXTENSION
               )
       
    1:     def match(self, buf):
               if not self._is_isobmff(buf):
                   return False
       
               major_brand, minor_version, compatible_brands = self._get_ftyp(buf)
               if major_brand == 'heic':
                   return True
               if major_brand in ['mif1', 'msf1'] and 'heic' in compatible_brands:
                   return True
               return False
       
       
    2: class Dcm(Type):
       
    1:     MIME = 'application/dicom'
    1:     EXTENSION = 'dcm'
    1:     OFFSET = 128
       
    1:     def __init__(self):
    2:         super(Dcm, self).__init__(
    1:             mime=Dcm.MIME,
    1:             extension=Dcm.EXTENSION
               )
       
    1:     def match(self, buf):
               return (len(buf) > Dcm.OFFSET + 4 and
                       buf[Dcm.OFFSET + 0] == 0x44 and
                       buf[Dcm.OFFSET + 1] == 0x49 and
                       buf[Dcm.OFFSET + 2] == 0x43 and
                       buf[Dcm.OFFSET + 3] == 0x4D)
       
       
