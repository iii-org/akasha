                       buf[12] == 0x56 and
                       buf[13] == 0x50)
       
       
    2: class Cr2(Type):
    1:     """
           Implements the CR2 image type matcher.
           """
    1:     MIME = 'image/x-canon-cr2'
    1:     EXTENSION = 'cr2'
       
    1:     def __init__(self):
    2:         super(Cr2, self).__init__(
    1:             mime=Cr2.MIME,
    1:             extension=Cr2.EXTENSION,
               )
       
    1:     def match(self, buf):
               return (len(buf) > 9 and
                       ((buf[0] == 0x49 and buf[1] == 0x49 and
                           buf[2] == 0x2A and buf[3] == 0x0) or
                       (buf[0] == 0x4D and buf[1] == 0x4D and
                           buf[2] == 0x0 and buf[3] == 0x2A)) and
                       buf[8] == 0x43 and buf[9] == 0x52)
       
       
    2: class Tiff(Type):
    1:     """
           Implements the TIFF image type matcher.
           """
    1:     MIME = 'image/tiff'
    1:     EXTENSION = 'tif'
       
    1:     def __init__(self):
    2:         super(Tiff, self).__init__(
    1:             mime=Tiff.MIME,
    1:             extension=Tiff.EXTENSION,
               )
       
    1:     def match(self, buf):
               return (len(buf) > 9 and
                       ((buf[0] == 0x49 and buf[1] == 0x49 and
                           buf[2] == 0x2A and buf[3] == 0x0) or
                       (buf[0] == 0x4D and buf[1] == 0x4D and
                           buf[2] == 0x0 and buf[3] == 0x2A))
                       and not (buf[8] == 0x43 and buf[9] == 0x52))
       
       
