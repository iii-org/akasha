    1: from ..char_classes import (
           ALPHA,
           ALPHA_LOWER,
           ALPHA_UPPER,
           CONCAT_QUOTES,
           HYPHENS,
           LIST_ELLIPSES,
           LIST_ICONS,
       )
       
    1: _infixes = (
    3:     LIST_ELLIPSES
    1:     + LIST_ICONS
    1:     + [
    1:         r"(?<=[0-9])[+\-\*^](?=[0-9-])",
    2:         r"(?<=[{al}{q}])\.(?=[{au}{q}])".format(
    1:             al=ALPHA_LOWER, au=ALPHA_UPPER, q=CONCAT_QUOTES
               ),
    1:         r"(?<=[{a}]),(?=[{a}])".format(a=ALPHA),
    1:         r"(?<=[{a}0-9])(?:{h})(?=[{a}])".format(a=ALPHA, h=HYPHENS),
    1:         r"(?<=[{a}0-9])[:<>=/](?=[{a}])".format(a=ALPHA),
           ]
       )
       
       
    1: TOKENIZER_INFIXES = _infixes
