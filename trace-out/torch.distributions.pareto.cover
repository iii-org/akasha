    1: from typing import Optional, Union
       
    1: from torch import Tensor
    1: from torch.distributions import constraints
    1: from torch.distributions.exponential import Exponential
    1: from torch.distributions.transformed_distribution import TransformedDistribution
    1: from torch.distributions.transforms import AffineTransform, ExpTransform
    1: from torch.distributions.utils import broadcast_all
    1: from torch.types import _size
       
       
    1: __all__ = ["Pareto"]
       
       
    2: class Pareto(TransformedDistribution):
    1:     r"""
           Samples from a Pareto Type 1 distribution.
       
           Example::
       
               >>> # xdoctest: +IGNORE_WANT("non-deterministic")
               >>> m = Pareto(torch.tensor([1.0]), torch.tensor([1.0]))
               >>> m.sample()  # sample from a Pareto distribution with scale=1 and alpha=1
               tensor([ 1.5623])
       
           Args:
               scale (float or Tensor): Scale parameter of the distribution
               alpha (float or Tensor): Shape parameter of the distribution
           """
       
    1:     arg_constraints = {"alpha": constraints.positive, "scale": constraints.positive}
       
    5:     def __init__(
               self,
    1:         scale: Union[Tensor, float],
    1:         alpha: Union[Tensor, float],
    2:         validate_args: Optional[bool] = None,
    1:     ) -> None:
               self.scale, self.alpha = broadcast_all(scale, alpha)
               base_dist = Exponential(self.alpha, validate_args=validate_args)
               transforms = [ExpTransform(), AffineTransform(loc=0, scale=self.scale)]
               # pyrefly: ignore [bad-argument-type]
               super().__init__(base_dist, transforms, validate_args=validate_args)
       
    4:     def expand(
    3:         self, batch_shape: _size, _instance: Optional["Pareto"] = None
    1:     ) -> "Pareto":
               new = self._get_checked_instance(Pareto, _instance)
               new.scale = self.scale.expand(batch_shape)
               new.alpha = self.alpha.expand(batch_shape)
               return super().expand(batch_shape, _instance=new)
       
    2:     @property
    2:     def mean(self) -> Tensor:
               # mean is inf for alpha <= 1
               a = self.alpha.clamp(min=1)
               return a * self.scale / (a - 1)
       
    2:     @property
    2:     def mode(self) -> Tensor:
               return self.scale
       
    2:     @property
    2:     def variance(self) -> Tensor:
               # var is inf for alpha <= 2
               a = self.alpha.clamp(min=2)
               return self.scale.pow(2) * a / ((a - 1).pow(2) * (a - 2))
       
    2:     @constraints.dependent_property(is_discrete=False, event_dim=0)
    2:     def support(self) -> constraints.Constraint:
               return constraints.greater_than_eq(self.scale)
       
    1:     def entropy(self) -> Tensor:
               return (self.scale / self.alpha).log() + (1 + self.alpha.reciprocal())
