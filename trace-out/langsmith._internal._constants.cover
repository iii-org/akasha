    1: import uuid
       
    1: _MIN_BACKEND_VERSION = "0.16.9rc1"
       
    1: _SIZE_LIMIT_BYTES = 20_971_520  # 20MB by default
    1: _AUTO_SCALE_UP_QSIZE_TRIGGER = 200
