    1: """**Load** module helps with serialization and deserialization."""
       
    1: from typing import TYPE_CHECKING
       
    1: from langchain_core._import_utils import import_attr
       
    1: if TYPE_CHECKING:
           from langchain_core.load.dump import dumpd, dumps
           from langchain_core.load.load import InitValidator, loads
           from langchain_core.load.serializable import Serializable
       
       # Unfortunately, we have to eagerly import load from langchain_core/load/load.py
       # eagerly to avoid a namespace conflict. We want users to still be able to use
       # `from langchain_core.load import load` to get the load function, but
       # the `from langchain_core.load.load import load` absolute import should also work.
    1: from langchain_core.load.load import load
       
    1: __all__ = (
           "InitValidator",
           "Serializable",
           "dumpd",
           "dumps",
           "load",
           "loads",
       )
       
    1: _dynamic_imports = {
    1:     "dumpd": "dump",
    1:     "dumps": "dump",
    1:     "InitValidator": "load",
    1:     "loads": "load",
    1:     "Serializable": "serializable",
       }
       
       
    1: def __getattr__(attr_name: str) -> object:
    3:     module_name = _dynamic_imports.get(attr_name)
    3:     result = import_attr(attr_name, module_name, __spec__.parent)
    3:     globals()[attr_name] = result
    3:     return result
       
       
    1: def __dir__() -> list[str]:
           return list(__all__)
