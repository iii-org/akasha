       # -*- coding: utf-8 -*-
       
    1: from __future__ import absolute_import
       
    1: from .base import Type
       
       
    2: class Midi(Type):
    1:     """
           Implements the Midi audio type matcher.
           """
    1:     MIME = 'audio/midi'
    1:     EXTENSION = 'midi'
       
    1:     def __init__(self):
    2:         super(Midi, self).__init__(
    1:             mime=Midi.MIME,
    1:             extension=Midi.EXTENSION
               )
       
    1:     def match(self, buf):
               return (len(buf) > 3 and
                       buf[0] == 0x4D and
                       buf[1] == 0x54 and
                       buf[2] == 0x68 and
                       buf[3] == 0x64)
       
       
    2: class Mp3(Type):
    1:     """
           Implements the MP3 audio type matcher.
           """
    1:     MIME = 'audio/mpeg'
    1:     EXTENSION = 'mp3'
       
    1:     def __init__(self):
    2:         super(Mp3, self).__init__(
    1:             mime=Mp3.MIME,
    1:             extension=Mp3.EXTENSION
               )
       
    1:     def match(self, buf):
               return (len(buf) > 2 and
                       ((buf[0] == 0x49 and
                         buf[1] == 0x44 and
                         buf[2] == 0x33) or
                        (buf[0] == 0xFF and
                         buf[1] == 0xF2) or
                        (buf[0] == 0xFF and
                         buf[1] == 0xF3) or
                        (buf[0] == 0xFF and
                         buf[1] == 0xFB)))
       
       
    2: class M4a(Type):
    1:     """
           Implements the M4A audio type matcher.
           """
    1:     MIME = 'audio/mp4'
    1:     EXTENSION = 'm4a'
       
    1:     def __init__(self):
    2:         super(M4a, self).__init__(
    1:             mime=M4a.MIME,
    1:             extension=M4a.EXTENSION
               )
       
    1:     def match(self, buf):
               return (len(buf) > 10 and
                       ((buf[4] == 0x66 and
                           buf[5] == 0x74 and
                           buf[6] == 0x79 and
                           buf[7] == 0x70 and
                           buf[8] == 0x4D and
                           buf[9] == 0x34 and
                           buf[10] == 0x41) or
                       (buf[0] == 0x4D and
                           buf[1] == 0x34 and
                           buf[2] == 0x41 and
                           buf[3] == 0x20)))
       
       
    2: class Ogg(Type):
    1:     """
           Implements the OGG audio type matcher.
           """
    1:     MIME = 'audio/ogg'
    1:     EXTENSION = 'ogg'
       
    1:     def __init__(self):
    2:         super(Ogg, self).__init__(
    1:             mime=Ogg.MIME,
    1:             extension=Ogg.EXTENSION
               )
       
    1:     def match(self, buf):
               return (len(buf) > 3 and
                       buf[0] == 0x4F and
                       buf[1] == 0x67 and
                       buf[2] == 0x67 and
                       buf[3] == 0x53)
       
       
    2: class Flac(Type):
    1:     """
           Implements the FLAC audio type matcher.
           """
    1:     MIME = 'audio/x-flac'
    1:     EXTENSION = 'flac'
       
    1:     def __init__(self):
    2:         super(Flac, self).__init__(
    1:             mime=Flac.MIME,
    1:             extension=Flac.EXTENSION
               )
       
    1:     def match(self, buf):
               return (len(buf) > 3 and
                       buf[0] == 0x66 and
                       buf[1] == 0x4C and
                       buf[2] == 0x61 and
                       buf[3] == 0x43)
       
       
    2: class Wav(Type):
    1:     """
           Implements the WAV audio type matcher.
           """
    1:     MIME = 'audio/x-wav'
    1:     EXTENSION = 'wav'
       
    1:     def __init__(self):
    2:         super(Wav, self).__init__(
    1:             mime=Wav.MIME,
    1:             extension=Wav.EXTENSION
               )
       
    1:     def match(self, buf):
               return (len(buf) > 11 and
                       buf[0] == 0x52 and
                       buf[1] == 0x49 and
                       buf[2] == 0x46 and
                       buf[3] == 0x46 and
                       buf[8] == 0x57 and
                       buf[9] == 0x41 and
                       buf[10] == 0x56 and
                       buf[11] == 0x45)
       
       
    2: class Amr(Type):
    1:     """
           Implements the AMR audio type matcher.
           """
    1:     MIME = 'audio/amr'
    1:     EXTENSION = 'amr'
       
    1:     def __init__(self):
    2:         super(Amr, self).__init__(
    1:             mime=Amr.MIME,
    1:             extension=Amr.EXTENSION
               )
       
    1:     def match(self, buf):
               return (len(buf) > 11 and
                       buf[0] == 0x23 and
                       buf[1] == 0x21 and
                       buf[2] == 0x41 and
                       buf[3] == 0x4D and
                       buf[4] == 0x52 and
                       buf[5] == 0x0A)
       
       
    2: class Aac(Type):
    1:     """Implements the Aac audio type matcher."""
       
    1:     MIME = 'audio/aac'
    1:     EXTENSION = 'aac'
       
    1:     def __init__(self):
    2:         super(Aac, self).__init__(
    1:             mime=Aac.MIME,
    1:             extension=Aac.EXTENSION
               )
       
    1:     def match(self, buf):
               return (buf[:2] == bytearray([0xff, 0xf1]) or
                       buf[:2] == bytearray([0xff, 0xf9]))
       
       
    2: class Aiff(Type):
    1:     """
           Implements the AIFF audio type matcher.
           """
    1:     MIME = 'audio/x-aiff'
    1:     EXTENSION = 'aiff'
       
    1:     def __init__(self):
    2:         super(Aiff, self).__init__(
    1:             mime=Aiff.MIME,
    1:             extension=Aiff.EXTENSION
               )
       
    1:     def match(self, buf):
               return (len(buf) > 11 and
                       buf[0] == 0x46 and
                       buf[1] == 0x4F and
                       buf[2] == 0x52 and
                       buf[3] == 0x4D and
                       buf[8] == 0x41 and
                       buf[9] == 0x49 and
                       buf[10] == 0x46 and
                       buf[11] == 0x46)
