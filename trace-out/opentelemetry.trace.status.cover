    1: import enum
    1: import logging
       
    1: logger = logging.getLogger(__name__)
       
       
    2: class StatusCode(enum.Enum):
    1:     """Represents the canonical set of status codes of a finished Span."""
       
    1:     UNSET = 0
    1:     """The default status."""
       
    1:     OK = 1
    1:     """The operation has been validated by an Application developer or Operator to have completed successfully."""
       
    1:     ERROR = 2
    1:     """The operation contains an error."""
       
       
    2: class Status:
    1:     """Represents the status of a finished Span.
       
           Args:
               status_code: The canonical status code that describes the result
                   status of the operation.
               description: An optional description of the status.
           """
       
    3:     def __init__(
               self,
    2:         status_code: StatusCode = StatusCode.UNSET,
    2:         description: str | None = None,
           ):
    1:         self._status_code = status_code
    1:         self._description = None
       
    1:         if description:
                   if not isinstance(description, str):
                       logger.warning("Invalid status description type, expected str")
                       return
                   if status_code is not StatusCode.ERROR:
                       logger.warning(
                           "description should only be set when status_code is set to StatusCode.ERROR"
                       )
                       return
       
    1:         self._description = description
       
    2:     @property
    2:     def status_code(self) -> StatusCode:
               """Represents the canonical status code of a finished Span."""
               return self._status_code
       
    2:     @property
    2:     def description(self) -> str | None:
               """Status description"""
               return self._description
       
    2:     @property
    2:     def is_ok(self) -> bool:
               """Returns false if this represents an error, true otherwise."""
               return self.is_unset or self._status_code is StatusCode.OK
       
    2:     @property
    2:     def is_unset(self) -> bool:
               """Returns true if unset, false otherwise."""
               return self._status_code is StatusCode.UNSET
