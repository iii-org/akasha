    1: """Custom exceptions for FastMCP."""
       
       
    2: class FastMCPError(Exception):
    1:     """Base error for FastMCP."""
       
       
    2: class ValidationError(FastMCPError):
    1:     """Error in validating parameters or return values."""
       
       
    2: class ResourceError(FastMCPError):
    1:     """Error in resource operations."""
       
       
    2: class ToolError(FastMCPError):
    1:     """Error in tool operations."""
       
       
    2: class InvalidSignature(Exception):
    1:     """Invalid signature for use with FastMCP."""
