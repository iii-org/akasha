    1: from collections.abc import Callable
    1: from typing import Any, Optional
       
    1: from .effects import EffectHolder
    1: from .fake_impl import FakeImplHolder
    1: from .utils import RegistrationHandle
       
       
    1: __all__ = ["SimpleLibraryRegistry", "SimpleOperatorEntry", "singleton"]
       
       
    2: class SimpleLibraryRegistry:
    1:     """Registry for the "simple" torch.library APIs
       
           The "simple" torch.library APIs are a higher-level API on top of the
           raw PyTorch DispatchKey registration APIs that includes:
           - fake impl
       
           Registrations for these APIs do not go into the PyTorch dispatcher's
           table because they may not directly involve a DispatchKey. For example,
           the fake impl is a Python function that gets invoked by FakeTensor.
           Instead, we manage them here.
       
           SimpleLibraryRegistry is a mapping from a fully qualified operator name
           (including the overload) to SimpleOperatorEntry.
           """
       
    1:     def __init__(self) -> None:
    1:         self._data: dict[str, SimpleOperatorEntry] = {}
       
    1:     def find(self, qualname: str) -> "SimpleOperatorEntry":
  118:         res = self._data.get(qualname, None)
  118:         if res is None:
  118:             self._data[qualname] = res = SimpleOperatorEntry(qualname)
  118:         return res
       
       
    1: singleton: SimpleLibraryRegistry = SimpleLibraryRegistry()
       
       
    2: class SimpleOperatorEntry:
    1:     """This is 1:1 to an operator overload.
       
           The fields of SimpleOperatorEntry are Holders where kernels can be
           registered to.
           """
       
    1:     def __init__(self, qualname: str) -> None:
  118:         self.qualname: str = qualname
  118:         self.fake_impl: FakeImplHolder = FakeImplHolder(qualname)
  118:         self.torch_dispatch_rules: GenericTorchDispatchRuleHolder = (
  118:             GenericTorchDispatchRuleHolder(qualname)
               )
       
  118:         self.effect: EffectHolder = EffectHolder(qualname)
       
           # For compatibility reasons. We can delete this soon.
    2:     @property
    2:     def abstract_impl(self) -> FakeImplHolder:
               return self.fake_impl
       
       
    2: class GenericTorchDispatchRuleHolder:
    1:     def __init__(self, qualname: str) -> None:
  118:         self._data: dict[type, Callable[..., Any]] = {}
  118:         self.qualname: str = qualname
       
    4:     def register(
    2:         self, torch_dispatch_class: type, func: Callable[..., Any]
    1:     ) -> RegistrationHandle:
               if self.find(torch_dispatch_class):
                   raise RuntimeError(
                       f"{torch_dispatch_class} already has a `__torch_dispatch__` rule registered for {self.qualname}"
                   )
               self._data[torch_dispatch_class] = func
       
               def deregister() -> None:
                   del self._data[torch_dispatch_class]
       
               return RegistrationHandle(deregister)
       
    1:     def find(self, torch_dispatch_class: type) -> Optional[Callable[..., Any]]:
               return self._data.get(torch_dispatch_class, None)
       
       
    4: def find_torch_dispatch_rule(
    2:     op: Any, torch_dispatch_class: type
    1: ) -> Optional[Callable[..., Any]]:
           return singleton.find(op.__qualname__).torch_dispatch_rules.find(
               torch_dispatch_class
           )
