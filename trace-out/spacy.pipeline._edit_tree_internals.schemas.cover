    1: from collections import defaultdict
    1: from typing import Any, Dict, List, Union
       
    1: from pydantic import (
           BaseModel,
           ConfigDict,
           Field,
           RootModel,
           StrictBool,
           StrictInt,
           StrictStr,
           ValidationError,
       )
       
       
    2: class MatchNodeSchema(BaseModel):
    1:     prefix_len: StrictInt = Field(..., title="Prefix length")
    1:     suffix_len: StrictInt = Field(..., title="Suffix length")
    1:     prefix_tree: StrictInt = Field(..., title="Prefix tree")
    1:     suffix_tree: StrictInt = Field(..., title="Suffix tree")
       
    1:     model_config = ConfigDict(extra="forbid")
       
       
    2: class SubstNodeSchema(BaseModel):
    1:     orig: Union[int, StrictStr] = Field(..., title="Original substring")
    1:     subst: Union[int, StrictStr] = Field(..., title="Replacement substring")
       
    1:     model_config = ConfigDict(extra="forbid")
       
       
    2: class EditTreeSchema(RootModel[Union[MatchNodeSchema, SubstNodeSchema]]):
    1:     pass
       
       
    1: def validate_edit_tree(obj: Dict[str, Any]) -> List[str]:
           """Validate edit tree.
       
           obj (Dict[str, Any]): JSON-serializable data to validate.
           RETURNS (List[str]): A list of error messages, if available.
           """
           try:
               EditTreeSchema.model_validate(obj)
               return []
           except ValidationError as e:
               errors = e.errors()
               data = defaultdict(list)
               for error in errors:
                   err_loc = " -> ".join([str(p) for p in error.get("loc", [])])
                   data[err_loc].append(error.get("msg"))
               return [f"[{loc}] {', '.join(msg)}" for loc, msg in data.items()]  # type: ignore[arg-type]
