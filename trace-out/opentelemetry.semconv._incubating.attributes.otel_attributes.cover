    1: OTEL_SCOPE_NAME: Final = "otel.scope.name"
    1: """
       Deprecated in favor of stable :py:const:`opentelemetry.semconv.attributes.otel_attributes.OTEL_SCOPE_NAME`.
       """
       
    1: OTEL_SCOPE_SCHEMA_URL: Final = "otel.scope.schema_url"
    1: """
       The schema URL of the instrumentation scope.
       """
       
    1: OTEL_SCOPE_VERSION: Final = "otel.scope.version"
    1: """
       Deprecated in favor of stable :py:const:`opentelemetry.semconv.attributes.otel_attributes.OTEL_SCOPE_VERSION`.
       """
       
    1: OTEL_SPAN_PARENT_ORIGIN: Final = "otel.span.parent.origin"
    1: """
       Determines whether the span has a parent span, and if so, [whether it is a remote parent](https://opentelemetry.io/docs/specs/otel/trace/api/#isremote).
       """
       
    1: OTEL_SPAN_SAMPLING_RESULT: Final = "otel.span.sampling_result"
    1: """
       The result value of the sampler for this span.
       """
       
    1: OTEL_STATUS_CODE: Final = "otel.status_code"
