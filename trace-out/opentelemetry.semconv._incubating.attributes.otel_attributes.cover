    1:     PROMETHEUS_HTTP_TEXT_METRIC_EXPORTER = (
    1:         "prometheus_http_text_metric_exporter"
           )
    1:     """Prometheus metric exporter over HTTP with the default text-based format."""
       
       
    2: class OtelSpanParentOriginValues(Enum):
    1:     NONE = "none"
    1:     """The span does not have a parent, it is a root span."""
    1:     LOCAL = "local"
    1:     """The span has a parent and the parent's span context [isRemote()](https://opentelemetry.io/docs/specs/otel/trace/api/#isremote) is false."""
    1:     REMOTE = "remote"
    1:     """The span has a parent and the parent's span context [isRemote()](https://opentelemetry.io/docs/specs/otel/trace/api/#isremote) is true."""
       
       
    2: class OtelSpanSamplingResultValues(Enum):
    1:     DROP = "DROP"
    1:     """The span is not sampled and not recording."""
    1:     RECORD_ONLY = "RECORD_ONLY"
    1:     """The span is not sampled, but recording."""
    1:     RECORD_AND_SAMPLE = "RECORD_AND_SAMPLE"
    1:     """The span is sampled and recording."""
       
       
