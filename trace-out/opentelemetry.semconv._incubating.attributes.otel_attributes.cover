    1:     """The builtin SDK simple span processor."""
    1:     BATCHING_LOG_PROCESSOR = "batching_log_processor"
    1:     """The builtin SDK batching log record processor."""
    1:     SIMPLE_LOG_PROCESSOR = "simple_log_processor"
    1:     """The builtin SDK simple log record processor."""
    1:     OTLP_GRPC_SPAN_EXPORTER = "otlp_grpc_span_exporter"
