    1: from __future__ import annotations
       
    1: from contextvars import ContextVar, Token
       
    1: from opentelemetry.context.context import Context, _RuntimeContext
       
       
    2: class ContextVarsRuntimeContext(_RuntimeContext):
    1:     """An implementation of the RuntimeContext interface which wraps ContextVar under
           the hood. This is the preferred implementation for usage with Python 3.5+
           """
       
    1:     _CONTEXT_KEY = "current_context"
       
    1:     def __init__(self) -> None:
    2:         self._current_context = ContextVar(
    1:             self._CONTEXT_KEY, default=Context()
               )
       
    1:     def attach(self, context: Context) -> Token[Context]:
               """Sets the current `Context` object. Returns a
               token that can be used to reset to the previous `Context`.
       
               Args:
                   context: The Context to set.
               """
               return self._current_context.set(context)
       
    1:     def get_current(self) -> Context:
               """Returns the current `Context` object."""
               return self._current_context.get()
       
    1:     def detach(self, token: Token[Context]) -> None:
               """Resets Context to a previous value
       
               Args:
                   token: A reference to a previous Context.
               """
               self._current_context.reset(token)
       
       
    1: __all__ = ["ContextVarsRuntimeContext"]
