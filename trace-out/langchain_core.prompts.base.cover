           # instead of using the provided output_parser...)
    1:     output_parser: BaseOutputParser | None = None  # type: ignore[type-arg]
    1:     """How to parse the output of calling an LLM on this formatted prompt."""
       
    1:     partial_variables: Mapping[str, Any] = Field(default_factory=dict)
    1:     """A dictionary of the partial variables the prompt template carries.
       
