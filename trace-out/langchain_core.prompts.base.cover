    1:     """Base class for all prompt templates, returning a prompt."""
       
    1:     input_variables: list[str]
    1:     """A list of the names of the variables whose values are required as inputs to the
           prompt.
           """
       
    1:     optional_variables: list[str] = Field(default=[])
    1:     """A list of the names of the variables for placeholder or `MessagePlaceholder` that
           are optional.
       
           These variables are auto inferred from the prompt and user need not provide them.
