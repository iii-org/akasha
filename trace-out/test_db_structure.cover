    1: import pytest
    1: from langchain_core.documents import Document
       
    1: from akasha.utils.db.db_structure import (
           NO_PARENT_DIR_NAME,
           dbs,
           get_storage_directory,
           is_url,
           _sanitize_path_string,
       )
       
    1: pytestmark = pytest.mark.unit
       
       
    2: class _FakeArray:
    1:     def __init__(self, values):
    1:         self._values = values
       
    1:     def tolist(self):
    1:         return list(self._values)
       
       
    2: class _FakeChroma:
    1:     def __init__(self, payload):
    2:         self.payload = payload
       
    1:     def get(self, include=None):
    2:         return self.payload
       
       
    1: def test_dbs_defaults_to_empty_lists():
    1:     store = dbs()
       
    1:     assert store.get_ids() == []
    1:     assert store.get_docs() == []
    1:     assert store.get_metadatas() == []
    1:     assert store.get_embeds() == []
       
       
    1: def test_dbs_initializes_from_chroma_like_object_with_fallbacks():
    1:     payload = {
    1:         "ids": ["1", "2"],
    1:         "embeddings": _FakeArray([[0.1], [0.2]]),
    1:         "metadatas": None,
    1:         "documents": ["doc-1", "doc-2"],
           }
       
    1:     store = dbs(_FakeChroma(payload))
       
    1:     assert store.get_ids() == ["1", "2"]
    1:     assert store.get_embeds() == [[0.1], [0.2]]
    1:     assert store.get_metadatas() == [{}, {}]
    1:     assert store.get_docs() == ["doc-1", "doc-2"]
       
       
    1: def test_merge_and_add_chromadb_keep_unique_ids():
    1:     store = dbs()
    1:     store.ids = ["1"]
    1:     store.embeds = [[0.1]]
    1:     store.metadatas = [{"source": "a"}]
    1:     store.docs = ["alpha"]
    1:     store.vis = {"1"}
       
    1:     incoming = dbs()
    1:     incoming.ids = ["1", "2"]
    1:     incoming.embeds = [[0.1], [0.2]]
    1:     incoming.metadatas = [{"source": "a"}, {"source": "b"}]
    1:     incoming.docs = ["alpha", "beta"]
    1:     incoming.vis = {"1", "2"}
       
    1:     store.merge(incoming)
       
    1:     assert store.get_ids() == ["1", "2"]
    1:     assert store.get_docs() == ["alpha", "beta"]
       
    2:     store.add_chromadb(
    2:         _FakeChroma(
    1:             {
    1:                 "ids": ["3"],
    1:                 "embeddings": [[0.3]],
    1:                 "metadatas": [{"source": "c"}],
    1:                 "documents": ["gamma"],
                   }
               )
           )
       
    1:     assert store.get_ids()[-1] == "3"
    1:     assert store.get_docs()[-1] == "gamma"
       
       
    1: def test_get_documents_returns_langchain_documents():
    1:     store = dbs()
    1:     store.docs = ["hello"]
    1:     store.metadatas = [{"topic": "demo"}]
       
    1:     docs = store.get_Documents()
       
    1:     assert docs == [Document(page_content="hello", metadata={"topic": "demo"})]
       
       
    1: def test_storage_directory_handles_path_dot_and_url():
    3:     assert get_storage_directory(".", 100, "openai", "text-embedding-3-small") == (
    2:         f"chromadb/{NO_PARENT_DIR_NAME}_openai_text-embedding-3-small_100"
           )
    3:     assert get_storage_directory("docs/my_folder", 50, "hf", "bge/base") == (
    2:         "chromadb/docs-myfolder_hf_bge-base_50"
           )
       
    1:     url_dir = get_storage_directory("https://example.com/a/b?q=1", 25, "openai", "embed")
    1:     assert url_dir.startswith("chromadb/httpsexamplecomabq1_openai_embed_25")
       
       
    1: def test_url_and_path_sanitization_helpers():
    1:     assert is_url("https://example.com") is True
    1:     assert is_url("ftp://example.com") is False
    1:     assert _sanitize_path_string("https://exa mple.com/a-b_c?x=1") == "httpsexamplecomabcx1"
