    1:     def innerstring_rules(ttype):
    2:         return [
                   # the old style '%s' % (...) string formatting (still valid in Py3)
    4:             (r'%(\(\w+\))?[-#0 +]*([0-9]+|[*])?(\.([0-9]+|[*]))?'
    2:              '[hlL]?[E-GXc-giorsaux%]', String.Interpol),
                   # the new style '{}'.format(...) string formatting
    4:             (r'\{'
