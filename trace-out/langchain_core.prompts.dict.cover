    1: """Dictionary prompt template."""
       
    1: import warnings
    1: from functools import cached_property
    1: from typing import Any, Literal, cast
       
    1: from pydantic import model_validator
    1: from typing_extensions import override
       
    1: from langchain_core.load import dumpd
    1: from langchain_core.prompts.string import (
           DEFAULT_FORMATTER_MAPPING,
           get_template_variables,
       )
    1: from langchain_core.runnables import RunnableConfig, RunnableSerializable
    1: from langchain_core.runnables.config import ensure_config
       
       
    2: class DictPromptTemplate(RunnableSerializable[dict[str, Any], dict[str, Any]]):
    1:     """Template represented by a dictionary.
       
           Recognizes variables in f-string or mustache formatted string dict values.
       
           Does NOT recognize variables in dict keys. Applies recursively.
       
           Example:
               ```python
               prompt = DictPromptTemplate(
                   template={
                       "type": "text",
                       "text": "Hello {name}",
                       "metadata": {"source": "{source}"},
                   },
                   template_format="f-string",
               )
               prompt.format(name="Alice", source="docs")
               # {
               #     "type": "text",
               #     "text": "Hello Alice",
               #     "metadata": {"source": "docs"},
               # }
               ```
           """
       
    1:     template: dict[str, Any]
    1:     template_format: Literal["f-string", "mustache"]
       
    2:     @model_validator(mode="after")
    2:     def validate_template(self) -> "DictPromptTemplate":
               """Validate that the template structure contains only safe variables."""
               _get_input_variables(self.template, self.template_format)
               return self
       
    2:     @property
    2:     def input_variables(self) -> list[str]:
               """Template input variables."""
               return _get_input_variables(self.template, self.template_format)
       
    1:     def format(self, **kwargs: Any) -> dict[str, Any]:
               """Format the prompt with the inputs.
       
               Returns:
                   A formatted dict.
               """
               return _insert_input_variables(self.template, kwargs, self.template_format)
       
    1:     async def aformat(self, **kwargs: Any) -> dict[str, Any]:
               """Format the prompt with the inputs.
       
               Returns:
                   A formatted dict.
               """
               return self.format(**kwargs)
       
    2:     @override
    6:     def invoke(
    4:         self, input: dict[str, Any], config: RunnableConfig | None = None, **kwargs: Any
    1:     ) -> dict[str, Any]:
               return self._call_with_config(
                   lambda x: self.format(**x),
                   input,
                   ensure_config(config),
                   run_type="prompt",
                   serialized=self._serialized,
                   **kwargs,
               )
       
    2:     @property
    2:     def _prompt_type(self) -> str:
               return "dict-prompt"
       
    2:     @cached_property
    2:     def _serialized(self) -> dict[str, Any]:
               # self is always a Serializable object in this case, thus the result is
               # guaranteed to be a dict since dumpd uses the default callback, which uses
               # obj.to_json which always returns TypedDict subclasses
               return cast("dict[str, Any]", dumpd(self))
       
    2:     @classmethod
    2:     def is_lc_serializable(cls) -> bool:
               """Return `True` as this class is serializable."""
               return True
       
    2:     @classmethod
    2:     def get_lc_namespace(cls) -> list[str]:
               """Get the namespace of the LangChain object.
       
               Returns:
                   `["langchain_core", "prompts", "dict"]`
               """
               return ["langchain_core", "prompts", "dict"]
       
    1:     def pretty_repr(self, *, html: bool = False) -> str:
               """Human-readable representation.
       
               Args:
                   html: Whether to format as HTML.
       
               Returns:
                   Human-readable representation.
               """
               raise NotImplementedError
       
       
    4: def _get_input_variables(
    2:     template: dict[str, Any], template_format: Literal["f-string", "mustache"]
    1: ) -> list[str]:
           input_variables = []
           for v in template.values():
               if isinstance(v, str):
                   input_variables += get_template_variables(v, template_format)
               elif isinstance(v, dict):
                   input_variables += _get_input_variables(v, template_format)
               elif isinstance(v, (list, tuple)):
                   for x in v:
                       if isinstance(x, str):
                           input_variables += get_template_variables(x, template_format)
                       elif isinstance(x, dict):
                           input_variables += _get_input_variables(x, template_format)
           return list(set(input_variables))
       
       
    5: def _insert_input_variables(
    1:     template: dict[str, Any],
    1:     inputs: dict[str, Any],
    1:     template_format: Literal["f-string", "mustache"],
    1: ) -> dict[str, Any]:
           formatted: dict[str, Any] = {}
           formatter = DEFAULT_FORMATTER_MAPPING[template_format]
           for k, v in template.items():
               if isinstance(v, str):
                   formatted[k] = formatter(v, **inputs)
               elif isinstance(v, dict):
                   if k == "image_url" and "path" in v:
                       msg = (
                           "Specifying image inputs via file path in environments with "
                           "user-input paths is a security vulnerability. Out of an abundance "
                           "of caution, the utility has been removed to prevent possible "
                           "misuse."
                       )
                       warnings.warn(msg, stacklevel=2)
                   formatted[k] = _insert_input_variables(v, inputs, template_format)
               elif isinstance(v, (list, tuple)):
                   formatted_v: list[str | dict[str, Any]] = []
                   for x in v:
                       if isinstance(x, str):
                           formatted_v.append(formatter(x, **inputs))
                       elif isinstance(x, dict):
                           formatted_v.append(
                               _insert_input_variables(x, inputs, template_format)
                           )
                   formatted[k] = type(v)(formatted_v)
               else:
                   formatted[k] = v
           return formatted
