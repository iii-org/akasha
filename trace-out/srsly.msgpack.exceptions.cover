    2: class UnpackException(Exception):
    1:     """Base class for some exceptions raised while unpacking.
       
           NOTE: unpack may raise exception other than subclass of
           UnpackException.  If you want to catch all error, catch
           Exception instead.
           """
       
       
    2: class BufferFull(UnpackException):
    1:     pass
       
       
    2: class OutOfData(UnpackException):
    1:     pass
       
       
    2: class FormatError(ValueError, UnpackException):
    1:     """Invalid msgpack format"""
       
       
    2: class StackError(ValueError, UnpackException):
    1:     """Too nested"""
       
       
       # Deprecated.  Use ValueError instead
    1: UnpackValueError = ValueError
       
       
    2: class ExtraData(UnpackValueError):
    1:     """ExtraData is raised when there is trailing data.
       
           This exception is raised while only one-shot (not streaming)
           unpack.
           """
       
    1:     def __init__(self, unpacked, extra):
               self.unpacked = unpacked
               self.extra = extra
       
    1:     def __str__(self):
               return "unpack(b) received extra data."
       
       
       # Deprecated.  Use Exception instead to catch all exception during packing.
    1: PackException = Exception
    1: PackValueError = ValueError
    1: PackOverflowError = OverflowError
