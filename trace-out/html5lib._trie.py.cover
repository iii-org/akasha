    1: from __future__ import absolute_import, division, unicode_literals
    1: from six import text_type
       
    1: from bisect import bisect_left
       
    1: from ._base import Trie as ABCTrie
       
       
    2: class Trie(ABCTrie):
    1:     def __init__(self, data):
 2233:         if not all(isinstance(x, text_type) for x in data.keys()):
                   raise TypeError("All keys must be strings")
       
    1:         self._data = data
    1:         self._keys = sorted(data.keys())
    1:         self._cachestr = ""
    1:         self._cachepoints = (0, len(data))
       
    1:     def __contains__(self, key):
               return key in self._data
       
    1:     def __len__(self):
               return len(self._data)
       
    1:     def __iter__(self):
               return iter(self._data)
       
    1:     def __getitem__(self, key):
               return self._data[key]
       
    1:     def keys(self, prefix=None):
               if prefix is None or prefix == "" or not self._keys:
                   return set(self._keys)
       
               if prefix.startswith(self._cachestr):
                   lo, hi = self._cachepoints
                   start = i = bisect_left(self._keys, prefix, lo, hi)
               else:
                   start = i = bisect_left(self._keys, prefix)
       
               keys = set()
               if start == len(self._keys):
                   return keys
       
               while self._keys[i].startswith(prefix):
                   keys.add(self._keys[i])
                   i += 1
       
               self._cachestr = prefix
               self._cachepoints = (start, i)
       
               return keys
       
    1:     def has_keys_with_prefix(self, prefix):
               if prefix in self._data:
                   return True
       
               if prefix.startswith(self._cachestr):
                   lo, hi = self._cachepoints
                   i = bisect_left(self._keys, prefix, lo, hi)
               else:
                   i = bisect_left(self._keys, prefix)
       
               if i == len(self._keys):
                   return False
       
               return self._keys[i].startswith(prefix)
