    1: from typing import Any
       
    1: import torch
    1: from torch import nn
    1: from torch.ao.quantization import QConfig
       
       
    1: __all__ = ["QuantStub", "DeQuantStub", "QuantWrapper"]
       
       
    2: class QuantStub(nn.Module):
    1:     r"""Quantize stub module, before calibration, this is same as an observer,
           it will be swapped as `nnq.Quantize` in `convert`.
       
           Args:
               qconfig: quantization configuration for the tensor,
                   if qconfig is not provided, we will get qconfig from parent modules
           """
       
    1:     def __init__(self, qconfig: QConfig | None = None):
               super().__init__()
               if qconfig:
                   self.qconfig = qconfig
       
    1:     def forward(self, x: torch.Tensor) -> torch.Tensor:
               return x
       
       
    2: class DeQuantStub(nn.Module):
    1:     r"""Dequantize stub module, before calibration, this is same as identity,
           this will be swapped as `nnq.DeQuantize` in `convert`.
       
           Args:
               qconfig: quantization configuration for the tensor,
                   if qconfig is not provided, we will get qconfig from parent modules
           """
       
    1:     def __init__(self, qconfig: Any | None = None):
               super().__init__()
               if qconfig:
                   self.qconfig = qconfig
       
    1:     def forward(self, x: torch.Tensor) -> torch.Tensor:
               return x
       
       
    2: class QuantWrapper(nn.Module):
    1:     r"""A wrapper class that wraps the input module, adds QuantStub and
           DeQuantStub and surround the call to module with call to quant and dequant
           modules.
       
           This is used by the `quantization` utility functions to add the quant and
           dequant modules, before `convert` function `QuantStub` will just be observer,
           it observes the input tensor, after `convert`, `QuantStub`
           will be swapped to `nnq.Quantize` which does actual quantization. Similarly
           for `DeQuantStub`.
           """
       
    1:     quant: QuantStub
    1:     dequant: DeQuantStub
    1:     module: nn.Module
       
    1:     def __init__(self, module: nn.Module):
               super().__init__()
               qconfig = getattr(module, "qconfig", None)
               self.add_module("quant", QuantStub(qconfig))
               self.add_module("dequant", DeQuantStub(qconfig))
               self.add_module("module", module)
               self.train(module.training)
       
    1:     def forward(self, X: torch.Tensor) -> torch.Tensor:
               X = self.quant(X)
               X = self.module(X)
               return self.dequant(X)
