    1:     def _codec(self, charset: _Encoding) -> Optional[str]:
               if not charset:
                   return charset
               codec = None
               try:
                   codecs.lookup(charset)
                   codec = charset
               except (LookupError, ValueError):
                   pass
               return codec
       
