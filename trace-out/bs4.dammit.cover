               value = (
                   self._codec(self.CHARSET_ALIASES.get(charset, charset))
                   or (charset and self._codec(charset.replace("-", "")))
                   or (charset and self._codec(charset.replace("-", "_")))
                   or (charset and charset.lower())
                   or charset
