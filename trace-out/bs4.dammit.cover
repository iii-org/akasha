    2:         known_definite_encodings: Optional[_Encodings] = None,
    2:         is_html: Optional[bool] = False,
    2:         exclude_encodings: Optional[_Encodings] = None,
    2:         user_encodings: Optional[_Encodings] = None,
    2:         override_encodings: Optional[_Encodings] = None,
