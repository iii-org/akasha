    1: from typing import Dict, Iterator, List, Optional, Tuple, Union
       
    1: from .. import AddedToken, Tokenizer, decoders, pre_tokenizers, trainers
    1: from ..models import BPE
    1: from ..normalizers import BertNormalizer, Lowercase, Sequence, unicode_normalizer_from_str
    1: from .base_tokenizer import BaseTokenizer
       
       
    2: class CharBPETokenizer(BaseTokenizer):
    1:     """Original BPE Tokenizer
       
           Represents the BPE algorithm, as introduced by Rico Sennrich
           (https://arxiv.org/abs/1508.07909)
       
           The defaults settings corresponds to OpenAI GPT BPE tokenizers and differs from the original
           Sennrich subword-nmt implementation by the following options that you can deactivate:
               - adding a normalizer to clean up the text (deactivate with `bert_normalizer=False`) by:
                   * removing any control characters and replacing all whitespaces by the classic one.
                   * handle chinese chars by putting spaces around them.
                   * strip all accents.
               - spitting on punctuation in addition to whitespaces (deactivate it with
                 `split_on_whitespace_only=True`)
           """
       
   10:     def __init__(
               self,
    2:         vocab: Optional[Union[str, Dict[str, int]]] = None,
    2:         merges: Optional[Union[str, List[Tuple[str, str]]]] = None,
    2:         unk_token: Union[str, AddedToken] = "<unk>",
    2:         suffix: str = "</w>",
    2:         dropout: Optional[float] = None,
    2:         lowercase: bool = False,
    2:         unicode_normalizer: Optional[str] = None,
    2:         bert_normalizer: bool = True,
    2:         split_on_whitespace_only: bool = False,
           ):
               if vocab is not None and merges is not None:
                   tokenizer = Tokenizer(
                       BPE(
                           vocab,
                           merges,
                           dropout=dropout,
                           unk_token=str(unk_token),
                           end_of_word_suffix=suffix,
                       )
                   )
               else:
                   tokenizer = Tokenizer(BPE(unk_token=str(unk_token), dropout=dropout, end_of_word_suffix=suffix))
       
               if tokenizer.token_to_id(str(unk_token)) is not None:
                   tokenizer.add_special_tokens([str(unk_token)])
       
               # Check for Unicode normalization first (before everything else)
               normalizers = []
       
               if unicode_normalizer:
                   normalizers += [unicode_normalizer_from_str(unicode_normalizer)]
       
               if bert_normalizer:
                   normalizers += [BertNormalizer(lowercase=False)]
       
               if lowercase:
                   normalizers += [Lowercase()]
       
               # Create the normalizer structure
               if len(normalizers) > 0:
                   if len(normalizers) > 1:
                       tokenizer.normalizer = Sequence(normalizers)
                   else:
                       tokenizer.normalizer = normalizers[0]
       
               if split_on_whitespace_only:
                   tokenizer.pre_tokenizer = pre_tokenizers.WhitespaceSplit()
               else:
                   tokenizer.pre_tokenizer = pre_tokenizers.BertPreTokenizer()
       
               tokenizer.decoder = decoders.BPEDecoder(suffix=suffix)
       
               parameters = {
                   "model": "BPE",
                   "unk_token": unk_token,
                   "suffix": suffix,
                   "dropout": dropout,
                   "lowercase": lowercase,
                   "unicode_normalizer": unicode_normalizer,
                   "bert_normalizer": bert_normalizer,
                   "split_on_whitespace_only": split_on_whitespace_only,
               }
       
               super().__init__(tokenizer, parameters)
       
    2:     @staticmethod
    2:     def from_file(vocab_filename: str, merges_filename: str, **kwargs):
               vocab, merges = BPE.read_file(vocab_filename, merges_filename)
               return CharBPETokenizer(vocab, merges, **kwargs)
       
    9:     def train(
               self,
    1:         files: Union[str, List[str]],
    2:         vocab_size: int = 30000,
    2:         min_frequency: int = 2,
    2:         special_tokens: List[Union[str, AddedToken]] = ["<unk>"],
    2:         limit_alphabet: int = 1000,
    2:         initial_alphabet: List[str] = [],
    2:         suffix: Optional[str] = "</w>",
    2:         show_progress: bool = True,
           ):
               """Train the model using the given files"""
       
               trainer = trainers.BpeTrainer(
                   vocab_size=vocab_size,
                   min_frequency=min_frequency,
                   special_tokens=special_tokens,
                   limit_alphabet=limit_alphabet,
                   initial_alphabet=initial_alphabet,
                   end_of_word_suffix=suffix,
                   show_progress=show_progress,
               )
               if isinstance(files, str):
                   files = [files]
               self._tokenizer.train(files, trainer=trainer)
       
   10:     def train_from_iterator(
               self,
    1:         iterator: Union[Iterator[str], Iterator[Iterator[str]]],
    2:         vocab_size: int = 30000,
    2:         min_frequency: int = 2,
    2:         special_tokens: List[Union[str, AddedToken]] = ["<unk>"],
    2:         limit_alphabet: int = 1000,
    2:         initial_alphabet: List[str] = [],
    2:         suffix: Optional[str] = "</w>",
    2:         show_progress: bool = True,
    2:         length: Optional[int] = None,
           ):
               """Train the model using the given iterator"""
       
               trainer = trainers.BpeTrainer(
                   vocab_size=vocab_size,
                   min_frequency=min_frequency,
                   special_tokens=special_tokens,
                   limit_alphabet=limit_alphabet,
                   initial_alphabet=initial_alphabet,
                   end_of_word_suffix=suffix,
                   show_progress=show_progress,
               )
               self._tokenizer.train_from_iterator(
                   iterator,
                   trainer=trainer,
                   length=length,
               )
