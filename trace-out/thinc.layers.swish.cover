    1: from typing import Callable, Optional, Tuple, cast
       
    1: from ..config import registry
    1: from ..initializers import he_normal_init, zero_init
    1: from ..model import Model
    1: from ..types import Floats1d, Floats2d
    1: from ..util import get_width, partial
    1: from .chain import chain
    1: from .dropout import Dropout
    1: from .layernorm import LayerNorm
       
       
    2: @registry.layers("Swish.v1")
   10: def Swish(
    2:     nO: Optional[int] = None,
    2:     nI: Optional[int] = None,
           *,
    2:     init_W: Optional[Callable] = None,
    2:     init_b: Optional[Callable] = None,
    2:     dropout: Optional[float] = None,
    2:     normalize: bool = False,
    1: ) -> Model[Floats2d, Floats2d]:
           if init_W is None:
               init_W = he_normal_init
           if init_b is None:
               init_b = zero_init
           model: Model[Floats2d, Floats2d] = Model(
               "swish",
               forward,
               init=partial(init, init_W, init_b),
               dims={"nO": nO, "nI": nI},
               params={"W": None, "b": None},
           )
           if normalize:
               model = chain(model, LayerNorm(nI=nO))
           if dropout is not None:
               model = chain(model, cast(Model[Floats2d, Floats2d], Dropout(dropout)))
           return model
       
       
    5: def forward(
    3:     model: Model[Floats2d, Floats2d], X: Floats2d, is_train: bool
    1: ) -> Tuple[Floats2d, Callable]:
           W = cast(Floats2d, model.get_param("W"))
           b = cast(Floats1d, model.get_param("b"))
           Y_preact = model.ops.affine(X, W, b)
           Y = model.ops.swish(Y_preact)
       
           def backprop(dY: Floats2d) -> Floats2d:
               dY = model.ops.backprop_swish(dY, Y_preact, Y, inplace=False)
               model.inc_grad("b", dY.sum(axis=0))
               model.inc_grad("W", model.ops.gemm(dY, X, trans1=True))
               return model.ops.gemm(dY, W)
       
           return Y, backprop
       
       
    7: def init(
    1:     init_W: Callable,
    1:     init_b: Callable,
    1:     model: Model[Floats2d, Floats2d],
    2:     X: Optional[Floats2d] = None,
    2:     Y: Optional[Floats2d] = None,
    1: ) -> None:
           if X is not None:
               model.set_dim("nI", get_width(X))
           if Y is not None:
               model.set_dim("nO", get_width(Y))
           model.set_param("W", init_W(model.ops, (model.get_dim("nO"), model.get_dim("nI"))))
           model.set_param("b", init_b(model.ops, (model.get_dim("nO"),)))
