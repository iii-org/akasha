    5: def _prod_aten(
    1:     inp: TensorLikeType,
    1:     dims: DimsSequenceType | None,
           *,
    2:     dtype: torch.dtype | None = None,
    1: ) -> Tensor:
           if dims is not None:
               if len(dims) == 0:
                   return inp.clone()
               for d in sorted(dims, reverse=True):
                   assert d >= 0
                   inp = torch.prod(inp, d, dtype=dtype)
               return inp
           else:
               return torch.prod(inp, dims, dtype=dtype)
       
       
