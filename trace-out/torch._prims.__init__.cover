           new_strides = [0] * a.ndim
           for idx, dim in enumerate(permutation):
               new_shape[idx] = a.shape[dim]
               new_strides[idx] = a.stride()[dim]
       
           return a.as_strided(tuple(new_shape), tuple(new_strides), a.storage_offset())
       
       
