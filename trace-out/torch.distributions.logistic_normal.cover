           # pyrefly: ignore [bad-override]
    1:     base_dist: Independent[Normal]
       
    5:     def __init__(
               self,
    1:         loc: Union[Tensor, float],
    1:         scale: Union[Tensor, float],
    2:         validate_args: Optional[bool] = None,
    1:     ) -> None:
               base_dist = Normal(loc, scale, validate_args=validate_args)
               if not base_dist.batch_shape:
                   base_dist = base_dist.expand([1])
