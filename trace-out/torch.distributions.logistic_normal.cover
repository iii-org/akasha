               >>> # logistic-normal distributed with mean=(0, 0, 0) and stddev=(1, 1, 1)
               >>> # of the base Normal distribution
               >>> # xdoctest: +IGNORE_WANT("non-deterministic")
               >>> m = LogisticNormal(torch.tensor([0.0] * 3), torch.tensor([1.0] * 3))
