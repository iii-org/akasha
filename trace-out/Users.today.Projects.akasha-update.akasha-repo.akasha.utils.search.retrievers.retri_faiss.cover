    1: from typing import Any, List, Optional, Tuple
    1: from pydantic import Field
    1: import numpy as np
    1: from langchain_core.embeddings import Embeddings
    1: from langchain_core.retrievers import BaseRetriever
    1: from langchain_core.documents import Document
    1: from akasha.utils.db.db_structure import dbs
    1: from langchain_community.retrievers import KNNRetriever
    1: import faiss
       
       
    2: class myFAISSRetriever(BaseRetriever):
    1:     embeddings: Embeddings = Field(default=None)
    1:     """Embeddings model to use."""
    1:     index: faiss.IndexFlatL2 = Field(default=None)
    1:     """Index of embeddings."""
    1:     texts: List[str] = Field(default=None)
    1:     """List of texts to index."""
    1:     metadata: List[dict]
    1:     k: int = 10
    1:     """Number of results to return."""
    1:     relevancy_threshold: Optional[float] = None
       
    2:     @classmethod
    8:     def from_db(
               cls,
    1:         db: dbs,
    1:         embeddings: Embeddings,
    2:         k: int = 10,
    2:         relevancy_threshold: float = 0.0,
    1:         **kwargs: Any,
    1:     ) -> KNNRetriever:
               emb = np.array(db.get_embeds()).astype("float32")
               dimention = emb.shape[1]
               index = faiss.IndexFlatL2(dimention)
               index.add(emb)  # add vectors to the index
               texts = db.get_docs()
               metadata = db.get_metadatas()
               return cls(
                   embeddings=embeddings,
                   index=index,
                   texts=texts,
                   metadata=metadata,
                   k=k,
                   relevancy_threshold=relevancy_threshold,
                   **kwargs,
               )
       
    1:     def _gs(self, query: str) -> Tuple[List[Document], List[float]]:
               """implement FAISS search to find relevant documents
       
               Args:
                   **query (str)**: query string that used to find relevant documents\n
       
               Returns:
                   List[Document]: relevant documents
               """
               query_embeds = np.array([self.embeddings.embed_query(query)]).astype("float32")
               # use index to search
               distances, indexes = self.index.search(
                   query_embeds, min(self.k, len(self.texts))
               )
       
               top_k_scores = 1 / (1 + distances[0])
               top_k_results = [
                   Document(page_content=self.texts[row], metadata=self.metadata[row])
                   for row in indexes[0]
                   if (
                       self.relevancy_threshold is None
                       or top_k_scores[row] >= self.relevancy_threshold
                   )
               ]
               return top_k_results, top_k_scores
       
    3:     def get_relevant_documents_and_scores(
               self,
    1:         query: str,
    1:     ) -> Tuple[List[Document], List[float]]:
               return self._gs(query)
       
    1:     def _aget_relevant_documents(self, query: str) -> List[Document]:
               """implement FAISS search to find relevant documents
       
               Args:
                   **query (str)**: query string that used to find relevant documents\n
       
               Returns:
                   List[Document]: relevant documents
               """
               return self._gs(query)[0]
       
    1:     def _get_relevant_documents(self, query: str) -> List[Document]:
               return self._gs(query)[0]
