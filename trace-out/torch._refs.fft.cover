    2:     norm: NormType = None,
    1: ) -> TensorLikeType:
           (shape, dim) = _canonicalize_fft_shape_and_dim_args(input, s, dim)
           x = _maybe_promote_tensor_fft(input, require_complex=True)
           return _fftn_c2c("fftn", x, shape, dim, norm, forward=True)
       
       
