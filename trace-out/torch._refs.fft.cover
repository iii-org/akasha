    1: def _default_alldims(dim: Optional[DimsType], x: TensorLikeType) -> list[int]:
           """Convert Optional[DimsType] to a simple list, defaulting to all dimensions"""
           if dim is None:
               return list(range(x.ndim))
           elif not isinstance(dim, Sequence):
               return [dim]
           else:
               return list(dim)
       
       
    2: @register_decomposition(aten.fft_fftshift)
    2: def fftshift(input: TensorLikeType, dim: Optional[DimsType] = None) -> TensorLikeType:
           dims = _default_alldims(dim, input)
           shift = [input.shape[d] // 2 for d in dims]
           return torch.roll(input, shift, dims)
       
       
    2: @register_decomposition(aten.fft_ifftshift)
    2: def ifftshift(input: TensorLikeType, dim: Optional[DimsType] = None) -> TensorLikeType:
           dims = _default_alldims(dim, input)
           shift = [(input.shape[d] + 1) // 2 for d in dims]
           return torch.roll(input, shift, dims)
