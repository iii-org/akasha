    1: """Common types for gRPC Sync API"""
       
    1: from typing import (
           TYPE_CHECKING,
           Any,
           Callable,
           Iterable,
           Iterator,
           Optional,
           Sequence,
           Tuple,
           TypeVar,
           Union,
       )
       
    1: from grpc._cython import cygrpc
       
    1: if TYPE_CHECKING:
           from grpc import ServicerContext
           from grpc._server import _RPCState
       
    1: RequestType = TypeVar("RequestType")
    1: ResponseType = TypeVar("ResponseType")
    1: SerializingFunction = Callable[[Any], bytes]
    1: DeserializingFunction = Callable[[bytes], Any]
    1: MetadataType = Sequence[Tuple[str, Union[str, bytes]]]
    1: ChannelArgumentType = Tuple[str, Any]
    1: DoneCallbackType = Callable[[Any], None]
    1: NullaryCallbackType = Callable[[], None]
    1: RequestIterableType = Iterable[Any]
    1: ResponseIterableType = Iterable[Any]
    1: UserTag = Callable[[cygrpc.BaseEvent], bool]
    2: IntegratedCallFactory = Callable[
    2:     [
    1:         int,
    1:         bytes,
    1:         Optional[str],
    1:         Optional[float],
    1:         Optional[MetadataType],
    1:         Optional[cygrpc.CallCredentials],
    1:         Sequence[Sequence[cygrpc.Operation]],
    1:         UserTag,
    1:         Any,
    1:         Optional[int],
           ],
    1:     cygrpc.IntegratedCall,
       ]
    2: ServerTagCallbackType = Tuple[
    1:     Optional["_RPCState"], Sequence[NullaryCallbackType]
       ]
    1: ServerCallbackTag = Callable[[cygrpc.BaseEvent], ServerTagCallbackType]
    2: ArityAgnosticMethodHandler = Union[
    3:     Callable[
    2:         [RequestType, "ServicerContext", Callable[[ResponseType], None]],
    1:         ResponseType,
           ],
    2:     Callable[
    2:         [RequestType, "ServicerContext", Callable[[ResponseType], None]],
    1:         Iterator[ResponseType],
           ],
    2:     Callable[
    2:         [
    1:             Iterator[RequestType],
    1:             "ServicerContext",
    1:             Callable[[ResponseType], None],
               ],
    1:         ResponseType,
           ],
    2:     Callable[
    2:         [
    1:             Iterator[RequestType],
    1:             "ServicerContext",
    1:             Callable[[ResponseType], None],
               ],
    1:         Iterator[ResponseType],
           ],
    1:     Callable[[RequestType, "ServicerContext"], ResponseType],
    1:     Callable[[RequestType, "ServicerContext"], Iterator[ResponseType]],
    1:     Callable[[Iterator[RequestType], "ServicerContext"], ResponseType],
    2:     Callable[
    1:         [Iterator[RequestType], "ServicerContext"], Iterator[ResponseType]
           ],
       ]
