    1: """
           pygments.console
           ~~~~~~~~~~~~~~~~
       
           Format colored console output.
       
           :copyright: Copyright 2006-present by the Pygments team, see AUTHORS.
           :license: BSD, see LICENSE for details.
       """
       
    1: esc = "\x1b["
       
    1: codes = {}
    1: codes[""] = ""
    1: codes["reset"] = esc + "39;49;00m"
       
    1: codes["bold"] = esc + "01m"
    1: codes["faint"] = esc + "02m"
    1: codes["standout"] = esc + "03m"
    1: codes["underline"] = esc + "04m"
    1: codes["blink"] = esc + "05m"
    1: codes["overline"] = esc + "06m"
       
    1: dark_colors = ["black", "red", "green", "yellow", "blue",
                      "magenta", "cyan", "gray"]
    1: light_colors = ["brightblack", "brightred", "brightgreen", "brightyellow", "brightblue",
                       "brightmagenta", "brightcyan", "white"]
       
    1: x = 30
    9: for dark, light in zip(dark_colors, light_colors):
    8:     codes[dark] = esc + "%im" % x
    8:     codes[light] = esc + "%im" % (60 + x)
    8:     x += 1
       
    1: del dark, light, x
       
    1: codes["white"] = codes["bold"]
       
       
    1: def reset_color():
           return codes["reset"]
       
       
    1: def colorize(color_key, text):
           return codes[color_key] + text + codes["reset"]
       
       
    1: def ansiformat(attr, text):
           """
           Format ``text`` with a color and/or some attributes::
       
               color       normal color
               *color*     bold color
               _color_     underlined color
               +color+     blinking color
           """
           result = []
           if attr[:1] == attr[-1:] == '+':
               result.append(codes['blink'])
               attr = attr[1:-1]
           if attr[:1] == attr[-1:] == '*':
               result.append(codes['bold'])
               attr = attr[1:-1]
           if attr[:1] == attr[-1:] == '_':
               result.append(codes['underline'])
               attr = attr[1:-1]
           result.append(codes[attr])
           result.append(text)
           result.append(codes['reset'])
           return ''.join(result)
