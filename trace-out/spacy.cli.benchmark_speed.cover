    2:     no_shuffle: bool = Opt(False, "--no-shuffle", help="Do not shuffle benchmark data"),
    2:     use_gpu: int = Opt(-1, "--gpu-id", "-g", help="GPU ID or -1 for CPU"),
    3:     n_batches: int = Opt(
    1:         50,
    1:         "--batches",
