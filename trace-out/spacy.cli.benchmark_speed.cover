   11: def benchmark_speed_cli(
           # fmt: off
    1:     ctx: typer.Context,
    2:     model: str = Arg(..., help="Model name or path"),
    3:     data_path: Path = Arg(
    1:         ..., help="Location of binary evaluation data in .spacy format", exists=True
