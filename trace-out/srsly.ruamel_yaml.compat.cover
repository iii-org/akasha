    2: class ordereddict(OrderedDict):  # type: ignore
    1:     if not hasattr(OrderedDict, "insert"):
       
    1:         def insert(self, pos, key, value):
                   # type: (int, Any, Any) -> None
                   if pos >= len(self):
                       self[key] = value
                       return
                   od = ordereddict()
                   od.update(self)
                   for k in od:
                       del self[k]
                   for index, old_key in enumerate(od):
                       if pos == index:
                           self[key] = value
                       self[old_key] = od[old_key]
       
       
