    2: class RunConstGraph(HigherOrderOperator):
    1:     def __init__(self) -> None:
    1:         super().__init__("run_const_graph")
       
    1:     def __call__(self, graph: torch.fx.GraphModule, args: tuple[object, ...]) -> object:
               return super().__call__(graph, args)
       
       
    1: run_const_graph = RunConstGraph()
       
       
    2: @run_const_graph.py_impl(ProxyTorchDispatchMode)
    6: def run_const_graph_dispatch_mode(
    3:     mode: ProxyTorchDispatchMode, graph: torch.fx.GraphModule, args: tuple[object, ...]
    1: ) -> object:
           const_gm, weights = graph, args
           p_args = pytree.tree_map(mode.tracer.unwrap_proxy, (graph, args))  # type: ignore[union-attr]
           assert isinstance(const_gm, torch.fx.GraphModule)
           assert not hasattr(mode.tracer.root, "_const_graph")  # type: ignore[union-attr]
           mode.tracer.root.register_module("_const_graph", const_gm)  # type: ignore[union-attr]
       
           proxy = mode.tracer.create_proxy("call_function", run_const_graph, p_args, {})
       
           out = const_gm(*weights)
           return track_tensor_tree(out, proxy, constant=None, tracer=mode.tracer)
       
       
    2: @run_const_graph.py_functionalize_impl
    6: def run_const_graph_functional(
    3:     ctx: "BaseFunctionalizeAPI", graph: torch.fx.GraphModule, args: tuple[Any, ...]
    1: ) -> Any:
           unwrapped_args = ctx.unwrap_tensors(args)
       
           with ctx.redispatch_to_next():
               out = run_const_graph(graph, unwrapped_args)
               return ctx.wrap_tensors(out)  # type: ignore[arg-type]
       
       
    2: run_const_graph.py_autograd_impl(
    1:     autograd_not_implemented(run_const_graph, deferred_error=True)
