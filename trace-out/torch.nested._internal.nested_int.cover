               raise ValueError("ge: relation is indeterminate")
           elif isinstance(rhs, NestedIntNode):
               if lhs.is_constant() and lhs.constant_int() < 2:
                   return False
               raise ValueError("ge: relation is indeterminate")
           else:
               raise ValueError("inputs unsupported")
       
       
