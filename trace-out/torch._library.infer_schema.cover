    1: SUPPORTED_RETURN_TYPES = {
    1:     Tensor: "Tensor",
    1:     typing.List[Tensor]: "Tensor[]",  # noqa: UP006
    1:     list[Tensor]: "Tensor[]",
    1:     int: "SymInt",
    1:     float: "float",
    1:     bool: "bool",
    1:     types.Number: "Scalar",
