               # (python type, schema type, type[] variant, type?[] variant, type[]? variant
    1:         (Tensor, "Tensor", True, True, False),
    1:         (int, "SymInt", True, False, True),
    1:         (float, "float", True, False, True),
    1:         (bool, "bool", True, False, True),
    1:         (str, "str", False, False, False),
    1:         (types.Number, "Scalar", True, False, False),
