    2: class AsyncAcquireSoftReadWriteReturnProxy:
    1:     """Async context-aware object that releases an :class:`AsyncSoftReadWriteLock` on exit."""
       
    1:     def __init__(self, lock: AsyncSoftReadWriteLock) -> None:
               self.lock = lock
       
    1:     async def __aenter__(self) -> AsyncSoftReadWriteLock:
               return self.lock
       
    1:     async def __aexit__(
               self,
               exc_type: type[BaseException] | None,
               exc_value: BaseException | None,
               traceback: TracebackType | None,
