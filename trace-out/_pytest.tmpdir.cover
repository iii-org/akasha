    1:     basetemp = tmp_path_factory._basetemp
    1:     if basetemp is None:
    1:         return
       
           policy = tmp_path_factory._retention_policy
           if (
               exitstatus == 0
               and policy == "failed"
               and tmp_path_factory._given_basetemp is None
