    2: class OpenTelemetryGranularity(Enum):
    1:     """The granularity of the OpenTelemetry spans."""
       
    1:     NONE = "none"
    1:     """No spans are emitted."""
       
    1:     OPERATION = "operation"
    1:     """Spans are emitted for each operation."""
       
    1:     OPERATION_AND_SEGMENT = "operation_and_segment"
    1:     """Spans are emitted for each operation and segment."""
       
    1:     ALL = "all"
    1:     """Spans are emitted for almost every method call."""
       
           # Greater is more restrictive. So "all" < "operation" (and everything else),
           # "none" > everything.
    1:     def __lt__(self, other: Any) -> bool:
               """Compare two granularities."""
               order = [
                   OpenTelemetryGranularity.ALL,
                   OpenTelemetryGranularity.OPERATION_AND_SEGMENT,
                   OpenTelemetryGranularity.OPERATION,
                   OpenTelemetryGranularity.NONE,
               ]
               return order.index(self) < order.index(other)
       
       
    2: class OpenTelemetryClient(Component):
    1:     def __init__(self, system: System):
               super().__init__(system)
               otel_init(
                   system.settings.chroma_otel_service_name,
                   system.settings.chroma_otel_collection_endpoint,
                   system.settings.chroma_otel_collection_headers,
