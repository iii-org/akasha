    1: from abc import ABC, abstractmethod
    1: from typing import Any
       
       
    2: class Pager(ABC):
    1:     """Base class for a pager."""
       
    2:     @abstractmethod
    2:     def show(self, content: str) -> None:
               """Show content in pager.
       
               Args:
                   content (str): Content to be displayed.
               """
       
       
    2: class SystemPager(Pager):
    1:     """Uses the pager installed on the system."""
       
    1:     def _pager(self, content: str) -> Any:  #  pragma: no cover
               return __import__("pydoc").pager(content)
       
    1:     def show(self, content: str) -> None:
               """Use the same pager used by pydoc."""
               self._pager(content)
       
       
    1: if __name__ == "__main__":  # pragma: no cover
           from .__main__ import make_test_card
           from .console import Console
       
           console = Console()
           with console.pager(styles=True):
               console.print(make_test_card())
