    1: from typing import Any, Callable, List, Optional, Sequence, Tuple, TypeVar, cast
       
    1: from ..config import registry
    1: from ..model import Model
       
    1: InItemT = TypeVar("InItemT")
    1: OutItemT = TypeVar("OutItemT")
    1: ItemT = TypeVar("ItemT")
       
    1: NestedT = List[List[ItemT]]
    1: FlatT = List[ItemT]
       
       
    2: @registry.layers("with_flatten.v2")
    4: def with_flatten_v2(
    1:     layer: Model[FlatT[InItemT], FlatT[OutItemT]],
    1: ) -> Model[NestedT[InItemT], NestedT[OutItemT]]:
           return Model(f"with_flatten({layer.name})", forward, layers=[layer], init=init)
       
       
    5: def forward(
    1:     model: Model[NestedT[InItemT], NestedT[OutItemT]],
    1:     Xnest: NestedT[InItemT],
    1:     is_train: bool,
    1: ) -> Tuple[NestedT[OutItemT], Callable]:
           layer: Model[FlatT[InItemT], FlatT[OutItemT]] = model.layers[0]
           Xflat, lens = _flatten(Xnest)
           Yflat, backprop_layer = layer(Xflat, is_train)
           Ynest = _unflatten(Yflat, lens)
       
           def backprop(dYnest: NestedT[InItemT]) -> NestedT[OutItemT]:
               dYflat, _ = _flatten(dYnest)  # type: ignore[arg-type, var-annotated]
               # type ignore necessary for older versions of Mypy/Pydantic
               dXflat = backprop_layer(dYflat)
               dXnest = _unflatten(dXflat, lens)
               return dXnest
       
           return Ynest, backprop
       
       
    1: def _flatten(nested: NestedT[ItemT]) -> Tuple[FlatT[ItemT], List[int]]:
           flat: List = []
           lens: List[int] = []
           for item in nested:
               flat.extend(item)
               lens.append(len(item))
           return cast(FlatT[ItemT], flat), lens
       
       
    1: def _unflatten(flat: FlatT[ItemT], lens: List[int]) -> NestedT[ItemT]:
           nested = []
           for l in lens:
               nested.append(flat[:l])
               flat = flat[l:]
           return nested
       
       
    5: def init(
    1:     model: Model[NestedT[InItemT], NestedT[OutItemT]],
    2:     X: Optional[NestedT[InItemT]] = None,
    2:     Y: Optional[NestedT[OutItemT]] = None,
    1: ) -> None:
           model.layers[0].initialize(
               _flatten(X)[0] if X is not None else None,
               model.layers[0].ops.xp.hstack(Y) if Y is not None else None,
           )
