    2: class DictionaryGenericHandler(grpc.ServiceRpcHandler):
    1:     _name: str
    1:     _method_handlers: Dict[str, grpc.RpcMethodHandler]
       
    3:     def __init__(
    2:         self, service: str, method_handlers: Dict[str, grpc.RpcMethodHandler]
           ):
               self._name = service
