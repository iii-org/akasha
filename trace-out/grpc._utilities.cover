               fn(self)
       
    1:     def start(self):
               with self._condition:
                   self._channel.subscribe(self._update, try_to_connect=True)
       
    1:     def __del__(self):
               with self._condition:
                   if not self._cancelled and not self._matured:
                       self._channel.unsubscribe(self._update)
       
       
    1: def channel_ready_future(channel: grpc.Channel) -> _ChannelReadyFuture:
           ready_future = _ChannelReadyFuture(channel)
           ready_future.start()
           return ready_future
       
       
    1: def first_version_is_lower(version1: str, version2: str) -> bool:
           """
           Compares two versions in the format '1.60.1' or '1.60.1.dev0'.
       
           This method will be used in all stubs generated by grpcio-tools to check whether
           the stub version is compatible with the runtime grpcio.
       
           Args:
               version1: The first version string.
               version2: The second version string.
       
           Returns:
               True if version1 is lower, False otherwise.
           """
    3:     version1_list = version1.split(".")
    3:     version2_list = version2.split(".")
       
    3:     try:
    6:         for i in range(3):
    6:             if int(version1_list[i]) < int(version2_list[i]):
                       return True
    6:             if int(version1_list[i]) > int(version2_list[i]):
    3:                 return False
           except ValueError:
               # Return false in case we can't convert version to int.
               return False
       
           # The version without dev0 will be considered lower.
           return len(version1_list) < len(version2_list)
