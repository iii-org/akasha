       # -*- coding: utf-8 -*-
       
    1: from __future__ import absolute_import
       
    1: from .base import Type
       
       
    2: class Woff(Type):
    1:     """
           Implements the WOFF font type matcher.
           """
    1:     MIME = 'application/font-woff'
    1:     EXTENSION = 'woff'
       
    1:     def __init__(self):
    2:         super(Woff, self).__init__(
    1:             mime=Woff.MIME,
    1:             extension=Woff.EXTENSION
               )
       
    1:     def match(self, buf):
               return (len(buf) > 7 and
                       buf[0] == 0x77 and
                       buf[1] == 0x4F and
                       buf[2] == 0x46 and
                       buf[3] == 0x46 and
                       ((buf[4] == 0x00 and
                         buf[5] == 0x01 and
                         buf[6] == 0x00 and
                         buf[7] == 0x00) or
                        (buf[4] == 0x4F and
                         buf[5] == 0x54 and
                         buf[6] == 0x54 and
                         buf[7] == 0x4F) or
                        (buf[4] == 0x74 and
                         buf[5] == 0x72 and
                         buf[6] == 0x75 and
                         buf[7] == 0x65)))
       
       
    2: class Woff2(Type):
    1:     """
           Implements the WOFF2 font type matcher.
           """
    1:     MIME = 'application/font-woff'
    1:     EXTENSION = 'woff2'
       
    1:     def __init__(self):
    2:         super(Woff2, self).__init__(
    1:             mime=Woff2.MIME,
    1:             extension=Woff2.EXTENSION
               )
       
    1:     def match(self, buf):
               return (len(buf) > 7 and
                       buf[0] == 0x77 and
                       buf[1] == 0x4F and
                       buf[2] == 0x46 and
                       buf[3] == 0x32 and
                       ((buf[4] == 0x00 and
                         buf[5] == 0x01 and
                         buf[6] == 0x00 and
                         buf[7] == 0x00) or
                        (buf[4] == 0x4F and
                         buf[5] == 0x54 and
                         buf[6] == 0x54 and
                         buf[7] == 0x4F) or
                        (buf[4] == 0x74 and
                         buf[5] == 0x72 and
                         buf[6] == 0x75 and
                         buf[7] == 0x65)))
       
       
    2: class Ttf(Type):
    1:     """
           Implements the TTF font type matcher.
           """
    1:     MIME = 'application/font-sfnt'
    1:     EXTENSION = 'ttf'
       
    1:     def __init__(self):
    2:         super(Ttf, self).__init__(
    1:             mime=Ttf.MIME,
    1:             extension=Ttf.EXTENSION
               )
       
    1:     def match(self, buf):
               return (len(buf) > 4 and
                       buf[0] == 0x00 and
                       buf[1] == 0x01 and
                       buf[2] == 0x00 and
                       buf[3] == 0x00 and
                       buf[4] == 0x00)
       
       
    2: class Otf(Type):
    1:     """
           Implements the OTF font type matcher.
           """
    1:     MIME = 'application/font-sfnt'
    1:     EXTENSION = 'otf'
       
    1:     def __init__(self):
    2:         super(Otf, self).__init__(
    1:             mime=Otf.MIME,
    1:             extension=Otf.EXTENSION
               )
       
    1:     def match(self, buf):
               return (len(buf) > 4 and
