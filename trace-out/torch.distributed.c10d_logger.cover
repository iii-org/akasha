   24:     return wrapper
       
       
    1: def _time_logger(func: Callable[_P, _T]) -> Callable[_P, _T]:
   10:     @functools.wraps(func)
   10:     def wrapper(*args: _P.args, **kwargs: _P.kwargs) -> _T:
               with _WaitCounter(f"pytorch.wait_counter.c10d.{func.__name__}").guard():
