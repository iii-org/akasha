    1: __all__: list[str] = []
       
    1: _DEFAULT_DESTINATION = "default"
       
       
    1: def _get_or_create_logger(destination: str = _DEFAULT_DESTINATION) -> logging.Logger:
    1:     logging_handler, log_handler_name = _get_logging_handler(destination)
    1:     logger = logging.getLogger(f"c10d-{log_handler_name}")
