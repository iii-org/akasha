    1: """“结巴 3”中文分词：做最好的 Modern Python 3 中文分词组件"""
       
    1: from typing import Literal
       
    1: from pydantic import BaseModel
       
    1: from jieba3.tok import _cut_query, _cut_text
       
    1: __version__ = "1.0.2"
       
       
    2: class jieba3(BaseModel):
    1:     model: Literal["base", "small", "large"] = "base"
    1:     use_hmm: bool = True
       
    1:     def cut_text(self, sentence: str, /) -> list[str]:
               return list(_cut_text(sentence, model=self.model, use_hmm=self.use_hmm))
       
    1:     def cut_query(self, sentence: str, /) -> list[str]:
               return list(_cut_query(sentence, model=self.model, use_hmm=self.use_hmm))
