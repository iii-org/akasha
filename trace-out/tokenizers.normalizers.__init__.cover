    1: from .. import normalizers
       
       
    1: Normalizer = normalizers.Normalizer
    1: BertNormalizer = normalizers.BertNormalizer
    1: NFD = normalizers.NFD
    1: NFKD = normalizers.NFKD
    1: NFC = normalizers.NFC
    1: NFKC = normalizers.NFKC
    1: Sequence = normalizers.Sequence
    1: Lowercase = normalizers.Lowercase
    1: Prepend = normalizers.Prepend
    1: Strip = normalizers.Strip
    1: StripAccents = normalizers.StripAccents
    1: Nmt = normalizers.Nmt
    1: Precompiled = normalizers.Precompiled
    1: Replace = normalizers.Replace
    1: ByteLevel = normalizers.ByteLevel
       
    1: NORMALIZERS = {"nfc": NFC, "nfd": NFD, "nfkc": NFKC, "nfkd": NFKD}
       
       
    1: def unicode_normalizer_from_str(normalizer: str) -> Normalizer:
           if normalizer not in NORMALIZERS:
               raise ValueError(
                   "{} is not a known unicode normalizer. Available are {}".format(normalizer, NORMALIZERS.keys())
               )
       
           return NORMALIZERS[normalizer]()
