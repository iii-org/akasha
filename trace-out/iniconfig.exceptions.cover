    1: from typing import Final
       
       
    2: class ParseError(Exception):
    1:     path: Final[str]
    1:     lineno: Final[int]
    1:     msg: Final[str]
       
    1:     def __init__(self, path: str, lineno: int, msg: str) -> None:
               super().__init__(path, lineno, msg)
               self.path = path
               self.lineno = lineno
               self.msg = msg
       
    1:     def __str__(self) -> str:
               return f"{self.path}:{self.lineno + 1}: {self.msg}"
