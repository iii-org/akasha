 1024:     for op, av in pattern.data:
 1003:         if op is LITERAL:
  413:             if iscased and iscased(av):
   13:                 break
  400:             prefixappend(av)
  590:         elif op is SUBPATTERN:
  135:             group, add_flags, del_flags, p = av
  135:             flags1 = _combine_flags(flags, add_flags, del_flags)
  135:             if flags1 & SRE_FLAG_IGNORECASE and flags1 & SRE_FLAG_LOCALE:
                       break
  135:             prefix1, prefix_skip1, got_all = _get_literal_prefix(p, flags1)
  135:             if prefix_skip is None:
  135:                 if group is not None:
  121:                     prefix_skip = len(prefix)
   14:                 elif prefix_skip1 is not None:
                           prefix_skip = len(prefix) + prefix_skip1
  135:             prefix.extend(prefix1)
  135:             if not got_all:
  128:                 break
               else:
  455:             break
           else:
   21:         return prefix, prefix_skip, True
  596:     return prefix, prefix_skip, False
       
