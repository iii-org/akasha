  179:                 tail.append((op, av))
 5959:             break
       
           # compress character map
 1888:     runs = []
 1888:     q = 0
 4375:     while True:
 4375:         p = charmap.find(1, q)
 4375:         if p < 0:
 1481:             break
 2894:         if len(runs) >= 2:
  405:             runs = None
  405:             break
 2489:         q = charmap.find(0, p)
 2489:         if q < 0:
    2:             runs.append((p, len(charmap)))
    2:             break
 2487:         runs.append((p, q))
 1888:     if runs is not None:
               # use literal/range
 3162:         for p, q in runs:
 1679:             if q - p == 1:
  907:                 out.append((LITERAL, p))
                   else:
  772:                 out.append((RANGE, (p, q - 1)))
 1483:         out += tail
               # if the case was changed or new representation is more compact
 1483:         if hascased or len(out) < len(charset):
  286:             return out, hascased
               # else original character set is good enough
 1197:         return charset, hascased
       
           # use bitmap
  405:     if len(charmap) == 256:
  371:         data = _mk_bitmap(charmap)
  371:         out.append((CHARSET, data))
  371:         out += tail
  371:         return out, hascased
       
           # To represent a big charset, first a bitmap of all characters in the
           # set is constructed. Then, this bitmap is sliced into chunks of 256
           # characters, duplicate chunks are eliminated, and each chunk is
           # given a number. In the compiled expression, the charset is
           # represented by a 32-bit word sequence, consisting of one word for
           # the number of different chunks, a sequence of 256 bytes (64 words)
           # of chunk numbers indexed by their original chunk position, and a
           # sequence of 256-bit chunks (8 words each).
       
           # Compression is normally good: in a typical charset, large ranges of
           # Unicode will be either completely excluded (e.g. if only cyrillic
           # letters are to be matched), or completely included (e.g. if large
           # subranges of Kanji match). These ranges will be represented by
           # chunks of all one-bits or all zero-bits.
       
           # Matching can be also done efficiently: the more significant byte of
           # the Unicode character is an index into the chunk number, and the
           # less significant byte is a bit index in the chunk (just like the
           # CHARSET matching).
       
   34:     charmap = bytes(charmap) # should be hashable
   34:     comps = {}
   34:     mapping = bytearray(256)
   34:     block = 0
   34:     data = bytearray()
 8738:     for i in range(0, 65536, 256):
 8704:         chunk = charmap[i: i + 256]
 8704:         if chunk in comps:
 8533:             mapping[i // 256] = comps[chunk]
               else:
  171:             mapping[i // 256] = comps[chunk] = block
  171:             block += 1
  171:             data += chunk
   34:     data = _mk_bitmap(data)
   34:     data[0:0] = [block] + _bytes_to_codes(mapping)
   34:     out.append((BIGCHARSET, data))
   34:     out += tail
   34:     return out, hascased
       
       _CODEBITS = _sre.CODESIZE * 8
       MAXCODE = (1 << _CODEBITS) - 1
       _BITS_TRANS = b'0' + b'1' * 255
       def _mk_bitmap(bits, _CODEBITS=_CODEBITS, _int=int):
  405:     s = bits.translate(_BITS_TRANS)[::-1]
 9887:     return [_int(s[i - _CODEBITS: i], 2)
 4741:             for i in range(len(s), 0, -_CODEBITS)]
       
       def _bytes_to_codes(b):
           # Convert block indices to word array
   34:     a = memoryview(b).cast('I')
   34:     assert a.itemsize == _sre.CODESIZE
   34:     assert len(a) * a.itemsize == len(b)
   34:     return a.tolist()
       
       def _simple(p):
           # check if this subpattern is a "simple" operator
 2166:     if len(p) != 1:
  326:         return False
 1840:     op, av = p[0]
 1840:     if op is SUBPATTERN:
  106:         return av[0] is None and _simple(av[-1])
 1734:     return op in _UNIT_CODES
       
       def _generate_overlap_table(prefix):
           """
           Generate an overlap table for the following prefix.
           An overlap table is a table of the same size as the prefix which
           informs about the potential self-overlap for each index in the prefix:
           - if overlap[i] == 0, prefix[i:] can't overlap prefix[0:...]
           - if overlap[i] == k with 0 < k <= i, prefix[i-k+1:i+1] overlaps with
             prefix[0:k]
           """
  136:     table = [0] * len(prefix)
  400:     for i in range(1, len(prefix)):
  264:         idx = table[i - 1]
  266:         while prefix[i] != prefix[idx]:
  252:             if idx == 0:
  250:                 table[i] = 0
  250:                 break
    2:             idx = table[idx - 1]
               else:
   14:             table[i] = idx + 1
  136:     return table
       
       def _get_iscased(flags):
  963:     if not flags & SRE_FLAG_IGNORECASE:
  804:         return None
  159:     elif flags & SRE_FLAG_UNICODE:
  149:         return _sre.unicode_iscased
           else:
   10:         return _sre.ascii_iscased
       
       def _get_literal_prefix(pattern, flags):
