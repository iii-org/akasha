       def _compile_charset(charset, flags, code):
           # compile charset subprogram
 1888:     emit = code.append
 4948:     for op, av in charset:
 3060:         emit(op)
 3060:         if op is NEGATE:
  236:             pass
 2824:         elif op is LITERAL:
 1005:             emit(av)
 1819:         elif op is RANGE or op is RANGE_UNI_IGNORE:
  853:             emit(av[0])
  853:             emit(av[1])
  966:         elif op is CHARSET:
  371:             code.extend(av)
  595:         elif op is BIGCHARSET:
   34:             code.extend(av)
  561:         elif op is CATEGORY:
  561:             if flags & SRE_FLAG_LOCALE:
                       emit(CH_LOCALE[av])
  561:             elif flags & SRE_FLAG_UNICODE:
  450:                 emit(CH_UNICODE[av])
                   else:
  111:                 emit(av)
               else:
                   raise error("internal: unsupported set operator %r" % (op,))
 1888:     emit(FAILURE)
       
       def _optimize_charset(charset, iscased=None, fixup=None, fixes=None):
           # internal: optimize character set
 1888:     out = []
 1888:     tail = []
 1888:     charmap = bytearray(256)
 1888:     hascased = False
 7847:     for op, av in charset:
 5994:         while True:
 5994:             try:
 5994:                 if op is LITERAL:
 3475:                     if fixup:
  973:                         lo = fixup(av)
  973:                         charmap[lo] = 1
  973:                         if fixes and lo in fixes:
   13:                             for k in fixes[lo]:
    8:                                 charmap[k] = 1
  970:                         if not hascased and iscased(av):
    3:                             hascased = True
                           else:
 2502:                         charmap[av] = 1
 2519:                 elif op is RANGE:
 1722:                     r = range(av[0], av[1]+1)
 1722:                     if fixup:
  367:                         if fixes:
 5670:                             for i in map(fixup, r):
 5372:                                 charmap[i] = 1
 5372:                                 if i in fixes:
   89:                                     for k in fixes[i]:
   53:                                         charmap[k] = 1
                               else:
  828:                             for i in map(fixup, r):
  776:                                 charmap[i] = 1
  350:                         if not hascased:
  288:                             hascased = any(map(iscased, r))
                           else:
429268:                         for i in r:
428005:                             charmap[i] = 1
  797:                 elif op is NEGATE:
  236:                     out.append((op, av))
                       else:
  561:                     tail.append((op, av))
  214:             except IndexError:
  214:                 if len(charmap) == 256:
                           # character set contains non-UCS1 character codes
   35:                     charmap += b'\0' * 0xff00
   35:                     continue
                       # Character set contains non-BMP character codes.
                       # For range, all BMP characters in the range are already
                       # proceeded.
  179:                 if fixup:
                           hascased = True
                           # For now, IN_UNI_IGNORE+LITERAL and
                           # IN_UNI_IGNORE+RANGE_UNI_IGNORE work for all non-BMP
                           # characters, because two characters (at least one of
                           # which is not in the BMP) match case-insensitively
                           # if and only if:
                           # 1) c1.lower() == c2.lower()
                           # 2) c1.lower() == c2 or c1.lower().upper() == c2
                           # Also, both c.lower() and c.lower().upper() are single
                           # characters for every non-BMP character.
                           if op is RANGE:
