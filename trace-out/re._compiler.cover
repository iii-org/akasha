 1579:                 code[skip] = _len(code) - skip
                   else:
  572:                 emit(REPEATING_CODES[op][0])
  572:                 skip = _len(code); emit(0)
  572:                 emit(av[0])
  572:                 emit(av[1])
  572:                 _compile(code, av[2], flags)
