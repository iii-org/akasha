    1: """Constants used for Pregel operations."""
       
    1: import sys
    1: from typing import Literal, cast
       
       # --- Reserved write keys ---
    1: INPUT = sys.intern("__input__")
       # for values passed as input to the graph
    1: INTERRUPT = sys.intern("__interrupt__")
       # for dynamic interrupts raised by nodes
    1: RESUME = sys.intern("__resume__")
       # for values passed to resume a node after an interrupt
    1: ERROR = sys.intern("__error__")
       # for errors raised by nodes
    1: ERROR_SOURCE_NODE = sys.intern("__error_source_node__")
       # failed source node name for node-level error handlers
       # value format in pending writes: `(task_id, ERROR_SOURCE_NODE, node_name: str)`
    1: NO_WRITES = sys.intern("__no_writes__")
       # marker to signal node didn't write anything
    1: TASKS = sys.intern("__pregel_tasks")
       # for Send objects returned by nodes/edges, corresponds to PUSH below
    1: RETURN = sys.intern("__return__")
       # for writes of a task where we simply record the return value
    1: PREVIOUS = sys.intern("__previous__")
       # the implicit branch that handles each node's Control values
       
       
       # --- Reserved cache namespaces ---
    1: CACHE_NS_WRITES = sys.intern("__pregel_ns_writes")
       # cache namespace for node writes
       
       # --- Reserved config.configurable keys ---
    1: CONFIG_KEY_SEND = sys.intern("__pregel_send")
       # holds the `write` function that accepts writes to state/edges/reserved keys
    1: CONFIG_KEY_READ = sys.intern("__pregel_read")
       # holds the `read` function that returns a copy of the current state
    1: CONFIG_KEY_CALL = sys.intern("__pregel_call")
       # holds the `call` function that accepts a node/func, args and returns a future
    1: CONFIG_KEY_CHECKPOINTER = sys.intern("__pregel_checkpointer")
       # holds a `BaseCheckpointSaver` passed from parent graph to child graphs
    1: CONFIG_KEY_STREAM = sys.intern("__pregel_stream")
       # holds a `StreamProtocol` passed from parent graph to child graphs
    1: CONFIG_KEY_CACHE = sys.intern("__pregel_cache")
       # holds a `BaseCache` made available to subgraphs
    1: CONFIG_KEY_RESUMING = sys.intern("__pregel_resuming")
       # holds a boolean indicating if subgraphs should resume from a previous checkpoint
    1: CONFIG_KEY_REPLAY_STATE = sys.intern("__pregel_replay_state")
       # holds a ReplayState tracking the parent checkpoint_id upper bound and which
       # subgraph namespaces have already loaded their pre-replay checkpoint
    1: CONFIG_KEY_TASK_ID = sys.intern("__pregel_task_id")
       # holds the task ID for the current task
    1: CONFIG_KEY_THREAD_ID = sys.intern("thread_id")
       # holds the thread ID for the current invocation
    1: CONFIG_KEY_CHECKPOINT_MAP = sys.intern("checkpoint_map")
       # holds a mapping of checkpoint_ns -> checkpoint_id for parent graphs
    1: CONFIG_KEY_CHECKPOINT_ID = sys.intern("checkpoint_id")
       # holds the current checkpoint_id, if any
    1: CONFIG_KEY_CHECKPOINT_NS = sys.intern("checkpoint_ns")
       # holds the current checkpoint_ns, "" for root graph
    1: CONFIG_KEY_NODE_FINISHED = sys.intern("__pregel_node_finished")
       # holds a callback to be called when a node is finished
    1: CONFIG_KEY_TIMED_ATTEMPT_OBSERVER = sys.intern("__pregel_timed_attempt_observer")
       # holds a callback to be called when an idle-timed node attempt starts or finishes
    1: CONFIG_KEY_SCRATCHPAD = sys.intern("__pregel_scratchpad")
       # holds a mutable dict for temporary storage scoped to the current task
    1: CONFIG_KEY_RUNNER_SUBMIT = sys.intern("__pregel_runner_submit")
       # holds a function that receives tasks from runner, executes them and returns results
    1: CONFIG_KEY_DURABILITY = sys.intern("__pregel_durability")
       # holds the durability mode, one of "sync", "async", or "exit"
    1: CONFIG_KEY_RUNTIME = sys.intern("__pregel_runtime")
       # holds a `Runtime` instance with context, store, stream writer, etc.
    1: CONFIG_KEY_RESUME_MAP = sys.intern("__pregel_resume_map")
       # holds a mapping of task ns -> resume value for resuming tasks
    1: CONFIG_KEY_STREAM_MESSAGES_V2 = sys.intern("__pregel_stream_messages_v2")
       # when True, attach StreamMessagesHandlerV2 so content-block (v2) events
       # flow through stream_mode="messages"; set by StreamingHandler only.
    1: CONFIG_KEY_NODE_ERROR = sys.intern("__pregel_node_error")
       # holds a `NodeError` (failed source node + exception) for the current
       # node-level error handler invocation, injected when handler signature
       # requests `error: NodeError`
       
       # --- Other constants ---
    1: PUSH = sys.intern("__pregel_push")
       # denotes push-style tasks, ie. those created by Send objects
    1: PULL = sys.intern("__pregel_pull")
       # denotes pull-style tasks, ie. those triggered by edges
    1: NS_SEP = sys.intern("|")
       # for checkpoint_ns, separates each level (ie. graph|subgraph|subsubgraph)
    1: NS_END = sys.intern(":")
       # for checkpoint_ns, for each level, separates the namespace from the task_id
    1: CONF = cast(Literal["configurable"], sys.intern("configurable"))
       # key for the configurable dict in RunnableConfig
    1: NULL_TASK_ID = sys.intern("00000000-0000-0000-0000-000000000000")
       # the task_id to use for writes that are not associated with a task
    1: OVERWRITE = sys.intern("__overwrite__")
       # dict key for the overwrite value, used as `{'__overwrite__': value}`
       
       # Checkpoint coordinate keys: when any of these appear in an explicit
       # configurable, the caller is addressing its own checkpoint lineage.
    1: _CHECKPOINT_COORDINATE_KEYS = (
    1:     CONFIG_KEY_THREAD_ID,
    1:     CONFIG_KEY_CHECKPOINT_NS,
    1:     CONFIG_KEY_CHECKPOINT_ID,
    1:     CONFIG_KEY_CHECKPOINT_MAP,
       )
       
       # redefined to avoid circular import with langgraph.constants
    1: _TAG_HIDDEN = sys.intern("langsmith:hidden")
       
    1: RESERVED = {
    1:     _TAG_HIDDEN,
           # reserved write keys
    1:     INPUT,
    1:     INTERRUPT,
    1:     RESUME,
    1:     ERROR,
    1:     ERROR_SOURCE_NODE,
    1:     NO_WRITES,
           # reserved config.configurable keys
    1:     CONFIG_KEY_SEND,
    1:     CONFIG_KEY_READ,
    1:     CONFIG_KEY_CHECKPOINTER,
    1:     CONFIG_KEY_STREAM,
    1:     CONFIG_KEY_CHECKPOINT_MAP,
    1:     CONFIG_KEY_RESUMING,
    1:     CONFIG_KEY_REPLAY_STATE,
    1:     CONFIG_KEY_TASK_ID,
    1:     CONFIG_KEY_CHECKPOINT_MAP,
    1:     CONFIG_KEY_CHECKPOINT_ID,
    1:     CONFIG_KEY_CHECKPOINT_NS,
    1:     CONFIG_KEY_TIMED_ATTEMPT_OBSERVER,
    1:     CONFIG_KEY_RESUME_MAP,
    1:     CONFIG_KEY_STREAM_MESSAGES_V2,
           # other constants
    1:     PUSH,
    1:     PULL,
    1:     NS_SEP,
    1:     NS_END,
    1:     CONF,
       }
