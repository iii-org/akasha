    1: from typing import Any, List, Optional, Tuple
    1: from pydantic import Field
    1: import numpy as np
       
    1: from langchain_core.retrievers import BaseRetriever
    1: from langchain_core.documents import Document
    1: from akasha.helper.base import jieba_tokenizer
    1: from rank_bm25 import BM25Okapi
       
       
    2: class myBM25Retriever(BaseRetriever):
    1:     bm25: BM25Okapi = Field(default=None)
    1:     """BM25 class to use."""
    1:     texts: List[str] = Field(default=None)
    1:     """List of texts to index."""
    1:     metadata: List[dict] = Field(default=None)
    1:     docs: List[Document] = Field(default=None)
    1:     k: int = 3
    1:     """Number of results to return."""
    1:     relevancy_threshold: Optional[float] = None
       
    2:     @classmethod
    7:     def from_documents(
               cls,
    1:         docs: List[Document],
    2:         k: int = 3,
    2:         relevancy_threshold: float = 0.0,
    1:         **kwargs: Any,
    1:     ) -> BaseRetriever:
               tokenize_corpus = [
                   jieba_tokenizer.cut_text(doc.page_content) for doc in docs
               ]
               bm25 = BM25Okapi(tokenize_corpus)
               return cls(
                   bm25=bm25,
                   texts=[doc.page_content for doc in docs],
                   metadata=[doc.metadata for doc in docs],
                   k=k,
                   docs=docs,
                   relevancy_threshold=relevancy_threshold,
                   **kwargs,
               )
       
    1:     def _gs(self, query: str) -> Tuple[List[Document], List[float]]:
               """implement bm25 to find relevant documents
       
               Args:
                   **query (str)**: query string that used to find relevant documents\n
       
               Returns:
                   List[Document]: relevant documents
               """
       
               tokenize_query = jieba_tokenizer.cut_text(query)
               docs_scores = self.bm25.get_scores(tokenize_query)
               top_k_idx = np.argsort(docs_scores)[::-1][:self.k]
               top_k_results = [self.docs[i] for i in top_k_idx]
               top_k_scores = [docs_scores[i] for i in top_k_idx]
               return top_k_results, top_k_scores
       
    3:     def get_relevant_documents_and_scores(
               self,
    1:         query: str,
    1:     ) -> Tuple[List[Document], List[float]]:
               return self._gs(query)
       
    1:     async def _aget_relevant_documents(self, query: str) -> List[Document]:
               return self._gs(query)[0]
       
    1:     def _get_relevant_documents(self, query: str) -> List[Document]:
               return self._gs(query)[0]
