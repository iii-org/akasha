    1: """Latex text splitter."""
       
    1: from __future__ import annotations
       
    1: from typing import Any
       
    1: from langchain_text_splitters.base import Language
    1: from langchain_text_splitters.character import RecursiveCharacterTextSplitter
       
       
    2: class LatexTextSplitter(RecursiveCharacterTextSplitter):
    1:     """Attempts to split the text along Latex-formatted layout elements."""
       
    1:     def __init__(self, **kwargs: Any) -> None:
               """Initialize a LatexTextSplitter."""
               separators = self.get_separators_for_language(Language.LATEX)
               super().__init__(separators=separators, **kwargs)
