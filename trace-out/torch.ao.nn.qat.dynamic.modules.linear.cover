    1: from typing import Optional, TYPE_CHECKING
       
    1: import torch
       
       
    1: if TYPE_CHECKING:
           from torch.ao.quantization.qconfig import QConfig
       
       
    1: __all__ = ["Linear"]
       
       
    2: class Linear(torch.ao.nn.qat.Linear):
    1:     r"""
           A linear module attached with FakeQuantize modules for weight,
