    2:         dtype: str | None = None,
    1:     ) -> None:
               super().__init__(in_features, out_features, bias, qconfig, device, dtype)
               if not torch.ao.quantization.qconfig._activation_is_memoryless(qconfig):  # type: ignore[arg-type]
                   raise ValueError(
