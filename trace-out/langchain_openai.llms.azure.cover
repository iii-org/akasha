    1: from typing_extensions import Self
       
    1: from langchain_openai._version import __version__
    1: from langchain_openai.llms.base import BaseOpenAI
       
    1: logger = logging.getLogger(__name__)
       
       
    2: class AzureOpenAI(BaseOpenAI):
    1:     """Azure-specific OpenAI large language models.
       
           To use, you should have the `openai` python package installed, and the
           environment variable `OPENAI_API_KEY` set with your API key.
       
           Any parameters that are valid to be passed to the openai.create call can be passed
           in, even if not explicitly saved on this class.
       
           Example:
               ```python
               from langchain_openai import AzureOpenAI
       
               openai = AzureOpenAI(model_name="gpt-3.5-turbo-instruct")
               ```
           """
       
    2:     azure_endpoint: str | None = Field(
    1:         default_factory=from_env("AZURE_OPENAI_ENDPOINT", default=None)
           )
    1:     """Your Azure endpoint, including the resource.
       
               Automatically inferred from env var `AZURE_OPENAI_ENDPOINT` if not provided.
       
               Example: `'https://example-resource.azure.openai.com/'`
           """
    1:     deployment_name: str | None = Field(default=None, alias="azure_deployment")
    1:     """A model deployment.
       
               If given sets the base client URL to include `/deployments/{azure_deployment}`.
       
               !!! note
                   This means you won't be able to use non-deployment endpoints.
       
           """
    2:     openai_api_version: str | None = Field(
    1:         alias="api_version",
    1:         default_factory=from_env("OPENAI_API_VERSION", default=None),
           )
    1:     """Automatically inferred from env var `OPENAI_API_VERSION` if not provided."""
           # Check OPENAI_KEY for backwards compatibility.
           # TODO: Remove OPENAI_API_KEY support to avoid possible conflict when using
           # other forms of azure credentials.
    2:     openai_api_key: SecretStr | None = Field(
    1:         alias="api_key",
    2:         default_factory=secret_from_env(
    1:             ["AZURE_OPENAI_API_KEY", "OPENAI_API_KEY"], default=None
               ),
           )
    2:     azure_ad_token: SecretStr | None = Field(
    1:         default_factory=secret_from_env("AZURE_OPENAI_AD_TOKEN", default=None)
           )
    1:     """Your Azure Active Directory token.
       
               Automatically inferred from env var `AZURE_OPENAI_AD_TOKEN` if not provided.
       
