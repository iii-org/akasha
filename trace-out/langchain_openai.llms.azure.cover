    1: """Azure OpenAI large language models. Not to be confused with chat models."""
       
    1: from __future__ import annotations
       
    1: import logging
    1: from collections.abc import Awaitable, Callable, Mapping
    1: from typing import Any, cast
       
    1: import openai
    1: from langchain_core.language_models import LangSmithParams
