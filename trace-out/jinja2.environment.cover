    2:         finalize: t.Optional[t.Callable[..., t.Any]] = None,
    2:         autoescape: t.Union[bool, t.Callable[[t.Optional[str]], bool]] = False,
    2:         loader: t.Optional["BaseLoader"] = None,
    2:         cache_size: int = 400,
    2:         auto_reload: bool = True,
    2:         bytecode_cache: t.Optional["BytecodeCache"] = None,
    2:         enable_async: bool = False,
           ):
               # !!Important notice!!
               #   The constructor accepts quite a few arguments that should be
               #   passed by keyword rather than position.  However it's important to
               #   not change the order of arguments because it's used at least
               #   internally in those cases:
               #       -   spontaneous environments (i18n extension and Template)
               #       -   unittests
