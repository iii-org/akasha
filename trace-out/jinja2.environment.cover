                   Tests support ``@pass_context``, etc. decorators. Added
                   the ``context`` and ``eval_ctx`` parameters.
       
               .. versionadded:: 2.7
               """
               return self._filter_test_common(
                   name, value, args, kwargs, context, eval_ctx, False
               )
       
