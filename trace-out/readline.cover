       # -*- coding: UTF-8 -*-
       # this file is needed in site-packages to emulate readline
       # necessary for rlcompleter since it relies on the existence
       # of a readline module
       
       
    1: from pyreadline3.rlmain import Readline
       
       # Backend identifier for CPython compatibility (used by cmd.py, pdb, etc.)
    1: backend = "pyreadline"
       
    1: __all__ = [
           "backend",
           "parse_and_bind",
           "get_line_buffer",
           "insert_text",
           "clear_history",
           "read_init_file",
           "read_history_file",
           "write_history_file",
           "get_current_history_length",
           "get_history_length",
           "get_history_item",
