    1: """Internal representation of a structured query language."""
       
    1: from __future__ import annotations
       
    1: from abc import ABC, abstractmethod
    1: from enum import Enum
    1: from typing import TYPE_CHECKING, Any
       
    1: from pydantic import BaseModel
       
    1: if TYPE_CHECKING:
           from collections.abc import Sequence
       
       
    2: class Visitor(ABC):
    1:     """Defines interface for IR translation using a visitor pattern."""
       
    1:     allowed_comparators: Sequence[Comparator] | None = None
    1:     """Allowed comparators for the visitor."""
       
    1:     allowed_operators: Sequence[Operator] | None = None
    1:     """Allowed operators for the visitor."""
       
    1:     def _validate_func(self, func: Operator | Comparator) -> None:
               if (
                   isinstance(func, Operator)
                   and self.allowed_operators is not None
                   and func not in self.allowed_operators
               ):
                   msg = (
                       f"Received disallowed operator {func}. Allowed "
                       f"comparators are {self.allowed_operators}"
                   )
                   raise ValueError(msg)
               if (
                   isinstance(func, Comparator)
                   and self.allowed_comparators is not None
                   and func not in self.allowed_comparators
               ):
                   msg = (
                       f"Received disallowed comparator {func}. Allowed "
                       f"comparators are {self.allowed_comparators}"
                   )
                   raise ValueError(msg)
       
    2:     @abstractmethod
    2:     def visit_operation(self, operation: Operation) -> Any:
               """Translate an Operation.
       
               Args:
                   operation: Operation to translate.
               """
       
    2:     @abstractmethod
    2:     def visit_comparison(self, comparison: Comparison) -> Any:
               """Translate a Comparison.
       
               Args:
                   comparison: Comparison to translate.
               """
       
    2:     @abstractmethod
    2:     def visit_structured_query(self, structured_query: StructuredQuery) -> Any:
               """Translate a StructuredQuery.
       
               Args:
                   structured_query: StructuredQuery to translate.
               """
       
       
    1: def _to_snake_case(name: str) -> str:
           """Convert a name into snake_case."""
           snake_case = ""
           for i, char in enumerate(name):
               if char.isupper() and i != 0:
                   snake_case += "_" + char.lower()
               else:
                   snake_case += char.lower()
           return snake_case
       
       
    2: class Expr(BaseModel):
    1:     """Base class for all expressions."""
       
    1:     def accept(self, visitor: Visitor) -> Any:
               """Accept a visitor.
       
               Args:
                   visitor: visitor to accept.
       
               Returns:
                   result of visiting.
               """
               return getattr(visitor, f"visit_{_to_snake_case(self.__class__.__name__)}")(
                   self
               )
       
       
    2: class Operator(str, Enum):
    1:     """Enumerator of the operations."""
       
    1:     AND = "and"
    1:     OR = "or"
    1:     NOT = "not"
       
       
    2: class Comparator(str, Enum):
    1:     """Enumerator of the comparison operators."""
       
    1:     EQ = "eq"
    1:     NE = "ne"
    1:     GT = "gt"
    1:     GTE = "gte"
    1:     LT = "lt"
    1:     LTE = "lte"
    1:     CONTAIN = "contain"
    1:     LIKE = "like"
    1:     IN = "in"
    1:     NIN = "nin"
       
       
    2: class FilterDirective(Expr, ABC):
    1:     """Filtering expression."""
       
       
    2: class Comparison(FilterDirective):
    1:     """Comparison to a value."""
       
    1:     comparator: Comparator
    1:     """The comparator to use."""
       
    1:     attribute: str
    1:     """The attribute to compare."""
       
    1:     value: Any
    1:     """The value to compare to."""
       
    1:     def __init__(
               self, comparator: Comparator, attribute: str, value: Any, **kwargs: Any
           ) -> None:
               """Create a Comparison.
       
               Args:
                   comparator: The comparator to use.
                   attribute: The attribute to compare.
                   value: The value to compare to.
               """
               # super exists from BaseModel
               super().__init__(
                   comparator=comparator, attribute=attribute, value=value, **kwargs
               )
       
       
    2: class Operation(FilterDirective):
    1:     """Logical operation over other directives."""
       
    1:     operator: Operator
    1:     """The operator to use."""
       
    1:     arguments: list[FilterDirective]
    1:     """The arguments to the operator."""
       
    1:     def __init__(
               self, operator: Operator, arguments: list[FilterDirective], **kwargs: Any
           ) -> None:
               """Create an Operation.
       
               Args:
                   operator: The operator to use.
                   arguments: The arguments to the operator.
               """
               # super exists from BaseModel
               super().__init__(operator=operator, arguments=arguments, **kwargs)
       
       
    2: class StructuredQuery(Expr):
    1:     """Structured query."""
       
    1:     query: str
    1:     """Query string."""
       
    1:     filter: FilterDirective | None
    1:     """Filtering expression."""
       
    1:     limit: int | None
    1:     """Limit on the number of results."""
       
    1:     def __init__(
               self,
               query: str,
               filter: FilterDirective | None,  # noqa: A002
    1:         limit: int | None = None,
               **kwargs: Any,
           ) -> None:
               """Create a StructuredQuery.
       
               Args:
                   query: The query string.
                   filter: The filtering expression.
                   limit: The limit on the number of results.
               """
               # super exists from BaseModel
               super().__init__(query=query, filter=filter, limit=limit, **kwargs)
