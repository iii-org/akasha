    1: import enum
       
       
    1: __all__ = [
    1:     "QuantType",
       ]
       
       
       # Quantization type (dynamic quantization, static quantization).
       # Should match the c++ enum in quantization_type.h
    2: class QuantType(enum.IntEnum):
    1:     DYNAMIC = 0
    1:     STATIC = 1
    1:     QAT = 2
    1:     WEIGHT_ONLY = 3
       
       
    1: _quant_type_to_str = {
    1:     QuantType.STATIC: "static",
    1:     QuantType.DYNAMIC: "dynamic",
    1:     QuantType.QAT: "qat",
    1:     QuantType.WEIGHT_ONLY: "weight_only",
       }
       
       
       # TODO: make this private
    1: def _get_quant_type_to_str(quant_type: QuantType) -> str:
           return _quant_type_to_str[quant_type]
       
       
    1: def _quant_type_from_str(name: str) -> QuantType:
           for quant_type, s in _quant_type_to_str.items():
               if name == s:
                   return quant_type
           raise ValueError(f"Unknown QuantType name '{name}'")
