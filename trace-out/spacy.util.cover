    1: def to_ternary_int(val) -> int:
           """Convert a value to the ternary 1/0/-1 int used for True/None/False in
           attributes such as SENT_START: True/1/1.0 is 1 (True), None/0/0.0 is 0
           (None), any other values are -1 (False).
           """
           if val is True:
               return 1
           elif val is None:
               return 0
           elif val is False:
               return -1
           elif val == 1:
               return 1
           elif val == 0:
               return 0
           else:
               return -1
       
       
