                   sys.stdin.read(), overrides=overrides, interpolate=interpolate
               )
           else:
    1:         if not config_path or not config_path.is_file():
                   raise IOError(Errors.E053.format(path=config_path, name="config file"))
    2:         return config.from_disk(
    1:             config_path, overrides=overrides, interpolate=interpolate
               )
       
       
    4: def load_config_from_str(
    4:     text: str, overrides: Dict[str, Any] = SimpleFrozenDict(), interpolate: bool = False
