    5: def from_dict(
    1:     msg: Dict[str, Any],
    1:     setters: Dict[str, Callable[[Any], Any]],
    1:     exclude: Iterable[str],
    1: ) -> Dict[str, Any]:
           for key, setter in setters.items():
               # Split to support file names like meta.json
               if key.split(".")[0] not in exclude and key in msg:
                   setter(msg[key])
