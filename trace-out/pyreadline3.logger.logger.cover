    1: import logging
    1: import os
       
    1: from .null_handler import NULLHandler
       
    1: _default_log_level = os.environ.get("PYREADLINE_LOG", "DEBUG")
       
    1: LOGGER = logging.getLogger("PYREADLINE")
    1: LOGGER.setLevel(_default_log_level)
    1: LOGGER.propagate = False
    1: LOGGER.addHandler(NULLHandler())
