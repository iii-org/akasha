    1:                 + "_"
    1:                 + str(chunk_size)
                   )
    1:             return storage_directory
               else:
    2:             dir_path = Path(dir_path)
       
    2:     if dir_path != Path("."):
    2:         db_dir = "-".join(
    4:             [part.replace(" ", "").replace("_", "") for part in dir_path.parts if part]
               )
           else:
    1:         db_dir = NO_PARENT_DIR_NAME
       
    2:     storage_directory = (
   16:         "chromadb/"
    2:         + db_dir
    2:         + "_"
    2:         + embed_type
    2:         + "_"
