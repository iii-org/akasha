    6: def get_storage_directory(
    1:     dir_path: Union[Path, str],
    1:     chunk_size: int,
    1:     embed_type: str,
    1:     embed_name: str,
    1: ) -> str:
    3:     if isinstance(dir_path, str):
    3:         if is_url(dir_path):
    1:             sanitized_dir_path = _sanitize_path_string(dir_path)
    1:             storage_directory = (
    8:                 "chromadb/"
    1:                 + sanitized_dir_path
    1:                 + "_"
    1:                 + embed_type
    1:                 + "_"
