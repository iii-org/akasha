    2:         + str(chunk_size)
           )
       
    2:     return storage_directory
       
       
    1: def _sanitize_path_string(path: str, max_len: int = 30) -> str:
           # Remove special characters and limit length to 30
    2:     sanitized = re.sub(r"[^a-zA-Z0-9]", "", path)[:max_len]
    2:     return sanitized
       
       
    1: def is_url(pattern: str) -> bool:
    5:     return bool(re.match(r"^(http|https)://", pattern))
