    2: class ErrorsWithCodes(type):
    1:     def __getattribute__(self, code):
    2:         msg = super().__getattribute__(code)
    2:         if code.startswith("__"):  # python system attributes like __class__
                   return msg
               else:
    2:             return "[{code}] {msg}".format(code=code, msg=msg)
       
       
    2: class Warnings(metaclass=ErrorsWithCodes):
           # File system
    1:     W801 = "Could not clean/remove the temp directory at {dir}: {msg}."
    1:     W802 = (
    1:         "Remote storage is not yet supported for Python 3.12 with "
               "cloudpathlib. Please use Python 3.11 or earlier for remote storage."
           )
       
       
    2: class Errors(metaclass=ErrorsWithCodes):
           # API - Datastructure
    1:     E001 = (
