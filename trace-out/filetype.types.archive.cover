    1:     def match(self, buf):
               # Detect BOM and skip first 3 bytes
               if (len(buf) > 3 and
                   buf[0] == 0xEF and
                   buf[1] == 0xBB and
                   buf[2] == 0xBF):  # noqa E129
                   buf = buf[3:]
       
