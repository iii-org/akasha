    1: """Base classes and types for persistent key-value stores.
       
       Stores provide long-term memory that persists across threads and conversations.
       Supports hierarchical namespaces, key-value storage, and optional vector search.
       
       Core types:
           - `BaseStore`: Store interface with sync/async operations
           - `Item`: Stored key-value pairs with metadata
           - `Op`: Get/Put/Search/List operations
       """
       
    1: from __future__ import annotations
       
    1: from abc import ABC, abstractmethod
    1: from collections.abc import Iterable
    1: from datetime import datetime
    1: from typing import (
           Any,
           Literal,
           NamedTuple,
           TypedDict,
           cast,
       )
       
    1: from langchain_core.embeddings import Embeddings
    1: from typing_extensions import override
       
    1: from langgraph.store.base.embed import (
           AEmbeddingsFunc,
           EmbeddingsFunc,
           ensure_embeddings,
           get_text_at_path,
           tokenize_path,
       )
       
       
    2: class NotProvided:
    1:     """Sentinel singleton."""
       
    1:     def __bool__(self) -> Literal[False]:
               return False
       
    2:     @override
    2:     def __repr__(self) -> str:
