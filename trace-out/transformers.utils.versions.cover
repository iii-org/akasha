    1: """
       Utilities for working with package versions
       """
       
    1: import importlib.metadata
    1: import operator
    1: import re
    1: import sys
       
    1: from packaging import version
       
       
    1: ops = {
    1:     "<": operator.lt,
    1:     "<=": operator.le,
    1:     "==": operator.eq,
    1:     "!=": operator.ne,
    1:     ">=": operator.ge,
    1:     ">": operator.gt,
       }
       
       
    1: def _compare_versions(op, got_ver, want_ver, requirement, pkg, hint):
   11:     if got_ver is None or want_ver is None:
               raise ValueError(
                   f"Unable to compare versions for {requirement}: need={want_ver} found={got_ver}. This is unusual. Consider"
                   f" reinstalling {pkg}."
               )
   11:     if not ops[op](version.parse(got_ver), version.parse(want_ver)):
               raise ImportError(
                   f"{requirement} is required for a normal functioning of this module, but found {pkg}=={got_ver}.{hint}"
               )
       
       
    1: def require_version(requirement: str, hint: str | None = None) -> None:
           """
           Perform a runtime check of the dependency versions, using the exact same syntax used by pip.
       
           The installed module version comes from the *site-packages* dir via *importlib.metadata*.
       
           Args:
               requirement (`str`): pip style definition, e.g.,  "tokenizers==0.9.4", "tqdm>=4.60", "numpy"
               hint (`str`, *optional*): what suggestion to print in case of requirements not being met
       
           Example:
       
           ```python
           require_version("pandas>1.1.2")
           require_version("numpy>1.18.5", "this is important to have for whatever reason")
           ```"""
       
   10:     hint = f"\n{hint}" if hint is not None else ""
       
           # non-versioned check
   10:     if re.match(r"^[\w_\-\d]+$", requirement):
    1:         pkg, op, want_ver = requirement, None, None
           else:
    9:         match = re.findall(r"^([^!=<>\s]+)([\s!=<>]{1,2}.+)", requirement)
    9:         if not match:
                   raise ValueError(
                       "requirement needs to be in the pip package format, .e.g., package_a==1.23, or package_b>=1.23, but"
                       f" got {requirement}"
                   )
    9:         pkg, want_full = match[0]
    9:         want_range = want_full.split(",")  # there could be multiple requirements
    9:         wanted = {}
   20:         for w in want_range:
   11:             match = re.findall(r"^([\s!=<>]{1,2})(.+)", w)
   11:             if not match:
                       raise ValueError(
                           "requirement needs to be in the pip package format, .e.g., package_a==1.23, or package_b>=1.23,"
                           f" but got {requirement}"
                       )
   11:             op, want_ver = match[0]
   11:             wanted[op] = want_ver
   11:             if op not in ops:
                       raise ValueError(f"{requirement}: need one of {list(ops.keys())}, but got {op}")
       
           # special case
   10:     if pkg == "python":
    5:         got_ver = ".".join([str(x) for x in sys.version_info[:3]])
    2:         for op, want_ver in wanted.items():
    1:             _compare_versions(op, got_ver, want_ver, requirement, pkg, hint)
    1:         return
       
           # check if any version is installed
    9:     try:
    9:         got_ver = importlib.metadata.version(pkg)
           except importlib.metadata.PackageNotFoundError:
               raise importlib.metadata.PackageNotFoundError(
                   f"The '{requirement}' distribution was not found and is required by this application. {hint}"
               )
       
           # check that the right version is installed if version number or a range was provided
    9:     if want_ver is not None:
   18:         for op, want_ver in wanted.items():
   10:             _compare_versions(op, got_ver, want_ver, requirement, pkg, hint)
       
       
    1: def require_version_core(requirement):
           """require_version wrapper which emits a core-specific hint on failure"""
   10:     hint = "Try: `pip install transformers -U` or `pip install -e '.[dev]'` if you're working with git main"
   10:     return require_version(requirement, hint)
