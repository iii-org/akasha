    1: from typing import Callable, Tuple, cast
       
    1: from ..config import registry
    1: from ..model import Model
    1: from ..types import Floats2d, Ragged
    1: from ..util import ArrayInfo
       
    1: InT = Ragged
    1: OutT = Floats2d
       
       
    2: @registry.layers("reduce_sum.v1")
    2: def reduce_sum() -> Model[InT, OutT]:
           return Model("reduce_sum", forward)
       
       
    1: def forward(model: Model[InT, OutT], Xr: InT, is_train: bool) -> Tuple[OutT, Callable]:
           Y = model.ops.reduce_sum(cast(Floats2d, Xr.data), Xr.lengths)
           lengths = Xr.lengths
           array_info = ArrayInfo.from_array(Y)
       
           def backprop(dY: OutT) -> InT:
               array_info.check_consistency(dY)
               return Ragged(model.ops.backprop_reduce_sum(dY, lengths), lengths)
       
           return Y, backprop
