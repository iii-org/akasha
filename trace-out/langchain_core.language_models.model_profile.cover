    1: """Model profile types and utilities."""
       
    1: import logging
    1: import warnings
    1: from typing import get_type_hints
       
    1: from pydantic import ConfigDict
    1: from typing_extensions import TypedDict
       
    1: logger = logging.getLogger(__name__)
       
       
    2: class ModelProfile(TypedDict, total=False):
    1:     """Description of a chat model's capabilities, exposed via `model.profile`.
       
           See the
           [model profiles guide](https://docs.langchain.com/oss/python/langchain/models#model-profiles)
           for concepts and usage. Data is sourced from
           [models.dev](https://github.com/sst/models.dev), augmented with additional
           fields, and generated by the
           [`langchain-model-profiles`](https://github.com/langchain-ai/langchain/tree/master/libs/model-profiles)
           package (via its `langchain-profiles` CLI).
       
           !!! warning "Beta feature"
       
               Fields and format are subject to change. This is a `total=False`
               `TypedDict`, so any field may be absent — guard accesses with `.get()`.
           """
       
    1:     __pydantic_config__ = ConfigDict(extra="allow")  # type: ignore[misc]
       
           # --- Model metadata ---
       
    1:     name: str
    1:     """Human-readable model name (e.g., `'GPT-5'`)."""
       
    1:     status: str
    1:     """Model lifecycle status (e.g., `'active'`, `'deprecated'`)."""
       
    1:     release_date: str
    1:     """Model release date (ISO 8601 format, e.g., `'2025-06-01'`)."""
       
    1:     last_updated: str
    1:     """Date the model was last updated (ISO 8601 format)."""
       
    1:     open_weights: bool
    1:     """Whether the model weights are openly available."""
       
           # --- Input constraints ---
       
    1:     max_input_tokens: int
    1:     """Maximum context window (tokens)."""
       
    1:     text_inputs: bool
    1:     """Whether text inputs are supported."""
       
    1:     image_inputs: bool
    1:     """Whether image inputs are supported."""
           # TODO: add more detail about formats?
       
    1:     image_url_inputs: bool
    1:     """Whether [image URL inputs](https://docs.langchain.com/oss/python/langchain/models#multimodal)
           are supported."""
       
    1:     pdf_inputs: bool
    1:     """Whether [PDF inputs](https://docs.langchain.com/oss/python/langchain/models#multimodal)
           are supported."""
           # TODO: add more detail about formats? e.g. bytes or base64
       
    1:     audio_inputs: bool
    1:     """Whether [audio inputs](https://docs.langchain.com/oss/python/langchain/models#multimodal)
           are supported."""
           # TODO: add more detail about formats? e.g. bytes or base64
       
    1:     video_inputs: bool
    1:     """Whether [video inputs](https://docs.langchain.com/oss/python/langchain/models#multimodal)
           are supported."""
           # TODO: add more detail about formats? e.g. bytes or base64
       
    1:     image_tool_message: bool
    1:     """Whether images can be included in `ToolMessage` content."""
       
    1:     pdf_tool_message: bool
    1:     """Whether PDFs can be included in `ToolMessage` content."""
       
           # --- Output constraints ---
       
    1:     max_output_tokens: int
    1:     """Maximum output tokens."""
       
    1:     reasoning_output: bool
    1:     """Whether the model supports [reasoning / chain-of-thought](https://docs.langchain.com/oss/python/langchain/models#reasoning)."""
       
    1:     text_outputs: bool
    1:     """Whether text outputs are supported."""
       
    1:     image_outputs: bool
    1:     """Whether [image outputs](https://docs.langchain.com/oss/python/langchain/models#multimodal)
           are supported."""
       
    1:     audio_outputs: bool
    1:     """Whether [audio outputs](https://docs.langchain.com/oss/python/langchain/models#multimodal)
           are supported."""
       
    1:     video_outputs: bool
    1:     """Whether [video outputs](https://docs.langchain.com/oss/python/langchain/models#multimodal)
           are supported."""
       
           # --- Tool calling ---
    1:     tool_calling: bool
    1:     """Whether the model supports [tool calling](https://docs.langchain.com/oss/python/langchain/models#tool-calling)."""
       
    1:     tool_choice: bool
    1:     """Whether the model supports [tool choice](https://docs.langchain.com/oss/python/langchain/models#forcing-tool-calls)."""
       
    1:     tool_call_streaming: bool
    1:     """Whether the model returns properly structured `tool_call_chunks` when streaming.
       
           Only meaningful when `tool_calling` is `True`.
           """
       
           # --- Structured output ---
    1:     structured_output: bool
    1:     """Whether the model supports native [structured output](https://docs.langchain.com/oss/python/langchain/models#structured-outputs)."""
       
           # --- Other capabilities ---
       
    1:     attachment: bool
    1:     """Whether the model supports file attachments."""
       
    1:     temperature: bool
    1:     """Whether the model supports a temperature parameter."""
       
       
    1: ModelProfileRegistry = dict[str, ModelProfile]
    1: """Registry mapping model identifiers or names to their ModelProfile."""
       
       
    1: def _warn_unknown_profile_keys(profile: ModelProfile) -> None:
           """Warn if `profile` contains keys not declared on `ModelProfile`.
       
           Args:
               profile: The model profile dict to check for undeclared keys.
           """
           if not isinstance(profile, dict):
               return  # type: ignore[unreachable]
       
           try:
               declared = frozenset(get_type_hints(ModelProfile).keys())
           except (TypeError, NameError):
               # get_type_hints raises NameError on unresolvable forward refs and
               # TypeError when annotations evaluate to non-type objects.
               logger.debug(
                   "Could not resolve type hints for ModelProfile; "
                   "skipping unknown-key check.",
                   exc_info=True,
               )
               return
       
           extra = sorted(set(profile) - declared)
           if extra:
               warnings.warn(
                   f"Unrecognized keys in model profile: {extra}. "
                   f"This may indicate a version mismatch between langchain-core "
                   f"and your provider package. Consider upgrading langchain-core.",
                   stacklevel=2,
               )
