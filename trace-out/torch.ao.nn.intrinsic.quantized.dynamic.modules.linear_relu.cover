    1: from typing import Any
    1: from typing_extensions import Self
       
    1: import torch
    1: import torch.ao.nn.intrinsic as nni
    1: import torch.ao.nn.quantized.dynamic as nnqd
       
       
    1: __all__ = ["LinearReLU"]
       
       
    2: class LinearReLU(nnqd.Linear):
    1:     r"""
           A LinearReLU module fused from Linear and ReLU modules that can be used
           for dynamic quantization.
           Supports both, FP16 and INT8 quantization.
       
           We adopt the same interface as :class:`torch.ao.nn.quantized.dynamic.Linear`.
       
           Attributes:
               Same as torch.ao.nn.quantized.dynamic.Linear
       
           Examples::
       
               >>> # xdoctest: +SKIP
               >>> m = nn.intrinsic.quantized.dynamic.LinearReLU(20, 30)
               >>> input = torch.randn(128, 20)
               >>> output = m(input)
               >>> print(output.size())
               torch.Size([128, 30])
           """
       
           # pyrefly: ignore [bad-override]
    1:     _FLOAT_MODULE = nni.LinearReLU
       
    6:     def __init__(
               self,
    1:         in_features: int,
    1:         out_features: int,
    2:         bias: bool = True,
    2:         dtype: torch.dtype = torch.qint8,
    1:     ) -> None:
               super().__init__(in_features, out_features, bias, dtype)
       
    1:     def forward(self, x: torch.Tensor) -> torch.Tensor:
               if self._packed_params.dtype == torch.qint8:
                   # TODO check if we should set reduce_rage = True by default here
                   Y = torch.ops.quantized.linear_relu_dynamic(
                       x, self._packed_params._packed_params, reduce_range=True
                   )
               elif self._packed_params.dtype == torch.float16:
                   Y = torch.ops.quantized.linear_relu_dynamic_fp16(
                       x, self._packed_params._packed_params
                   )
               else:
                   raise RuntimeError("Unsupported dtype on dynamic quantized linear relu!")
               return Y.to(x.dtype)
       
    1:     def _get_name(self) -> str:
               return "DynamicQuantizedLinearReLU"
       
    2:     @classmethod
    5:     def from_float(
    3:         cls, mod: torch.nn.Module, use_precomputed_fake_quant: bool = False
    1:     ) -> Self:
               return super().from_float(
                   mod, use_precomputed_fake_quant=use_precomputed_fake_quant
               )
       
    2:     @classmethod
    2:     def from_reference(cls, ref_qlinear_relu: Any) -> Self:  # type: ignore[override]
               return super().from_reference(ref_qlinear_relu[0])
