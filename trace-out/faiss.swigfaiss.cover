    1:     level_width = property(_swigfaiss.Panorama_level_width_get, _swigfaiss.Panorama_level_width_set)
    1:     level_width_floats = property(_swigfaiss.Panorama_level_width_floats_get, _swigfaiss.Panorama_level_width_floats_set)
    1:     batch_size = property(_swigfaiss.Panorama_batch_size_get, _swigfaiss.Panorama_batch_size_set)
       
