               _swigfaiss.ZnSphereSearch_swiginit(self, _swigfaiss.new_ZnSphereSearch(dim, r2_in))
       
    1:     def search(self, *args):
               r"""
               *Overload 1:*
               find nearest centroid. x does not need to be normalized
       
               |
       
