       # Base types are simple, atomic types with no further structure
    2: class BaseTy(Enum):
    1:     Generator = auto()
    1:     ScalarType = auto()
    1:     Tensor = auto()
    1:     int = auto()
    1:     Dimname = auto()
    1:     DimVector = auto()
    1:     float = auto()
    1:     str = auto()
    1:     bool = auto()
    1:     Layout = auto()
    1:     Device = auto()
    1:     DeviceIndex = auto()
    1:     Scalar = auto()
