    1:         "0;36": 0x2 + 0x4,  # cyan
    1:         "0;37": 0x1 + 0x2 + 0x4,  # grey
    1:         "1;30": 0x1 + 0x2 + 0x4,  # dark gray
    1:         "1;31": 0x4 + 0x8,  # red
    1:         "1;32": 0x2 + 0x8,  # light green
    1:         "1;33": 0x4 + 0x2 + 0x8,  # yellow
    1:         "1;34": 0x1 + 0x8,  # light blue
    1:         "1;35": 0x1 + 0x4 + 0x8,  # light purple
    1:         "1;36": 0x1 + 0x2 + 0x8,  # light cyan
    1:         "1;37": 0x1 + 0x2 + 0x4 + 0x8,  # white
    1:         "0": None,
