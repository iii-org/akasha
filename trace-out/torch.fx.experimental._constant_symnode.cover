    1: from typing import *  # noqa: F403
       
       
       # Python version of c10/core/ConstantSymNodeImpl.cpp
       # This needs to exist because the Python version of nested int is not compatible
       # with the C++ version of constant symnode.
    2: class ConstantIntNode:
    1:     def __init__(self, val: int):
               self.val = val
       
    1:     def is_constant(self) -> bool:
               return True
       
    1:     def maybe_as_int(self) -> int:
               return self.val
       
    1:     def is_int(self) -> bool:
               return True
       
    1:     def is_float(self) -> bool:
               return False
       
    1:     def is_bool(self) -> bool:
               return False
       
    1:     def is_nested_int(self) -> bool:
               return False
       
    1:     def clone(self) -> "ConstantIntNode":
               return self
       
    1:     def _str(self) -> str:
               return str(self.val)
       
    1:     def __str__(self) -> str:
               return self._str()
       
    1:     def __repr__(self) -> str:
               return self._str()
       
    1:     def _graph_repr(self) -> str:
               return self._str()
       
    1:     def add(self, other: Any) -> Any:
               return other.add(self)
       
    1:     def sub(self, other: Any) -> Any:
               return other.neg().add(self.val)
       
    1:     def mul(self, other: Any) -> Any:
               return other.mul(self)
       
    1:     def eq(self, other: Any) -> Any:
               return other.eq(self)
       
    1:     def ne(self, other: Any) -> Any:
               return other.ne(self)
       
    1:     def gt(self, other: Any) -> Any:
               return other.lt(self)
       
    1:     def lt(self, other: Any) -> Any:
               return other.gt(self)
       
    1:     def le(self, other: Any) -> Any:
               return other.ge(self)
       
    1:     def ge(self, other: Any) -> Any:
               return other.le(self)
       
    1:     def is_symbolic(self) -> bool:
               return False
       
    1:     def constant_int(self) -> int:
               return self.val
       
    1:     def guard_int(self, file: str, line: int) -> int:
