    1: from collections.abc import Sequence
    1: from typing import Generic, TypeVar
       
    1: from opentelemetry.sdk.util.instrumentation import (
           InstrumentationScope,
           _InstrumentationScopePredicateT,
       )
       
    1: ConfigT = TypeVar("ConfigT")
    1: ConfiguratorRulesT = Sequence[tuple[_InstrumentationScopePredicateT, ConfigT]]
       
       
    2: class RuleBasedConfigurator(Generic[ConfigT]):
    1:     def __init__(self, *, rules: ConfiguratorRulesT, default_config: ConfigT):
               self._rules = rules
               self._default_config = default_config
       
    1:     def __call__(self, scope: InstrumentationScope) -> ConfigT:
               for predicate, config in self._rules:
                   if predicate(scope):
                       return config
               # by default return default config
               return self._default_config
       
    1:     def update_rules(self, rules: ConfiguratorRulesT) -> None:
               self._rules = rules
