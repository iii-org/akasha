    1: from collections.abc import Iterator
    1: from typing import Any
       
    1: from torch.utils.data.datapipes.dataframe import dataframe_wrapper as df_wrapper
    1: from torch.utils.data.datapipes.datapipe import DataChunk
       
       
    1: __all__ = ["DataChunkDF"]
       
       
    2: class DataChunkDF(DataChunk):
    1:     """DataChunkDF iterating over individual items inside of DataFrame containers, to access DataFrames user `raw_iterator`."""
       
    1:     def __iter__(self) -> Iterator[Any]:
               for df in self.items:
                   yield from df_wrapper.iterate(df)
       
    1:     def __len__(self) -> int:
               total_len = 0
               for df in self.items:
                   total_len += df_wrapper.get_len(df)
               return total_len
