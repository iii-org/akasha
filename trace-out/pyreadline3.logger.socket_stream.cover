    1: from socket import AF_INET, SOCK_DGRAM, socket
       
    1: from ..unicode_helper import ensure_str
       
       
    2: class SocketStream:
    4:     def __init__(
               self,
    1:         host: str,
    1:         port: int,
    1:     ) -> None:
               self.__host = host
               self.__port = port
               self.__socket = socket(AF_INET, SOCK_DGRAM)
       
    1:     def write(self, record: str) -> None:
               self.__socket.sendto(
                   ensure_str(record),
                   (self.__host, self.__port),
               )
       
    1:     def flush(self) -> None:
               pass
       
    1:     def close(self) -> None:
               pass
