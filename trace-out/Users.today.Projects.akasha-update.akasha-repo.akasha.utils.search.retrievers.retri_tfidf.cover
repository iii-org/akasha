    1: from typing import Any, List, Optional, Tuple, Dict, Iterable
    1: from langchain_community.retrievers import TFIDFRetriever
    1: from langchain_core.documents import Document
    1: from langchain_core.callbacks import CallbackManagerForRetrieverRun
    1: from akasha.helper.base import jieba_tokenizer
       
       
    2: class myTFIDFRetriever(TFIDFRetriever):
       
    2:     @classmethod
    7:     def from_texts(
               cls,
    1:         texts: Iterable[str],
    2:         documents: Optional[List[Document]] = None,
    2:         tfidf_params: Optional[Dict[str, Any]] = None,
    1:         **kwargs: Any,
    1:     ) -> TFIDFRetriever:
               try:
                   from sklearn.feature_extraction.text import TfidfVectorizer
               except ImportError:
                   raise ImportError(
                       "Could not import scikit-learn, please install with `pip install "
                       "scikit-learn`.")
       
               tfidf_params = tfidf_params or {}
               vectorizer = TfidfVectorizer(**tfidf_params)
               tfidf_array = vectorizer.fit_transform(texts)
               return cls(vectorizer=vectorizer,
                          docs=documents,
                          tfidf_array=tfidf_array,
                          **kwargs)
       
    2:     @classmethod
    6:     def from_documents(
               cls,
    1:         documents: List[Document],
               *,
    2:         tfidf_params: Optional[Dict[str, Any]] = None,
    1:         **kwargs: Any,
    1:     ) -> TFIDFRetriever:
               texts, metadatas = zip(
                   *((" ".join(jieba_tokenizer.cut_text(d.page_content)), d.metadata)
                     for d in documents))
               return cls.from_texts(texts=texts,
                                     tfidf_params=tfidf_params,
                                     documents=documents,
                                     **kwargs)
       
    4:     def _get_relevant_documents(
                   self,
    1:             query: str,
                   *,
    2:             run_manager: CallbackManagerForRetrieverRun = None
    1:     ) -> List[Document]:
               return self._gs(query)[0]
       
    3:     def _gs(
               self,
    1:         query: str,
    1:     ) -> Tuple[List[Document], List[float]]:
               from sklearn.metrics.pairwise import cosine_similarity
       
               query_vec = self.vectorizer.transform(
                   [query])  # Ip -- (n_docs,x), Op -- (n_docs,n_Feats)
               results = cosine_similarity(self.tfidf_array, query_vec).reshape(
                   (-1, ))  # Op -- (n_docs,1) -- Cosine Sim with each doc
               idxs = results.argsort()[-self.k:][::-1]
               return_docs = [self.docs[i] for i in idxs]
               return_values = [results[i] for i in idxs]
       
               return return_docs, return_values
       
    3:     def get_relevant_documents_and_scores(
               self,
    1:         query: str,
    1:     ) -> Tuple[List[Document], List[float]]:
               return self._gs(query)
       
    1:     async def _aget_relevant_documents(self, query: str) -> List[Document]:
               return self._gs(query)[0]
