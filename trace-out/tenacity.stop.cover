    1: import abc
    1: import typing
       
    1: from tenacity import _utils
       
    1: if typing.TYPE_CHECKING:
           import threading
       
           from tenacity import RetryCallState
       
       
    2: class stop_base(abc.ABC):
    1:     """Abstract base class for stop strategies."""
       
    2:     @abc.abstractmethod
    2:     def __call__(self, retry_state: "RetryCallState") -> bool:
               pass
       
    1:     def __and__(self, other: "stop_base") -> "stop_all":
               return stop_all(self, other)
       
    1:     def __or__(self, other: "stop_base") -> "stop_any":
               return stop_any(self, other)
       
       
    1: StopBaseT = typing.Union[stop_base, typing.Callable[["RetryCallState"], bool]]
       
       
    2: class stop_any(stop_base):
    1:     """Stop if any of the stop condition is valid."""
       
    1:     def __init__(self, *stops: stop_base) -> None:
               self.stops = stops
       
    1:     def __call__(self, retry_state: "RetryCallState") -> bool:
               return any(x(retry_state) for x in self.stops)
       
       
    2: class stop_all(stop_base):
    1:     """Stop if all the stop conditions are valid."""
       
    1:     def __init__(self, *stops: stop_base) -> None:
               self.stops = stops
       
    1:     def __call__(self, retry_state: "RetryCallState") -> bool:
               return all(x(retry_state) for x in self.stops)
       
       
    2: class _stop_never(stop_base):
    1:     """Never stop."""
       
    1:     def __call__(self, retry_state: "RetryCallState") -> bool:
               return False
       
       
    1: stop_never = _stop_never()
       
       
    2: class stop_when_event_set(stop_base):
    1:     """Stop when the given event is set."""
       
    1:     def __init__(self, event: "threading.Event") -> None:
               self.event = event
       
    1:     def __call__(self, retry_state: "RetryCallState") -> bool:
               return self.event.is_set()
       
       
    2: class stop_after_attempt(stop_base):
    1:     """Stop when the previous attempt >= max_attempt."""
       
    1:     def __init__(self, max_attempt_number: int) -> None:
    1:         self.max_attempt_number = max_attempt_number
       
    1:     def __call__(self, retry_state: "RetryCallState") -> bool:
               return retry_state.attempt_number >= self.max_attempt_number
       
       
    2: class stop_after_delay(stop_base):
    1:     """
           Stop when the time from the first attempt >= limit.
       
           Note: `max_delay` will be exceeded, so when used with a `wait`, the actual total delay will be greater
           than `max_delay` by some of the final sleep period before `max_delay` is exceeded.
       
           If you need stricter timing with waits, consider `stop_before_delay` instead.
           """
       
    1:     def __init__(self, max_delay: _utils.time_unit_type) -> None:
               self.max_delay = _utils.to_seconds(max_delay)
       
    1:     def __call__(self, retry_state: "RetryCallState") -> bool:
               if retry_state.seconds_since_start is None:
                   raise RuntimeError("__call__() called but seconds_since_start is not set")
               return retry_state.seconds_since_start >= self.max_delay
       
       
    2: class stop_before_delay(stop_base):
    1:     """
           Stop right before the next attempt would take place after the time from the first attempt >= limit.
       
           Most useful when you are using with a `wait` function like wait_random_exponential, but need to make
           sure that the max_delay is not exceeded.
           """
       
    1:     def __init__(self, max_delay: _utils.time_unit_type) -> None:
               self.max_delay = _utils.to_seconds(max_delay)
       
    1:     def __call__(self, retry_state: "RetryCallState") -> bool:
               if retry_state.seconds_since_start is None:
                   raise RuntimeError("__call__() called but seconds_since_start is not set")
               return (
                   retry_state.seconds_since_start + retry_state.upcoming_sleep
                   >= self.max_delay
               )
