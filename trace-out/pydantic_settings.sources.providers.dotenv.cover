    1:     def _read_env_files(self) -> Mapping[str, str | None]:
    7:         env_files = self.env_file
    7:         if env_files is None:
                   return {}
       
    7:         if isinstance(env_files, (str, os.PathLike)):
    7:             env_files = [env_files]
       
    7:         dotenv_vars: dict[str, str | None] = {}
