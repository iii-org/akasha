    1: from __future__ import annotations as _annotations
       
    1: import functools
    1: import inspect
    1: from collections.abc import Callable
    1: from functools import cached_property
    1: from typing import TYPE_CHECKING, Any
       
    1: from pydantic import BaseModel, Field
       
    1: from mcp.server.fastmcp.exceptions import ToolError
    1: from mcp.server.fastmcp.utilities.context_injection import find_context_parameter
    1: from mcp.server.fastmcp.utilities.func_metadata import FuncMetadata, func_metadata
    1: from mcp.shared.exceptions import UrlElicitationRequiredError
    1: from mcp.shared.tool_name_validation import validate_and_warn_tool_name
    1: from mcp.types import Icon, ToolAnnotations
       
    1: if TYPE_CHECKING:
           from mcp.server.fastmcp.server import Context
           from mcp.server.session import ServerSessionT
           from mcp.shared.context import LifespanContextT, RequestT
       
       
    2: class Tool(BaseModel):
    1:     """Internal tool registration info."""
       
    1:     fn: Callable[..., Any] = Field(exclude=True)
    1:     name: str = Field(description="Name of the tool")
    1:     title: str | None = Field(None, description="Human-readable title of the tool")
    1:     description: str = Field(description="Description of what the tool does")
    1:     parameters: dict[str, Any] = Field(description="JSON schema for tool parameters")
    2:     fn_metadata: FuncMetadata = Field(
    1:         description="Metadata about the function including a pydantic model for tool arguments"
           )
    1:     is_async: bool = Field(description="Whether the tool is async")
    1:     context_kwarg: str | None = Field(None, description="Name of the kwarg that should receive context")
    1:     annotations: ToolAnnotations | None = Field(None, description="Optional annotations for the tool")
    1:     icons: list[Icon] | None = Field(default=None, description="Optional list of icons for this tool")
    1:     meta: dict[str, Any] | None = Field(default=None, description="Optional metadata for this tool")
       
    2:     @cached_property
    2:     def output_schema(self) -> dict[str, Any] | None:
               return self.fn_metadata.output_schema
       
    2:     @classmethod
    2:     def from_function(
               cls,
               fn: Callable[..., Any],
    1:         name: str | None = None,
    1:         title: str | None = None,
    1:         description: str | None = None,
    1:         context_kwarg: str | None = None,
    1:         annotations: ToolAnnotations | None = None,
    1:         icons: list[Icon] | None = None,
    1:         meta: dict[str, Any] | None = None,
    1:         structured_output: bool | None = None,
           ) -> Tool:
               """Create a Tool from a function."""
               func_name = name or fn.__name__
       
               validate_and_warn_tool_name(func_name)
       
               if func_name == "<lambda>":
                   raise ValueError("You must provide a name for lambda functions")
       
               func_doc = description or fn.__doc__ or ""
               is_async = _is_async_callable(fn)
       
               if context_kwarg is None:  # pragma: no branch
                   context_kwarg = find_context_parameter(fn)
       
               func_arg_metadata = func_metadata(
                   fn,
                   skip_names=[context_kwarg] if context_kwarg is not None else [],
                   structured_output=structured_output,
               )
               parameters = func_arg_metadata.arg_model.model_json_schema(by_alias=True)
       
               return cls(
                   fn=fn,
                   name=func_name,
                   title=title,
                   description=func_doc,
                   parameters=parameters,
                   fn_metadata=func_arg_metadata,
                   is_async=is_async,
                   context_kwarg=context_kwarg,
                   annotations=annotations,
                   icons=icons,
                   meta=meta,
               )
       
    1:     async def run(
               self,
               arguments: dict[str, Any],
    1:         context: Context[ServerSessionT, LifespanContextT, RequestT] | None = None,
    1:         convert_result: bool = False,
           ) -> Any:
               """Run the tool with arguments."""
               try:
                   result = await self.fn_metadata.call_fn_with_arg_validation(
                       self.fn,
                       self.is_async,
                       arguments,
                       {self.context_kwarg: context} if self.context_kwarg is not None else None,
                   )
       
                   if convert_result:
                       result = self.fn_metadata.convert_result(result)
       
                   return result
               except UrlElicitationRequiredError:
                   # Re-raise UrlElicitationRequiredError so it can be properly handled
                   # as an MCP error response with code -32042
                   raise
               except Exception as e:
                   raise ToolError(f"Error executing tool {self.name}: {e}") from e
       
       
    1: def _is_async_callable(obj: Any) -> bool:
           while isinstance(obj, functools.partial):  # pragma: no cover
               obj = obj.func
       
           return inspect.iscoroutinefunction(obj) or (
               callable(obj) and inspect.iscoroutinefunction(getattr(obj, "__call__", None))
           )
