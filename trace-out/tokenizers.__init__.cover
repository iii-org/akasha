    1: from enum import Enum
    1: from typing import List, Tuple, Union
       
       
    1: Offsets = Tuple[int, int]
       
    1: TextInputSequence = str
    1: """A :obj:`str` that represents an input sequence """
       
    1: PreTokenizedInputSequence = Union[List[str], Tuple[str]]
    1: """A pre-tokenized input sequence. Can be one of:
       
           - A :obj:`List` of :obj:`str`
           - A :obj:`Tuple` of :obj:`str`
       """
       
    2: TextEncodeInput = Union[
    2:     TextInputSequence,
    1:     Tuple[TextInputSequence, TextInputSequence],
    1:     List[TextInputSequence],
       ]
    1: """Represents a textual input for encoding. Can be either:
       
           - A single sequence: :data:`~tokenizers.TextInputSequence`
           - A pair of sequences:
       
             - A :obj:`Tuple` of :data:`~tokenizers.TextInputSequence`
             - Or a :obj:`List` of :data:`~tokenizers.TextInputSequence` of size 2
       """
       
    2: PreTokenizedEncodeInput = Union[
    2:     PreTokenizedInputSequence,
    1:     Tuple[PreTokenizedInputSequence, PreTokenizedInputSequence],
    1:     List[PreTokenizedInputSequence],
       ]
    1: """Represents a pre-tokenized input for encoding. Can be either:
       
           - A single sequence: :data:`~tokenizers.PreTokenizedInputSequence`
           - A pair of sequences:
       
             - A :obj:`Tuple` of :data:`~tokenizers.PreTokenizedInputSequence`
             - Or a :obj:`List` of :data:`~tokenizers.PreTokenizedInputSequence` of size 2
       """
       
    1: InputSequence = Union[TextInputSequence, PreTokenizedInputSequence]
    1: """Represents all the possible types of input sequences for encoding. Can be:
       
           - When ``is_pretokenized=False``: :data:`~TextInputSequence`
           - When ``is_pretokenized=True``: :data:`~PreTokenizedInputSequence`
       """
       
    1: EncodeInput = Union[TextEncodeInput, PreTokenizedEncodeInput]
    1: """Represents all the possible types of input for encoding. Can be:
       
           - When ``is_pretokenized=False``: :data:`~TextEncodeInput`
           - When ``is_pretokenized=True``: :data:`~PreTokenizedEncodeInput`
       """
       
       
    2: class OffsetReferential(Enum):
    1:     ORIGINAL = "original"
    1:     NORMALIZED = "normalized"
       
       
    2: class OffsetType(Enum):
    1:     BYTE = "byte"
    1:     CHAR = "char"
       
       
    2: class SplitDelimiterBehavior(Enum):
    1:     REMOVED = "removed"
    1:     ISOLATED = "isolated"
    1:     MERGED_WITH_PREVIOUS = "merged_with_previous"
    1:     MERGED_WITH_NEXT = "merged_with_next"
    1:     CONTIGUOUS = "contiguous"
       
       
