    1: from typing import Callable, Tuple, TypeVar
       
    1: from ..config import registry
    1: from ..model import Model
       
    1: InOutT = TypeVar("InOutT")
       
       
    2: @registry.layers("noop.v1")
    2: def noop(*layers: Model) -> Model[InOutT, InOutT]:
           """Transform a sequences of layers into a null operation."""
           return Model("noop", forward, layers=layers)
       
       
    5: def forward(
    3:     model: Model[InOutT, InOutT], X: InOutT, is_train: bool
    1: ) -> Tuple[InOutT, Callable]:
           def backprop(dY: InOutT) -> InOutT:
               return dY
       
           return X, backprop
