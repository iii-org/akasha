    1: from typing import Callable, Tuple, TypeVar, cast
       
    1: from ..config import registry
    1: from ..model import Model
    1: from ..types import ListXd, Ragged
       
    1: InT = Ragged
    1: OutT = TypeVar("OutT", bound=ListXd)
       
       
    2: @registry.layers("ragged2list.v1")
    2: def ragged2list() -> Model[InT, OutT]:
           """Transform sequences from a ragged format into lists."""
           return Model("ragged2list", forward)
       
       
    1: def forward(model: Model[InT, OutT], Xr: InT, is_train: bool) -> Tuple[OutT, Callable]:
           lengths = Xr.lengths
       
           def backprop(dXs: OutT) -> InT:
               return Ragged(model.ops.flatten(dXs, pad=0), lengths)  # type: ignore[arg-type]
               # type ignore necessary for older versions of Mypy/Pydantic
       
           data = cast(OutT, model.ops.unflatten(Xr.dataXd, Xr.lengths))
           return data, backprop
